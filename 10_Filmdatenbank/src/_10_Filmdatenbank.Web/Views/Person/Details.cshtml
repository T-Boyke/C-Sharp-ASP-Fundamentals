@model _10_Filmdatenbank.Domain.Entities.Person
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = $"{Model.Vorname} {Model.Nachname}";
}

<div class="mx-auto max-w-7xl px-6 lg:px-8 py-16">
    <!-- Breadcrumb & Back -->
    <nav class="flex mb-12 items-center gap-4 text-sm font-bold text-text-muted uppercase tracking-widest" aria-label='@Localizer["BreadcrumbLabel"]'>
        <a asp-action="Index" class="nav-link" aria-label='@Localizer["BackToTeamLabel"]'>
            <i aria-hidden="true" class="fa-solid fa-arrow-left"></i> @Localizer["Team"]
        </a>
        <span class="h-1 w-1 rounded-full bg-border-default"></span>
        <span class="text-text-main dark:text-white border-b-2 border-brand-primary pb-0.5 transition-colors">@Model.Vorname @Model.Nachname</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <!-- Left: Profile Info -->
        <div class="lg:col-span-1 space-y-8">
            <div class="card-premium overflow-hidden group">
                <div class="aspect-[4/5] bg-surface-subtle dark:bg-dark-surface-soft flex items-center justify-center transition-colors relative" aria-hidden="true">
                    @if (!string.IsNullOrEmpty(Model.ProfilBildUrl))
                    {
                        <img src="@Model.ProfilBildUrl" alt='@Localizer["ProfileImageOf", Model.Vorname + " " + Model.Nachname]' class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                    }
                    else
                    {
                        <i aria-hidden="true" class="fa-solid fa-user-tie text-text-muted dark:text-dark-surface-muted text-9xl"></i>
                    }
                </div>
                <div class="p-8 space-y-6 bg-surface-overlay dark:bg-dark-surface-soft transition-colors">
                    <div>
                        <h3 class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest mb-4">@Localizer["ProfileInformation"]</h3>
                        <div class="space-y-4">
                            <div class="flex items-center justify-between py-2 border-b border-border-muted dark:border-dark-border-muted">
                                <span class="text-xs font-bold text-text-muted">@Localizer["SystemID"]</span>
                                <span class="text-xs font-black text-text-main dark:text-white">#@Model.PersonID</span>
                            </div>
                            <div class="flex items-center justify-between py-2 border-b border-border-muted dark:border-dark-border-muted">
                                <span class="text-xs font-bold text-text-muted">@Localizer["Born"]</span>
                                <span class="text-xs font-black text-text-main dark:text-white">@(Model.Geburtsdatum?.ToString("dd.MM.yyyy") ?? Localizer["NotAvailable"].Value)</span>
                            </div>
                            @if (Model.Deathday.HasValue)
                            {
                                <div class="flex items-center justify-between py-2 border-b border-border-muted dark:border-dark-border-muted text-danger-primary">
                                    <span class="text-xs font-bold">@Localizer["Died"]</span>
                                    <span class="text-xs font-black">@Model.Deathday.Value.ToString("dd.MM.yyyy")</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Geburtsort))
                            {
                                <div class="flex items-center justify-between py-2 border-b border-border-muted dark:border-dark-border-muted">
                                    <span class="text-xs font-bold text-text-muted">@Localizer["Place"]</span>
                                    <span class="text-xs font-black text-text-main dark:text-white">@Model.Geburtsort</span>
                                </div>
                            }
                            <div class="flex items-center justify-between py-2 border-b border-border-muted dark:border-dark-border-muted">
                                <span class="text-xs font-bold text-text-muted">@Localizer["Gender"]</span>
                                <span class="text-xs font-black text-text-main dark:text-white">
                                    @(Model.Gender switch
                                    {
                                        1 => Localizer["Female"].Value,
                                        2 => Localizer["Male"].Value,
                                        3 => Localizer["NonBinary"].Value,
                                        _ => Localizer["Unknown"].Value
                                    })
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.KnownForDepartment))
                            {
                                <div class="flex items-center justify-between py-2 border-b border-border-muted dark:border-dark-border-muted">
                                    <span class="text-xs font-bold text-text-muted">@Localizer["Department"]</span>
                                    <span class="text-xs font-black text-text-main dark:text-white">@Model.KnownForDepartment</span>
                                </div>
                            }
                            <div class="flex items-center justify-between py-2 border-b border-border-muted dark:border-dark-border-muted">
                                <span class="text-xs font-bold text-text-muted">@Localizer["Popularity"]</span>
                                <span class="text-xs font-black text-text-main dark:text-white transition-colors">@(Model.Popularity?.ToString("0.0") ?? "N/A")</span>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(Model.Homepage))
                            {
                                <div class="py-2 border-b border-border-muted dark:border-dark-border-muted">
                                    <a href="@Model.Homepage" target="_blank" class="text-xs font-black text-brand-primary hover:text-brand-hover flex items-center gap-2">
                                        <i class="fa-solid fa-link"></i> @Localizer["VisitWebsite"]
                                    </a>
                                </div>
                            }

                            <div class="flex flex-wrap items-center gap-4 mt-6">
                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="SyncWithTmdb" method="post" class="mr-2">
                                        <input type="hidden" name="id" value="@Model.PersonID" />
                                        <button type="submit" class="btn-secondary !py-2 !px-4 text-[10px] shadow-lg shadow-brand-primary/10" title="TMDB & Wikidata Sync">
                                            <i class="fa-solid fa-cloud-arrow-down mr-2"></i> Sync
                                        </button>
                                    </form>
                                }
                                
                                @if (!string.IsNullOrEmpty(Model.ImdbId))
                                {
                                    <a href="https://www.imdb.com/name/@Model.ImdbId" target="_blank" class="w-8 h-8 rounded-lg bg-accent-imdb text-black flex items-center justify-center font-black transition-transform hover:scale-110 shadow-lg" title="IMDb Profile">
                                        <i class="fa-brands fa-imdb text-xl"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.FacebookId))
                                {
                                    <a href="https://facebook.com/@Model.FacebookId" target="_blank" class="w-8 h-8 rounded-lg bg-accent-facebook text-white flex items-center justify-center transition-transform hover:scale-110 shadow-lg">
                                        <i class="fa-brands fa-facebook-f"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.InstagramId))
                                {
                                    <a href="https://instagram.com/@Model.InstagramId" target="_blank" class="w-8 h-8 rounded-lg bg-linear-to-tr from-accent-instagram-from via-accent-instagram-via to-accent-instagram-to text-white flex items-center justify-center transition-transform hover:scale-110 shadow-lg">
                                        <i class="fa-brands fa-instagram"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.TwitterId))
                                {
                                    <a href="https://twitter.com/@Model.TwitterId" target="_blank" class="w-8 h-8 rounded-lg bg-accent-twitter text-white flex items-center justify-center transition-transform hover:scale-110 shadow-lg">
                                        <i class="fa-brands fa-x-twitter"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.WikidataId))
                                {
                                    <a href="https://www.wikidata.org/wiki/@Model.WikidataId" target="_blank" class="w-8 h-8 rounded-lg bg-white text-black flex items-center justify-center transition-transform hover:scale-110 shadow-lg border border-border-muted" title="Wikidata">
                                        <i class="fa-solid fa-barcode"></i>
                                    </a>
                                }
                            </div>
                            
                            @{
                                var rollen = Model.PersonEigenschaftFilme.Select(pef => pef.Eigenschaft.Bezeichnung).Distinct();
                            }
                            <div class="flex-wrap-gap !gap-2 mt-4">
                                @foreach (var rolle in rollen)
                                {
                                    <span class="badge-premium !px-3 !py-1 text-[10px]">@rolle</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Tags))
                    {
                        <div class="pt-6 border-t border-border-muted dark:border-dark-border">
                             <h3 class="text-[10px] font-black text-text-muted uppercase tracking-widest mb-3">@Localizer["Tags"]</h3>
                             <div class="flex flex-wrap gap-2">
                                @foreach (var tag in Model.Tags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="px-2 py-0.5 rounded bg-brand-soft text-brand-primary text-[9px] font-bold border border-brand-border uppercase tracking-tighter">
                                        #@tag
                                    </span>
                                }
                             </div>
                        </div>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="pt-6 border-t border-border-muted dark:border-dark-border flex gap-4 transition-colors">
                            <a asp-action="Edit" asp-route-id="@Model.PersonID" class="btn-primary flex-1 shadow-lg shadow-brand-shadow" aria-label='@Localizer["EditLabel", Model.Vorname + " " + Model.Nachname]'>
                                <i aria-hidden="true" class="fa-solid fa-pen-to-square mr-2"></i> @Localizer["Edit"]
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.PersonID" class="btn-danger p-2.5 shadow-lg shadow-danger-primary/20" aria-label='@Localizer["DeleteLabel", Model.Vorname + " " + Model.Nachname]'>
                                <i aria-hidden="true" class="fa-solid fa-trash-can"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Content & Filmography -->
        <div class="lg:col-span-2 space-y-16">
            <header>
                <h1 class="text-5xl md:text-6xl font-black tracking-tighter text-text-main dark:text-white leading-none transition-colors">@Model.Vorname @Model.Nachname</h1>
                @if (Model.Geburtsdatum.HasValue)
                {
                    <p class="mt-4 text-xl text-brand-primary font-black uppercase tracking-widest">
                        * @Model.Geburtsdatum.Value.ToString("yyyy") 
                        @if(!string.IsNullOrEmpty(Model.Geburtsort)) { <span>@Localizer["BornIn"] @Model.Geburtsort</span> }
                    </p>
                }
                @if (!string.IsNullOrEmpty(Model.AlsoKnownAs))
                {
                    <div class="flex flex-wrap gap-2 mt-4">
                        @foreach (var alias in Model.AlsoKnownAs.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="px-2 py-0.5 rounded-lg bg-surface-muted dark:bg-dark-surface-soft text-[10px] font-bold text-text-description dark:text-dark-text-muted transition-colors">
                                @alias
                            </span>
                        }
                    </div>
                }
            </header>

            @if (Model.PersonAwards.Any())
            {
                <section>
                    <div class="form-group-header !mb-6">
                        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["AccoladesAndRecognition"]</h2>
                        <div class="h-1 w-12 bg-brand-primary rounded-full transition-colors"></div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var award in Model.PersonAwards.OrderByDescending(a => a.Year))
                        {
                            <div class="glass-premium p-4 rounded-2xl border border-glass-border flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-brand-primary/10 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-trophy text-brand-primary"></i>
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-[10px] font-black text-brand-primary uppercase">@award.Year</span>
                                        @if (award.IsWin)
                                        {
                                            <span class="px-1.5 py-0.5 rounded bg-green-500/10 text-green-500 text-[8px] font-black uppercase">@Localizer["Winner"]</span>
                                        }
                                        else
                                        {
                                            <span class="px-1.5 py-0.5 rounded bg-orange-500/10 text-orange-500 text-[8px] font-black uppercase">@Localizer["Nominated"]</span>
                                        }
                                    </div>
                                    <p class="text-sm font-black text-text-main dark:text-white truncate">@award.Name</p>
                                    @if (!string.IsNullOrEmpty(award.Category) && award.Category != "Win")
                                    {
                                        <p class="text-[10px] font-bold text-text-muted truncate">@award.Category</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
            else if (!string.IsNullOrEmpty(Model.Awards))
            {
                <section>
                    <div class="glass-premium p-8 rounded-3xl border border-brand-primary/20 flex items-center gap-6 shadow-2xl">
                        <div class="w-16 h-16 rounded-full bg-brand-primary/10 flex items-center justify-center text-brand-primary text-3xl">
                            <i class="fa-solid fa-trophy"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-black text-brand-primary uppercase tracking-[0.25em] mb-2">@Localizer["Awards"]</h3>
                            <p class="text-lg font-bold text-text-main dark:text-white leading-tight">@Model.Awards</p>
                        </div>
                    </div>
                </section>
            }

            <section>
                <div class="form-group-header !mb-6">
                    <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["Biography"]</h2>
                    <div class="h-1 w-12 bg-brand-primary rounded-full transition-colors"></div>
                </div>
                <p class="text-lg text-text-description dark:text-dark-text-muted leading-relaxed italic pl-8 border-l-4 border-border-muted dark:border-dark-border transition-colors">
                    @Model.Biografie
                </p>
            </section>

            <!-- DNA Analytics: Genre & Collaborators -->
            <section class="grid grid-cols-1 md:grid-cols-2 gap-12">
                @{
                    var localFilms = Model.PersonEigenschaftFilme.Select(pef => pef.Film).ToList();
                    var genreCounts = localFilms.SelectMany(f => f.Genres)
                                           .GroupBy(g => g.Name)
                                           .Select(g => new { Name = g.Key, Count = g.Count() })
                                           .OrderByDescending(g => g.Count)
                                           .ToList();
                    var totalGenreCount = genreCounts.Sum(g => g.Count);

                    var collaborators = localFilms.SelectMany(f => f.PersonEigenschaftFilme)
                                            .Where(pef => pef.PersonID != Model.PersonID)
                                            .GroupBy(pef => pef.Person)
                                            .Select(g => new { Person = g.Key, Count = g.Count() })
                                            .OrderByDescending(g => g.Count)
                                            .Take(9)
                                            .ToList();
                }

                <!-- Genre Distribution -->
                <div class="space-y-6">
                    <div class="form-group-header !mb-0">
                        <h3 class="text-lg font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["GenreDistribution"]</h3>
                        <div class="h-1 w-8 bg-brand-primary rounded-full mt-1"></div>
                    </div>
                    @if (genreCounts.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var gc in genreCounts.Take(6))
                            {
                                var percentage = (double)gc.Count / totalGenreCount * 100;
                                <div>
                                    <div class="flex justify-between text-[10px] font-black uppercase mb-1.5 transition-colors text-text-muted dark:text-dark-text-muted">
                                        <span>@gc.Name</span>
                                        <span>@gc.Count @Localizer["Projects"]</span>
                                    </div>
                                    <div class="w-full h-1.5 bg-surface-muted dark:bg-dark-surface-soft rounded-full overflow-hidden border border-border-muted dark:border-dark-border">
                                        <div class="h-full bg-brand-primary shadow-[0_0_10px_rgba(var(--brand-primary-rgb),0.3)]" style="width: @percentage%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-sm font-bold text-text-muted italic">@Localizer["NoData"]</p>
                    }
                </div>

                <!-- Collaboration Matrix -->
                <div class="space-y-6">
                    <div class="form-group-header !mb-0">
                        <h3 class="text-lg font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["CollaborationMatrix"]</h3>
                        <div class="h-1 w-8 bg-brand-primary rounded-full mt-1"></div>
                    </div>
                    @if (collaborators.Any())
                    {
                        <div class="grid grid-cols-3 gap-3">
                            @foreach (var col in collaborators)
                            {
                                <a asp-action="Details" asp-route-id="@col.Person.PersonID" class="group relative">
                                    <div class="aspect-square rounded-xl overflow-hidden border-2 border-border-muted dark:border-dark-border group-hover:border-brand-primary transition-all shadow-sm group-hover:shadow-lg">
                                        @if (!string.IsNullOrEmpty(col.Person.ProfilBildUrl))
                                        {
                                            <img src="@col.Person.ProfilBildUrl" alt="@col.Person.Vorname" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 scale-105 group-hover:scale-110" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center bg-surface-muted dark:bg-dark-surface-soft">
                                                <span class="text-xs font-black text-text-muted uppercase">
                                                    @(!string.IsNullOrEmpty(col.Person.Vorname) ? col.Person.Vorname[0] : '?')
                                                </span>
                                            </div>
                                        }
                                        <div class="absolute inset-0 bg-brand-primary/0 group-hover:bg-brand-primary/10 transition-colors"></div>
                                    </div>
                                    <div class="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-brand-primary text-[9px] font-black text-white flex items-center justify-center border-2 border-white dark:border-dark-surface shadow-md">
                                        @col.Count
                                    </div>
                                    <p class="mt-1.5 text-[8px] font-black text-center text-text-muted dark:text-dark-text-muted uppercase truncate group-hover:text-brand-primary transition-colors">@col.Person.Vorname</p>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-sm font-bold text-text-muted italic">@Localizer["NoData"]</p>
                    }
                </div>
            </section>

            <!-- Accolades & Recognition -->
            @if (Model.PersonAwards?.Any() == true)
            {
                <section>
                    <div class="form-group-header !mb-8">
                        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["AccoladesAndRecognition"]</h2>
                        <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        @foreach (var award in Model.PersonAwards.OrderByDescending(a => a.Year))
                        {
                            <div class="glass-premium p-6 rounded-2xl border border-glass-border relative overflow-hidden group">
                                <div class="absolute -right-4 -top-4 w-16 h-16 bg-brand-primary/5 rounded-full blur-xl group-hover:bg-brand-primary/10 transition-colors"></div>
                                <div class="flex items-center gap-3 mb-4">
                                    <span class="text-xs font-black text-brand-primary uppercase bg-brand-primary/10 px-2 py-1 rounded">@award.Year</span>
                                    @if (award.IsWin)
                                    {
                                        <span class="text-[9px] font-black text-white px-2 py-1 rounded bg-green-500 uppercase shadow-sm">@Localizer["Winner"]</span>
                                    }
                                    else
                                    {
                                        <span class="text-[9px] font-black text-text-muted px-2 py-1 rounded bg-surface-muted dark:bg-dark-surface-soft uppercase border border-border-muted dark:border-dark-border">@Localizer["Nominated"]</span>
                                    }
                                </div>
                                <p class="text-lg font-black text-text-main dark:text-white leading-tight mb-1">@award.Name</p>
                                <p class="text-[11px] font-bold text-text-muted uppercase tracking-wider">@award.Category</p>
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- Filmography Section (Local) -->
            <section>
                <div class="form-group-header !mb-8 flex items-center justify-between">
                    <div>
                        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["LocalLibrary"]</h2>
                        <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="badge-outline">@Model.PersonEigenschaftFilme.Count @Localizer["Projects"]</span>
                        <span class="text-[9px] font-black text-success-primary uppercase px-2 py-0.5 rounded border border-success-primary/20 bg-success-primary/5">In Collection</span>
                    </div>
                </div>

                <div class="space-y-4">
                    @foreach (var participation in Model.PersonEigenschaftFilme)
                    {
                        <a asp-controller="Film" asp-action="Details" asp-route-id="@participation.FilmID" 
                           class="form-group-card flex items-center p-6 group hover:border-brand-primary/30 transition-all border-l-4 border-l-brand-primary/20 hover:border-l-brand-primary"
                           aria-label='@Localizer["ViewFilmLabel", participation.Film.Titel]'>
                            <div class="w-16 h-24 rounded-lg overflow-hidden shrink-0 border border-border-muted dark:border-dark-border group-hover:shadow-lg transition-all" aria-hidden="true">
                                @if (!string.IsNullOrEmpty(participation.Film.PosterUrl))
                                {
                                    <img src="@participation.Film.PosterUrl" alt="" class="w-full h-full object-cover transition-transform group-hover:scale-110" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center bg-surface-muted dark:bg-dark-surface-soft transition-colors">
                                        <i aria-hidden="true" class="fa-solid fa-film text-2xl text-text-muted"></i>
                                    </div>
                                }
                            </div>
                            <div class="ml-8 flex-grow">
                                <div class="flex items-center justify-between">
                                    <p class="text-xl font-black text-text-main dark:text-white group-hover:text-brand-primary transition-colors">@participation.Film.Titel</p>
                                    <span class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest">@participation.Film.Erscheinungsjahr</span>
                                </div>
                                <div class="flex items-center gap-3 mt-3">
                                    <span class="px-2 py-0.5 rounded bg-brand-primary/5 text-brand-primary text-[10px] font-black uppercase tracking-tighter border border-brand-primary/10">
                                        @participation.Eigenschaft.Bezeichnung
                                    </span>
                                    <span class="text-[10px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest italic">
                                        @(string.Join(", ", participation.Film.Genres?.Select(g => g.Name).Where(n => !string.IsNullOrEmpty(n)) ?? Array.Empty<string>()))
                                    </span>
                                </div>
                            </div>
                            <i aria-hidden="true" class="fa-solid fa-arrow-right-long ml-6 text-border-muted dark:text-dark-surface-muted transition-transform group-hover:translate-x-2"></i>
                        </a>
                    }
                </div>
            </section>

            <!-- Global Filmography Section (TMDB) -->
            @if (!string.IsNullOrEmpty(Model.TmdbFilmographyJson) && Model.TmdbFilmographyJson != "null")
            {
                TMDbLib.Objects.People.CombinedCredits? credits = null;
                try 
                {
                    credits = Newtonsoft.Json.JsonConvert.DeserializeObject<TMDbLib.Objects.People.CombinedCredits>(Model.TmdbFilmographyJson);
                }
                catch (Exception)
                {
                    <!-- Logged as warning in console if needed, but prevent crash -->
                }

                if (credits != null && ((credits.Cast?.Any() ?? false) || (credits.Crew?.Any() ?? false)))
                {
                    <section class="mt-16">
                        <div class="form-group-header !mb-8 flex items-center justify-between">
                            <div>
                                <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@(Localizer["GlobalFilmography"].IsResourceNotFound ? "Global Filmography" : Localizer["GlobalFilmography"])</h2>
                                <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="badge-outline">@((credits.Cast?.Count ?? 0) + (credits.Crew?.Count ?? 0)) @Localizer["Projects"]</span>
                                <span class="text-[9px] font-black text-brand-primary uppercase px-2 py-0.5 rounded border border-brand-primary/20 bg-brand-primary/5">TMDB SOURCE</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            @{
                                var localTmdbIds = Model.PersonEigenschaftFilme.Select(pef => pef.Film.TmdbId).Where(id => id.HasValue).Select(id => id.Value).ToHashSet();
                                var allCredits = (credits.Cast?.Select(c => (dynamic)c) ?? Enumerable.Empty<dynamic>())
                                    .Concat(credits.Crew?.Select(c => (dynamic)c) ?? Enumerable.Empty<dynamic>())
                                    .OrderByDescending(c => {
                                        try { return (DateTime?)(c.ReleaseDate ?? c.FirstAirDate); } catch { return (DateTime?)null; }
                                    }).Take(60);
                            }
                            @foreach (var credit in allCredits)
                            {
                                dynamic dynCredit = credit;
                                string title = "";
                                DateTime? date = null;
                                string mediaTypeUrl = "";
                                string posterPath = "";
                                int id = 0;
                                bool isLocal = false;

                                try {
                                    title = dynCredit.Title ?? dynCredit.Name ?? "Unknown";
                                    date = dynCredit.ReleaseDate ?? dynCredit.FirstAirDate;
                                    mediaTypeUrl = dynCredit.MediaType == TMDbLib.Objects.General.MediaType.Movie ? "movie" : "tv";
                                    posterPath = dynCredit.PosterPath;
                                    id = dynCredit.Id;
                                    isLocal = localTmdbIds.Contains(id);
                                } catch {
                                    title = "Unknown";
                                }
                                
                                <div class="form-group-card flex items-center p-4 group transition-all border-l-4 @(isLocal ? "border-l-success-primary" : "border-l-surface-muted dark:border-l-dark-surface-soft") hover:border-l-brand-primary/50 bg-surface-subtle/30 dark:bg-dark-surface/30">
                                    <div class="w-12 h-18 rounded-md overflow-hidden shrink-0 border border-border-muted dark:border-dark-border" aria-hidden="true">
                                        @if (!string.IsNullOrEmpty(posterPath))
                                        {
                                            <img src="https://image.tmdb.org/t/p/w185@(posterPath)" alt="" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center bg-surface-muted dark:bg-dark-surface-soft">
                                                <i aria-hidden="true" class="fa-solid fa-film text-lg text-text-muted/40"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="ml-5 flex-grow min-w-0">
                                        <div class="flex items-center justify-between gap-4">
                                            <div class="flex flex-col min-w-0">
                                                <div class="flex items-center gap-2">
                                                    <p class="text-sm font-black text-text-main dark:text-white truncate" title="@title">@title</p>
                                                    @if (isLocal)
                                                    {
                                                        <span class="text-[7px] font-black bg-success-primary text-white px-1 rounded">LIBRARY</span>
                                                    }
                                                    else
                                                    {
                                                        <a asp-controller="Film" asp-action="Create" asp-route-searchQuery="@title" class="px-1.5 py-0.5 rounded bg-brand-primary/20 hover:bg-brand-primary text-brand-primary hover:text-white text-[7px] font-black uppercase transition-all">IMPORT</a>
                                                    }
                                                </div>
                                                <div class="flex items-center gap-2 mt-1">
                                                    <span class="text-[10px] font-bold text-text-muted dark:text-dark-text-muted italic truncate">
                                                        @{
                                                            string role = "N/A";
                                                            try { role = dynCredit.Character ?? dynCredit.Job ?? "N/A"; } catch { }
                                                        }
                                                        @role
                                                    </span>
                                                </div>
                                            </div>
                                            <span class="text-[9px] font-bold text-text-muted dark:text-dark-text-muted shrink-0 transition-colors">@(date?.Year.ToString() ?? "N/A")</span>
                                         </div>
                                     </div>
                                     <a href="https://www.themoviedb.org/@mediaTypeUrl/@id" target="_blank" class="ml-4 p-2 text-text-muted hover:text-brand-primary transition-colors" title='@Localizer["ViewOnTmdb"]'>
                                          <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                                     </a>
                                 </div>
                            }
                        </div>
                        
                        <div class="mt-8 p-6 rounded-2xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border flex items-center justify-between">
                            <div class="flex items-center gap-4 text-text-muted dark:text-dark-text-muted">
                                <i class="fa-solid fa-circle-info text-brand-primary"></i>
                                <p class="text-[10px] font-bold uppercase tracking-widest leading-relaxed">@Localizer["TmdbDataSource"]</p>
                            </div>
                            <a href="https://www.themoviedb.org/person/@Model.TmdbId" target="_blank" class="btn-secondary !py-2 !px-4 text-[10px]">
                                @Localizer["ViewOnTmdb"]
                            </a>
                        </div>
                    </section>
                }
            }
        </div>
    </div>
</div>
