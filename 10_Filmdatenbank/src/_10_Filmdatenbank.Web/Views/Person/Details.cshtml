@model _10_Filmdatenbank.Domain.Entities.Person

@{
    ViewData["Title"] = $"{Model.Vorname} {Model.Nachname}";
}

<div class="mx-auto max-w-7xl px-6 lg:px-8 py-16">
    <!-- Breadcrumb & Back -->
    <nav class="flex mb-8 items-center gap-4 text-sm font-bold text-slate-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a asp-action="Index" class="hover:text-brand-primary transition-colors flex items-center gap-2">
            <i aria-hidden="true" class="fa-solid fa-arrow-left"></i> Team
        </a>
        <span class="h-1 w-1 rounded-full bg-slate-300"></span>
        <span class="text-slate-900 dark:text-white border-b-2 border-brand-primary pb-0.5 transition-colors">@Model.Vorname @Model.Nachname</span>
    </nav>

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-3 items-start">
        
        <!-- Left: Profile Info -->
        <div class="lg:col-span-1 space-y-8">
            <div class="card-premium overflow-hidden">
                <div class="aspect-square bg-slate-50 dark:bg-slate-800 flex items-center justify-center border-b border-slate-100 dark:border-slate-800 relative group transition-colors">
                    <i aria-hidden="true" class="fa-solid fa-user-circle text-slate-200/60 dark:text-slate-800/60 text-9xl group-hover:scale-110 transition-transform duration-700"></i>
                </div>
                <div class="p-8 space-y-6">
                    <div>
                        <h3 class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-4">Profil Details</h3>
                        <div class="space-y-4">
                            <div class="flex items-center gap-3">
                                <i aria-hidden="true" class="fa-solid fa-id-card text-slate-400 dark:text-slate-500"></i>
                                <span class="text-sm font-bold text-slate-900 dark:text-white transition-colors">ID: @Model.PersonID</span>
                            </div>
                            @{
                                var rollen = Model.PersonEigenschaftFilme.Select(pef => pef.Eigenschaft.Bezeichnung).Distinct();
                            }
                            <div class="flex flex-wrap gap-2">
                                @foreach (var rolle in rollen)
                                {
                                    <span class="text-[10px] font-bold text-brand-primary uppercase tracking-widest bg-brand-soft px-2 py-1 rounded">@rolle</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Filmography -->
        <div class="lg:col-span-2 space-y-12">
            <header>
                <h1 class="text-5xl font-black tracking-tighter text-slate-900 dark:text-white leading-none transition-colors">@Model.Vorname @Model.Nachname</h1>
                <p class="mt-4 text-lg text-slate-500 dark:text-slate-400 font-medium transition-colors">Hintergrundinformationen und Mitwirkung an Filmprojekten.</p>
            </header>

            <section>
                <div class="flex items-center justify-between mb-8 border-b border-slate-100 dark:border-slate-800 pb-4 transition-colors">
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-3 transition-colors">
                        <i aria-hidden="true" class="fa-solid fa-clapperboard text-brand-primary"></i>
                        Filmografie
                    </h2>
                    <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest">
                        @Model.PersonEigenschaftFilme.Count Produktionen
                    </span>
                </div>

                <div class="grid grid-cols-1 gap-4">
                    @foreach (var pef in Model.PersonEigenschaftFilme)
                    {
                        <a asp-controller="Film" asp-action="Details" asp-route-id="@pef.Film.FilmID" class="flex items-center p-4 rounded-xl border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800/50 hover:border-brand-primary/20 dark:hover:border-brand-primary/20 transition-all group">
                            <div class="w-12 h-12 rounded-lg bg-brand-soft flex items-center justify-center text-brand-primary group-hover:scale-105 transition-transform">
                                <i aria-hidden="true" class="fa-solid fa-film"></i>
                            </div>
                            <div class="ml-4 flex-grow">
                                <div class="text-sm font-black text-slate-900 dark:text-white transition-colors">@pef.Film.Titel</div>
                                <div class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest">Als @pef.Eigenschaft.Bezeichnung (@pef.Film.Erscheinungsjahr)</div>
                            </div>
                            <i aria-hidden="true" class="fa-solid fa-chevron-right text-slate-200 dark:text-slate-700 group-hover:translate-x-1 transition-transform"></i>
                        </a>
                    }
                    @if (!Model.PersonEigenschaftFilme.Any())
                    {
                         <div class="p-12 rounded-2xl border-2 border-dashed border-slate-100 dark:border-slate-800 flex flex-col items-center text-slate-400 dark:text-slate-500 transition-colors">
                            <i aria-hidden="true" class="fa-solid fa-box-open text-4xl mb-3"></i>
                            <p class="text-sm font-medium">Bisher keine Film-Mitwirkungen verknüpft.</p>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
</div>
