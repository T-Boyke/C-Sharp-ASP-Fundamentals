@model IEnumerable<_10_Filmdatenbank.Domain.Entities.Person>

@{
    ViewData["Title"] = "Schauspieler & Team";
}

<div class="mx-auto max-w-7xl px-6 lg:px-8 py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 border-b border-slate-200 dark:border-slate-800 pb-8 transition-colors duration-300">
        <div>
            <div class="flex items-center gap-2 mb-2">
                <i aria-hidden="true" class="fa-solid fa-users text-brand-primary"></i>
                <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest leading-none">Mitwirkende</span>
            </div>
            <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white transition-colors">Schauspieler & Team</h1>
            <p class="mt-3 text-lg text-slate-500 dark:text-slate-400 max-w-2xl font-medium transition-colors">Entdecken Sie die Gesichter hinter unseren Filmproduktionen.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="mt-6 md:mt-0">
                <a asp-action="Create" class="btn-primary">
                    <i aria-hidden="true" class="fa-solid fa-plus mr-2"></i>
                    Hinzufügen
                </a>
            </div>
        }
    </div>

    <div class="grid-cards">
        @foreach (var person in Model)
        {
            <div class="card-premium group hover:shadow-2xl hover:shadow-brand-primary/10 flex flex-col items-center p-8 text-center transition-all duration-500 overflow-hidden">
                <!-- Profile Image -->
                <div class="relative mb-6">
                    <div class="w-32 h-32 rounded-full border-4 border-white dark:border-slate-950 shadow-2xl overflow-hidden bg-slate-100 dark:bg-slate-900 ring-1 ring-slate-100 dark:ring-slate-800">
                        @if (!string.IsNullOrEmpty(person.ProfilBildUrl))
                        {
                            <img src="@person.ProfilBildUrl" alt="@person.Vorname @person.Nachname" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center text-slate-300 dark:text-slate-800">
                                <i aria-hidden="true" class="fa-solid fa-user text-5xl opacity-20"></i>
                            </div>
                        }
                    </div>
                    
                    @if (person.Geburtsdatum.HasValue)
                    {
                        <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 shadow-lg whitespace-nowrap">
                            <span class="text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-tighter">
                                Born: @person.Geburtsdatum.Value.ToString("yyyy")
                            </span>
                        </div>
                    }
                </div>

                <!-- Content -->
                <div class="flex-grow flex flex-col">
                    <h2 class="text-xl font-black text-slate-900 dark:text-white tracking-tight mb-2">@person.Vorname @person.Nachname</h2>
                    
                    <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-3 mb-8 leading-relaxed italic">
                        "@person.Biografie"
                    </p>

                    <!-- Actions -->
                    <div class="mt-auto pt-6 border-t border-slate-50 dark:border-slate-800/50 flex flex-col gap-3">
                        <a asp-action="Details" asp-route-id="@person.PersonID" class="btn-primary py-2.5 shadow-lg shadow-brand-primary/10">Profil ansehen</a>
                        
                            <a asp-action="Edit" asp-route-id="@person.PersonID" class="w-10 h-10 flex-center rounded-xl bg-slate-50 dark:bg-slate-800/50 text-slate-400 hover:text-brand-primary transition-all border border-slate-100 dark:border-slate-800" title="Bearbeiten" aria-label="Bearbeiten">
                                <i aria-hidden="true" class="fa-solid fa-pen text-sm"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@person.PersonID" class="w-10 h-10 flex-center rounded-xl bg-slate-50 dark:bg-slate-800/50 text-slate-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all border border-slate-100 dark:border-slate-800" title="Löschen" aria-label="Löschen">
                                <i aria-hidden="true" class="fa-solid fa-trash text-sm"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    
    @if (!Model.Any())
    {
        <div class="text-center py-20 px-6 rounded-3xl border-2 border-dashed border-slate-100 dark:border-slate-800 transition-colors">
            <i aria-hidden="true" class="fa-solid fa-user-group text-6xl text-slate-200 dark:text-slate-800 mb-6"></i>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Keine Personen gefunden</h3>
            <p class="mt-2 text-slate-500 dark:text-slate-400 max-w-sm mx-auto">Es sind noch keine Schauspieler oder Team-Mitglieder in der Datenbank hinterlegt.</p>
        </div>
    }
</div>
