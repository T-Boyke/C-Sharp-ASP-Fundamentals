@model IEnumerable<_10_Filmdatenbank.Domain.Entities.Person>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PersonPageTitle"];
}

<div class="mx-auto max-w-7xl px-6 lg:px-8 py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 border-b border-border-default dark:border-dark-border pb-8 transition-colors duration-300">
        <div>
            <div class="flex items-center gap-2 mb-2">
                <i aria-hidden="true" class="fa-solid fa-users text-brand-primary"></i>
                <span class="text-xs font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest leading-none">@Localizer["Contributors"]</span>
            </div>
            <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white transition-colors">@Localizer["PersonHeader"]</h1>
            <p class="mt-3 text-lg text-text-description dark:text-dark-text-muted max-w-2xl font-medium transition-colors">@Localizer["PersonDescription"]</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="mt-6 md:mt-0">
                <a asp-action="Create" class="btn-primary" aria-label='@Localizer["AddPersonLabel"]'>
                    <i aria-hidden="true" class="fa-solid fa-plus mr-2"></i>
                    @Localizer["Add"]
                </a>
            </div>
        }
    </div>

    <div class="grid-person">
        @foreach (var person in Model)
        {
            <div class="card-premium group hover:shadow-2xl hover:shadow-brand-shadow flex flex-col items-center p-8 text-center transition-all duration-500 overflow-hidden">
                <!-- Profile Image -->
                <div class="relative mb-6">
                    <div class="w-32 h-32 rounded-full border-4 border-surface-overlay dark:border-dark-surface-soft shadow-2xl overflow-hidden bg-surface-subtle dark:bg-dark-surface-soft ring-1 ring-border-muted dark:ring-dark-border">
                        @if (!string.IsNullOrEmpty(person.ProfilBildUrl))
                        {
                            <img src="@person.ProfilBildUrl" alt="@person.Vorname @person.Nachname" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center text-slate-300 dark:text-dark-surface-muted">
                                <i aria-hidden="true" class="fa-solid fa-user text-5xl opacity-20"></i>
                            </div>
                        }
                    </div>
                    
                    @if (person.Geburtsdatum.HasValue)
                    {
                        <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-surface-overlay dark:bg-dark-surface border border-border-muted dark:border-dark-border shadow-lg whitespace-nowrap">
                            <span class="text-[9px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-tighter">
                                @Localizer["Born"]: @person.Geburtsdatum.Value.ToString("yyyy")
                            </span>
                        </div>
                    }
                </div>

                <!-- Content -->
                <div class="flex-grow flex flex-col">
                    <h2 class="text-xl font-black text-slate-900 dark:text-white tracking-tight mb-2">@person.Vorname @person.Nachname</h2>
                    
                    <p class="text-xs text-text-description dark:text-dark-text-muted line-clamp-3 mb-8 leading-relaxed italic">
                        "@person.Biografie"
                    </p>

                    <!-- Actions -->
                    <div class="mt-auto pt-6 border-t border-border-muted dark:border-dark-border-muted flex flex-col gap-3">
                        <a asp-action="Details" asp-route-id="@person.PersonID" class="btn-primary py-2.5 shadow-lg shadow-brand-shadow" aria-label='@Localizer["ViewProfileLabel", person.Vorname + " " + person.Nachname]'>@Localizer["ViewProfile"]</a>
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="flex-center gap-3">
                                <a asp-action="Edit" asp-route-id="@person.PersonID" class="w-10 h-10 flex-center rounded-xl bg-surface-muted/50 dark:bg-dark-surface text-text-muted hover:text-brand-primary transition-all border border-border-muted dark:border-dark-border" title='@Localizer["Edit"]' aria-label='@Localizer["EditLabel", person.Vorname + " " + person.Nachname]'>
                                    <i aria-hidden="true" class="fa-solid fa-pen text-sm"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@person.PersonID" class="w-10 h-10 flex-center rounded-xl bg-surface-muted/50 dark:bg-dark-surface text-text-muted hover:text-danger-primary hover:bg-danger-bg dark:hover:bg-danger-dark-bg transition-all border border-border-muted dark:border-dark-border" title='@Localizer["Delete"]' aria-label='@Localizer["DeleteLabel", person.Vorname + " " + person.Nachname]'>
                                    <i aria-hidden="true" class="fa-solid fa-trash text-sm"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    
    @if (!Model.Any())
    {
        <div class="text-center py-20 px-6 rounded-3xl border-2 border-dashed border-border-muted dark:border-dark-border transition-colors">
            <i aria-hidden="true" class="fa-solid fa-user-group text-6xl text-slate-200 dark:text-dark-surface-soft mb-6"></i>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">@Localizer["NoPersonsFound"]</h3>
            <p class="mt-2 text-text-description dark:text-dark-text-muted max-w-sm mx-auto">@Localizer["NoPersonsDescription"]</p>
        </div>
    }
</div>
