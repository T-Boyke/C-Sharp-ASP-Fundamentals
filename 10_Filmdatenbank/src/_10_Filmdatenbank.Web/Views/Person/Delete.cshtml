@model _10_Filmdatenbank.Domain.Entities.Person
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["DeleteConfirmationTitle"];
}

<div class="mx-auto max-w-2xl px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-danger-bg dark:bg-danger-dark-bg border border-danger-border dark:border-danger-dark-border text-danger-primary mb-6 shadow-sm animate-pulse">
            <i aria-hidden="true" class="fa-solid fa-triangle-exclamation text-4xl"></i>
        </div>
        <h1 class="text-4xl font-black tracking-tighter text-slate-900 dark:text-white mb-4 transition-colors">@Localizer["DeleteEntryQuestion"]</h1>
        <p class="text-lg text-text-description dark:text-dark-text-muted font-medium max-w-md mx-auto transition-colors">
            @Localizer["DeleteConfirmationMessage", Model.Vorname + " " + Model.Nachname]
        </p>
    </div>

    <div class="card-premium overflow-hidden p-8 border-border-muted dark:border-dark-border group">
        <div class="flex items-center gap-6 p-6 rounded-2xl bg-surface-muted/50 dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border mb-8 transition-colors">
            <div class="w-16 h-16 rounded-full bg-surface-overlay dark:bg-dark-surface-soft flex items-center justify-center text-text-muted dark:text-dark-text-muted shadow-sm transition-colors overflow-hidden border border-border-default dark:border-dark-border">
                @if (!string.IsNullOrEmpty(Model.ProfilBildUrl))
                {
                    <img src="@Model.ProfilBildUrl" alt='@Localizer["ProfileImageAlt", Model.Vorname + " " + Model.Nachname]' class="w-full h-full object-cover" />
                }
                else
                {
                    <i aria-hidden="true" class="fa-solid fa-user-circle text-3xl"></i>
                }
            </div>
            <div>
                <h3 class="text-xl font-black text-slate-900 dark:text-white uppercase tracking-tight transition-colors">@Model.Vorname @Model.Nachname</h3>
                <div class="flex items-center gap-3 text-sm font-bold text-text-description dark:text-dark-text-muted uppercase tracking-widest mt-1">
                    <span>@Localizer["IdLabel"]: #@Model.PersonID</span>
                    @if (Model.Geburtsdatum.HasValue)
                    {
                        <span class="w-1 h-1 rounded-full bg-border-default dark:border-dark-border"></span>
                        <span>@Localizer["BornLabel"] @Model.Geburtsdatum.Value.ToString("yyyy")</span>
                    }
                </div>
            </div>
        </div>

        <form asp-action="Delete" class="flex flex-col sm:flex-row gap-4">
            <input type="hidden" asp-for="PersonID" />
            <a asp-action="Index" class="btn-secondary flex-1 justify-center py-4" aria-label='@Localizer["CancelLabel"]'>
                <i aria-hidden="true" class="fa-solid fa-xmark mr-2"></i> @Localizer["Cancel"]
            </a>
            <button type="submit" class="btn-danger flex-[1.5] justify-center py-4 font-black" aria-label='@Localizer["DeleteConfirmLabel"]'>
                <i aria-hidden="true" class="fa-solid fa-trash-can mr-2"></i> @Localizer["DeleteConfirmButton"]
            </button>
        </form>

        <p class="mt-8 text-center text-[10px] font-bold text-text-description dark:text-dark-text-muted uppercase tracking-[0.2em] leading-relaxed">
            <i aria-hidden="true" class="fa-solid fa-circle-info mr-1"></i> @Localizer["DeleteWarningMessage"]
        </p>
    </div>
</div>
