@model _10_Filmdatenbank.Domain.Entities.Person
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["CreatePersonTitle"];
}

<div class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
    <div class="mb-8">
        <label for="tmdbPersonSearch" class="text-[10px] font-black text-brand-primary uppercase tracking-[0.2em] mb-3 block px-1">TMDB Suche</label>
        <div class="relative group">
            <input type="text" id="tmdbPersonSearch" 
                   class="w-full pl-12 pr-4 py-4 rounded-2xl bg-surface-overlay dark:bg-dark-surface-soft border-2 border-border-default dark:border-dark-border focus:border-brand-primary outline-hidden transition-all font-black text-text-main dark:text-white shadow-lg group-hover:border-brand-primary/50" 
                   placeholder="Name der Person suchen..." />
            <div class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted group-focus-within:text-brand-primary transition-colors">
                <i class="fa-solid fa-magnifying-glass text-xl"></i>
            </div>
            <div id="personSearchResults" class="absolute z-50 w-full mt-3 bg-surface-overlay dark:bg-dark-surface border border-border-default dark:border-dark-border rounded-2xl shadow-2xl max-h-96 overflow-y-auto hidden divide-y divide-border-muted transition-all">
                <!-- Results dynamic -->
            </div>
        </div>
    </div>

    <div class="form-group-card overflow-hidden !p-0">
        <form asp-action="Create" class="p-10 space-y-10">
            <!-- Hidden Fields for IDs and Extra Data -->
            <input type="hidden" asp-for="TmdbId" id="inputTmdbId" />
            <input type="hidden" asp-for="ImdbId" id="inputImdbId" />
            <input type="hidden" asp-for="WikidataId" id="inputWikidataId" />
            <input type="hidden" asp-for="FacebookId" id="inputFacebookId" />
            <input type="hidden" asp-for="InstagramId" id="inputInstagramId" />
            <input type="hidden" asp-for="TwitterId" id="inputTwitterId" />
            <input type="hidden" asp-for="AlsoKnownAs" id="inputAlsoKnownAs" />

            <div class="form-group-header">
                <div>
                    <h2 class="text-xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["PersonalInfo"]</h2>
                    <p class="text-[10px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest mt-1">@Localizer["CompleteEntry"]</p>
                </div>
                <i aria-hidden="true" class="fa-solid fa-id-card text-border-default dark:text-dark-surface-muted text-2xl"></i>
            </div>

            <div asp-validation-summary="ModelOnly" role="alert" class="p-4 rounded-xl bg-danger-bg dark:bg-danger-dark-bg text-danger-content dark:text-danger-dark-content text-sm font-bold border border-danger-border dark:border-danger-dark-border italic mb-8"></div>

            <div class="space-y-8">
                <div class="form-group-row">
                    <div class="flex flex-col gap-1.5 flex-grow">
                        <label asp-for="Vorname" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["FirstName"]</label>
                        <input asp-for="Vorname" id="inputVorname" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder='@Localizer["FirstNamePlaceholder"]' />
                        <span asp-validation-for="Vorname" class="text-[10px] font-bold text-danger-primary mt-1 px-1"></span>
                    </div>

                    <div class="flex flex-col gap-1.5 flex-grow">
                        <label asp-for="Nachname" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LastName"]</label>
                        <input asp-for="Nachname" id="inputNachname" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder='@Localizer["LastNamePlaceholder"]' />
                        <span asp-validation-for="Nachname" class="text-[10px] font-bold text-danger-primary mt-1 px-1"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="Geburtsdatum" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["DateOfBirth"]</label>
                        <input asp-for="Geburtsdatum" id="inputBirthday" type="date" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="Deathday" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Sterbedatum</label>
                        <input asp-for="Deathday" id="inputDeathday" type="date" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="Geburtsort" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["PlaceOfBirth"]</label>
                        <input asp-for="Geburtsort" id="inputBirthplace" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder='@Localizer["PlaceOfBirthPlaceholder"]' />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="Gender" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Geschlecht</label>
                        <select asp-for="Gender" id="inputGender" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white">
                            <option value="0">Unbekannt</option>
                            <option value="1">Weiblich</option>
                            <option value="2">Männlich</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="ProfilBildUrl" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["ProfilePictureUrl"]</label>
                        <input asp-for="ProfilBildUrl" id="inputProfileUrl" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder='@Localizer["ProfilePictureUrlPlaceholder"]' />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="Homepage" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Homepage</label>
                        <input asp-for="Homepage" id="inputHomepage" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder="https://..." />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="KnownForDepartment" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Bereich (Acting, etc.)</label>
                        <input asp-for="KnownForDepartment" id="inputDepartment" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="Popularity" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Popularität</label>
                        <input asp-for="Popularity" id="inputPopularity" type="number" step="0.01" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                    </div>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="Awards" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Auszeichnungen / Preise</label>
                    <input asp-for="Awards" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder="Oscars, Golden Globes..." />
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="Biografie" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["Biography"]</label>
                    <textarea asp-for="Biografie" id="inputBiography" rows="6" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-medium text-text-description dark:text-dark-text-muted" placeholder='@Localizer["BiographyPlaceholder"]'></textarea>
                </div>
                
                <div class="flex items-center gap-3 px-1">
                    <input asp-for="Adult" type="checkbox" class="w-5 h-5 rounded border-border-default dark:border-dark-border text-brand-primary focus:ring-brand-primary" />
                    <label asp-for="Adult" class="text-sm font-bold text-text-main dark:text-white">Nur für Erwachsene</label>
                </div>
            </div>

            <div class="form-group-footer">
                 <p class="text-[10px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-[0.2em] max-w-[200px] leading-relaxed">
                    @Localizer["SpellcheckWarning"]
                </p>
                <div class="flex flex-col gap-3">
                    <div class="flex-wrap-gap">
                        <a asp-action="Index" class="btn-secondary" aria-label='@Localizer["CancelLabel"]'>@Localizer["Cancel"]</a>
                        <button type="submit" class="btn-primary" aria-label='@Localizer["SubmitPersonLabel"]'>
                            <i aria-hidden="true" class="fa-solid fa-user-plus mr-2"></i> @Localizer["CreatePersonButton"]
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            let searchTimeout;
            const $search = $('#tmdbPersonSearch');
            const $results = $('#personSearchResults');

            function setVal(id, val) {
                const el = document.getElementById(id);
                if (el) el.value = val || '';
            }

            $search.on('input', function() {
                clearTimeout(searchTimeout);
                const query = $(this).val();
                if (query.length < 2) {
                    $results.hide();
                    return;
                }

                searchTimeout = setTimeout(function() {
                    $.get('/Tmdb/search-person?query=' + encodeURIComponent(query), function(data) {
                        $results.empty().show();
                        if (data.length === 0) {
                            $results.append('<div class="p-4 text-sm text-text-muted">Keine Ergebnisse gefunden</div>');
                        } else {
                            data.forEach(p => {
                                const img = p.profilePath ? `https://image.tmdb.org/t/p/w92${p.profilePath}` : null;
                                const html = `
                                    <div class="p-4 flex items-center gap-4 cursor-pointer hover:bg-surface-muted transition-colors select-person" data-id="${p.id}">
                                        <div class="w-12 h-12 rounded-lg bg-surface-subtle shrink-0 overflow-hidden border border-border-muted">
                                            ${img ? `<img src="${img}" class="w-full h-full object-cover">` : '<i class="fa-solid fa-user p-3 text-text-muted"></i>'}
                                        </div>
                                        <div>
                                            <p class="font-black text-text-main dark:text-white text-sm">${p.name}</p>
                                            <p class="text-[10px] font-bold text-text-muted uppercase tracking-widest">${p.department || 'Allgemein'}</p>
                                        </div>
                                    </div>
                                `;
                                $results.append(html);
                            });
                        }
                    });
                }, 500);
            });

            $(document).on('click', '.select-person', function() {
                const id = $(this).data('id');
                $results.hide();
                $search.val('Lade Details...');

                $.get('/Tmdb/person/' + id, function(p) {
                    $search.val(p.name);
                    
                    // Split name
                    const nameParts = p.name.split(' ');
                    setVal('inputVorname', nameParts[0]);
                    setVal('inputNachname', nameParts.slice(1).join(' '));
                    
                    setVal('inputTmdbId', p.id);
                    setVal('inputImdbId', p.imdbId);
                    setVal('inputFacebookId', p.facebookId);
                    setVal('inputInstagramId', p.instagramId);
                    setVal('inputTwitterId', p.twitterId);
                    setVal('inputWikidataId', p.tmdbWikidataId);
                    setVal('inputBirthday', p.birthday);
                    setVal('inputDeathday', p.deathday);
                    setVal('inputBirthplace', p.placeOfBirth);
                    setVal('inputBiography', p.biography);
                    setVal('inputProfileUrl', p.profileUrl);
                    setVal('inputHomepage', p.homepage);
                    setVal('inputDepartment', p.knownForDepartment);
                    setVal('inputPopularity', p.popularity);
                    setVal('inputGender', p.gender);
                    setVal('inputAlsoKnownAs', p.alsoKnownAs);
                    
                    const adultCheck = document.querySelector('input[name="Adult"]');
                    if (adultCheck) adultCheck.checked = p.adult || false;
                    
                    toastr.success('Daten von TMDB geladen!');
                });
            });

            $(document).on('click', function(e) {
                if (!$(e.target).closest('.relative').length) $results.hide();
            });
        });
    </script>
}
