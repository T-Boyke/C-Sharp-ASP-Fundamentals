@model _10_Filmdatenbank.Domain.Entities.Person

@{
    ViewData["Title"] = "Neuaufnahme Team";
}

<div class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-12">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-brand-soft border border-brand-border flex items-center justify-center text-brand-primary shadow-sm transition-transform hover:scale-105">
                <i aria-hidden="true" class="fa-solid fa-user-plus text-2xl"></i>
            </div>
            <div>
                <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white leading-none transition-colors">Neuer Mitwirkender</h1>
                <p class="mt-2 text-sm font-bold text-slate-400 uppercase tracking-widest">Personendaten erfassen</p>
            </div>
        </div>
        <a asp-action="Index" class="text-sm font-bold text-slate-400 hover:text-brand-primary transition-all flex items-center gap-2 uppercase tracking-widest">
            <i aria-hidden="true" class="fa-solid fa-chevron-left"></i> Zurück
        </a>
    </div>

    <div class="card-premium overflow-hidden">
        <form asp-action="Create" class="p-10 space-y-10">
            <div asp-validation-summary="ModelOnly" role="alert" class="p-4 rounded-xl bg-red-50 text-red-600 text-sm font-bold border border-red-100 italic"></div>

            <div class="space-y-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="form-group">
                        <label asp-for="Vorname" class="form-label">
                            <i aria-hidden="true" class="fa-solid fa-signature mr-1 text-slate-400 dark:text-slate-500"></i> Vorname
                        </label>
                        <input asp-for="Vorname" class="form-input" placeholder="z.B. Keanu" />
                        <span asp-validation-for="Vorname" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Nachname" class="form-label">
                            <i aria-hidden="true" class="fa-solid fa-signature mr-1 text-slate-400 dark:text-slate-500"></i> Nachname
                        </label>
                        <input asp-for="Nachname" class="form-input" placeholder="z.B. Reeves" />
                        <span asp-validation-for="Nachname" class="form-error"></span>
                    </div>
                </div>
            </div>

            <div class="card-footer flex-between gap-6">
                 <p class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] max-w-[200px] leading-relaxed">
                    Bitte geben Sie den vollständigen Namen der Person ein.
                </p>
                <div class="flex flex-col gap-3">
                    <div class="flex-wrap-gap">
                        <a asp-action="Index" class="btn-secondary">Abbrechen</a>
                        <button type="submit" class="btn-primary">
                            <i aria-hidden="true" class="fa-solid fa-user-plus mr-2"></i> Person speichern
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
