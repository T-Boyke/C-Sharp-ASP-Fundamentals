@model _10_Filmdatenbank.Domain.Entities.Person
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["EditPersonTitle", Model.Vorname + " " + Model.Nachname];
}

<div class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-12">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-brand-soft border border-brand-border flex items-center justify-center text-brand-primary shadow-sm transition-transform hover:scale-105" aria-hidden="true">
                <i aria-hidden="true" class="fa-solid fa-user-pen text-2xl"></i>
            </div>
            <div>
                <h1 class="text-3xl font-black tracking-tight text-text-main dark:text-white leading-none transition-colors">@Localizer["AdjustProfile"]</h1>
                <p class="mt-2 text-sm font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest">@Localizer["SaveChanges"]</p>
            </div>
        </div>
        <a asp-action="Index" class="text-sm font-bold text-text-muted hover:text-brand-primary transition-all flex items-center gap-2 uppercase tracking-widest" aria-label='@Localizer["BackToListLabel"]'>
            <i aria-hidden="true" class="fa-solid fa-chevron-left"></i> @Localizer["Back"]
        </a>
    </div>

    <div class="form-group-card mb-8">
        <div class="p-8">
            <div class="flex flex-col gap-1.5 relative">
                <label class="text-[10px] font-black text-brand-primary uppercase tracking-widest px-1">TMDB Abgleich</label>
                <div class="relative group">
                    <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-brand-primary opacity-50">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input type="text" id="tmdbPersonSearch" 
                           class="w-full pl-12 pr-4 py-4 rounded-xl bg-brand-soft/30 dark:bg-dark-surface-soft border-2 border-brand-border/20 focus:border-brand-primary focus:ring-4 focus:ring-brand-primary/10 outline-hidden transition-all font-black text-text-main dark:text-white" 
                           placeholder="Person auf TMDB suchen zum Aktualisieren..." />
                    <div id="searchResults" class="hidden absolute top-full left-0 right-0 mt-2 bg-surface-bright dark:bg-dark-surface rounded-2xl shadow-2xl border border-border-default dark:border-dark-border z-100 max-h-96 overflow-y-auto overflow-x-hidden backdrop-blur-xl bg-surface-bright/95 dark:bg-dark-surface/95 transition-all">
                        <!-- Results dynamic -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-group-card overflow-hidden !p-0">
        <form asp-action="Edit" class="p-10 space-y-10">
            <input type="hidden" asp-for="PersonID" />
            <input type="hidden" asp-for="TmdbId" id="inputTmdbId" />
            
            <div class="form-group-header">
                <div>
                    <h2 class="text-xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["EditProfile"]</h2>
                    <p class="text-[10px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest mt-1">@Localizer["SyncData"]</p>
                </div>
                <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-surface-muted dark:bg-dark-surface border border-border-muted dark:border-dark-border text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase">
                    @Localizer["ContributorId"]: #@Model.PersonID
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" role="alert" class="p-4 rounded-xl bg-danger-bg dark:bg-danger-dark-bg text-danger-content dark:text-danger-dark-content text-sm font-bold border border-danger-border dark:border-danger-dark-border italic mb-8"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="flex flex-col gap-1.5 flex-grow">
                    <label asp-for="Vorname" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["FirstName"]</label>
                    <input asp-for="Vorname" id="inputVorname" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" aria-required="true" />
                    <span asp-validation-for="Vorname" class="text-[10px] font-bold text-danger-primary mt-1 px-1"></span>
                </div>

                <div class="flex flex-col gap-1.5 flex-grow">
                    <label asp-for="Nachname" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LastName"]</label>
                    <input asp-for="Nachname" id="inputNachname" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" aria-required="true" />
                    <span asp-validation-for="Nachname" class="text-[10px] font-bold text-danger-primary mt-1 px-1"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Geburtsdatum" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["BirthDate"]</label>
                    <input asp-for="Geburtsdatum" id="inputBirthday" type="date" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Deathday" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Sterbedatum</label>
                    <input asp-for="Deathday" id="inputDeathday" type="date" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Geburtsort" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["BirthPlace"]</label>
                    <input asp-for="Geburtsort" id="inputBirthplace" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder='@Localizer["BirthPlacePlaceholder"]' />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Gender" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Geschlecht (0-U, 1-F, 2-M)</label>
                    <input asp-for="Gender" id="inputGender" type="number" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="flex flex-col gap-1.5">
                    <label asp-for="ProfilBildUrl" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["ProfileImageUrl"]</label>
                    <input asp-for="ProfilBildUrl" id="inputProfileUrl" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder='@Localizer["ProfileImageUrlPlaceholder"]' />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Homepage" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Homepage</label>
                    <input asp-for="Homepage" id="inputHomepage" type="url" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder="https://..." />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="flex flex-col gap-1.5">
                    <label asp-for="KnownForDepartment" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Bereich</label>
                    <input asp-for="KnownForDepartment" id="inputDepartment" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Popularity" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Popularität</label>
                    <input asp-for="Popularity" id="inputPopularity" type="number" step="0.1" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                </div>
            </div>

            <div class="flex flex-col gap-1.5">
                <label asp-for="Biografie" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["Biography"]</label>
                <textarea asp-for="Biografie" id="inputBiography" rows="6" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-medium text-text-description dark:text-dark-text-muted" placeholder='@Localizer["BiographyPlaceholder"]'></textarea>
            </div>

            <div class="flex flex-col gap-1.5">
                <label asp-for="AlsoKnownAs" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Auch bekannt als (kommagetrennt)</label>
                <input asp-for="AlsoKnownAs" id="inputAlsoKnownAs" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
            </div>

            <div class="form-group-card bg-surface-subtle/50 dark:bg-dark-surface border border-border-muted dark:border-dark-border">
                <div class="p-6 space-y-6">
                    <p class="text-[10px] font-black text-text-muted uppercase tracking-widest">Externe Identifikatoren & Social Media</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="ImdbId" class="text-[9px] font-bold text-text-muted uppercase">IMDb ID</label>
                            <input asp-for="ImdbId" id="inputImdbId" class="px-3 py-2 rounded-lg bg-white dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="FacebookId" class="text-[9px] font-bold text-text-muted uppercase">Facebook ID</label>
                            <input asp-for="FacebookId" id="inputFacebookId" class="px-3 py-2 rounded-lg bg-white dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="InstagramId" class="text-[9px] font-bold text-text-muted uppercase">Instagram ID</label>
                            <input asp-for="InstagramId" id="inputInstagramId" class="px-3 py-2 rounded-lg bg-white dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="TwitterId" class="text-[9px] font-bold text-text-muted uppercase">Twitter ID</label>
                            <input asp-for="TwitterId" id="inputTwitterId" class="px-3 py-2 rounded-lg bg-white dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="WikidataId" class="text-[9px] font-bold text-text-muted uppercase">Wikidata ID</label>
                            <input asp-for="WikidataId" id="inputWikidataId" class="px-3 py-2 rounded-lg bg-white dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                        </div>
                        <div class="flex items-center gap-3 pt-4">
                            <input asp-for="Adult" type="checkbox" class="w-5 h-5 rounded border-border-default dark:border-dark-border text-brand-primary" />
                            <label asp-for="Adult" class="text-xs font-bold">Nur für Erwachsene</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group-footer">
                 <p class="text-[10px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-[0.2em] max-w-[200px] leading-relaxed">
                    @Localizer["GlobalSyncWarning"]
                </p>
                <div class="flex flex-col gap-3">
                    <div class="flex-wrap-gap">
                        <a asp-action="Index" class="btn-secondary" aria-label='@Localizer["CancelLabel"]'>@Localizer["Cancel"]</a>
                        <button type="submit" class="btn-primary" aria-label='@Localizer["SaveLabel"]'>
                            <i aria-hidden="true" class="fa-solid fa-floppy-disk mr-2"></i> @Localizer["SaveData"]
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            let searchTimeout;
            const $search = $('#tmdbPersonSearch');
            const $results = $('#searchResults');

            $search.on('input', function() {
                clearTimeout(searchTimeout);
                const query = $(this).val();
                if (query.length < 2) {
                    $results.hide();
                    return;
                }

                searchTimeout = setTimeout(function() {
                    $.get('/Tmdb/search-person?query=' + encodeURIComponent(query), function(data) {
                        $results.empty().show();
                        data.forEach(p => {
                            const html = `
                                <div class="px-6 py-4 flex items-center gap-4 cursor-pointer hover:bg-brand-primary/5 dark:hover:bg-brand-primary/10 transition-all select-person" data-id="${p.id}">
                                    <div class="w-12 h-12 rounded-full overflow-hidden bg-surface-subtle shrink-0 shadow-md">
                                        ${p.profilePath ? `<img src="https://image.tmdb.org/t/p/w185${p.profilePath}" class="w-full h-full object-cover">` : '<i class="fa-solid fa-user p-3 opacity-20"></i>'}
                                    </div>
                                    <div class="flex flex-col">
                                        <div class="font-black text-text-main dark:text-white text-sm leading-tight">${p.name}</div>
                                        <div class="text-[10px] font-bold text-text-muted uppercase tracking-widest mt-0.5">${p.knownForDepartment || 'Unbekannt'}</div>
                                    </div>
                                </div>
                            `;
                            $results.append(html);
                        });
                    });
                }, 500);
            });

            $(document).on('click', '.select-person', function() {
                const id = $(this).data('id');
                $results.hide();
                $search.val('Lade Details...');

                $.get('/Tmdb/person/' + id, function(p) {
                    $search.val(p.name);
                    
                    // Split Name
                    const nameParts = p.name.split(' ');
                    if (nameParts.length > 1) {
                        $('#inputVorname').val(nameParts[0]);
                        $('#inputNachname').val(nameParts.slice(1).join(' '));
                    } else {
                        $('#inputVorname').val(p.name);
                        $('#inputNachname').val('');
                    }

                    $('#inputBirthday').val(p.birthday ? p.birthday.split('T')[0] : '');
                    $('#inputDeathday').val(p.deathday ? p.deathday.split('T')[0] : '');
                    $('#inputBirthplace').val(p.placeOfBirth);
                    $('#inputBiography').val(p.biography);
                    $('#inputProfileUrl').val(p.profilePath ? 'https://image.tmdb.org/t/p/original' + p.profilePath : '');
                    $('#inputDepartment').val(p.knownForDepartment);
                    $('#inputPopularity').val(p.popularity);
                    $('#inputGender').val(p.gender);
                    $('#inputHomepage').val(p.homepage);
                    $('#inputAlsoKnownAs').val(p.alsoKnownAs ? p.alsoKnownAs.join(', ') : '');
                    $('#inputTmdbId').val(p.id);
                    $('#inputImdbId').val(p.imdbId);
                    $('#inputFacebookId').val(p.facebookId);
                    $('#inputInstagramId').val(p.instagramId);
                    $('#inputTwitterId').val(p.twitterId);
                    $('#inputWikidataId').val(p.wikidataId);
                    $('input[name="Adult"]').prop('checked', p.adult);

                    toastr.success('Daten von TMDB übernommen!');
                }).fail(function() {
                    $search.val('');
                    toastr.error('Fehler beim Laden der Details.');
                });
            });
            
            // Close search on click outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.relative').length) {
                    $results.hide();
                }
            });
        });
    </script>
}
