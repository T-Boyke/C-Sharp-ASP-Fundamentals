@using Microsoft.AspNetCore.Identity
@using _10_Filmdatenbank.Domain.Entities
@inject UserManager<ApplicationUser> UserManager

@{
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var direction = isRtl ? "rtl" : "ltr";
    
    string userTheme = "default";
    if (User.Identity?.IsAuthenticated == true)
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null && !string.IsNullOrEmpty(user.SettingsJson))
        {
            try 
            {
                var settings = System.Text.Json.JsonSerializer.Deserialize<_10_Filmdatenbank.Web.Models.UserSettingsData>(user.SettingsJson);
                userTheme = settings?.Theme ?? "default";
            }
            catch { /* fallback to default */ }
        }
    }
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@direction" class="h-full" data-theme="@(userTheme != "default" ? userTheme : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["AppTitle"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/noto-sans/index.css" />
    <script src="~/js/darkmode.js" asp-append-version="true"></script>
    <script defer src="~/lib/alpinejs/alpine.min.js"></script>
</head>
<body class="h-full flex flex-col bg-brand-bg dark:bg-dark-surface text-text-main dark:text-dark-text-main font-sans antialiased transition-colors duration-300">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[100] px-4 py-2 bg-brand-primary text-white rounded-lg shadow-xl font-bold">
        @Localizer["SkipToContent"]
    </a>
    
    <partial name="_Navigation" />

    <main id="main-content" class="flex-grow" role="main" tabindex="-1">
        @RenderBody()
    </main>

    <partial name="_Footer" />
    <partial name="_Toast" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
