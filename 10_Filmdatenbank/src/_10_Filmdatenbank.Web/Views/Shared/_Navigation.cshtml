@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Identity.SignInManager<_10_Filmdatenbank.Domain.Entities.ApplicationUser> SignInManager
@inject Microsoft.AspNetCore.Identity.UserManager<_10_Filmdatenbank.Domain.Entities.ApplicationUser> UserManager

<header class="sticky top-0 z-50 w-full transition-all duration-300" id="main-nav">
    <nav class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 py-4 transition-all duration-300" id="nav-container">
        <div class="glass-navigation flex h-16 items-center justify-between px-6 rounded-2xl border border-glass-border shadow-2xl shadow-shadow-overlay relative">
            
            <!-- Logo Section -->
            <div class="flex items-center gap-8">
                <a asp-controller="Home" asp-action="Index" class="group flex items-center gap-3" aria-label="Couch DB Home">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-linear-to-br from-brand-primary to-brand-hover shadow-lg shadow-brand-primary/20 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-play text-white text-lg ml-1" aria-hidden="true"></i>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-lg font-black text-white tracking-tighter leading-none group-hover:text-brand-primary transition-colors">COUCH<span class="text-brand-primary group-hover:text-white">DB</span></span>
                        <span class="text-[9px] font-bold text-text-muted uppercase tracking-[0.2em] leading-none mt-1">@Localizer["PremiumEdition"]</span>
                    </div>
                </a>

                <!-- Desktop Menu -->
                <div class="hidden lg:flex items-center gap-1" role="menubar">
                    @if (SignInManager.IsSignedIn(User))
                    {
                         <a asp-controller="User" asp-action="Dashboard" class="nav-link-modern @(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" && ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")" role="menuitem">
                            <i class="fa-solid fa-house-chimney text-xs" aria-hidden="true"></i>
                            @Localizer["Dashboard"]
                        </a>
                        <a asp-controller="Film" asp-action="Index" class="nav-link-modern @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Film" ? "active" : "")" role="menuitem">
                            <i class="fa-solid fa-film text-xs" aria-hidden="true"></i>
                            @Localizer["Movies"]
                        </a>
                        <a asp-controller="Group" asp-action="Discovery" class="nav-link-modern @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Group" ? "active" : "")" role="menuitem">
                            <i class="fa-solid fa-people-group text-xs" aria-hidden="true"></i>
                            @Localizer["Community"]
                        </a>
                        <a asp-controller="Collection" asp-action="Index" class="nav-link-modern @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Collection" ? "active" : "")" role="menuitem">
                            <i class="fa-solid fa-layer-group text-xs" aria-hidden="true"></i>
                            @Localizer["Collections"]
                        </a>
                        <a asp-controller="Person" asp-action="Index" class="nav-link-modern @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Person" ? "active" : "")" role="menuitem">
                            <i class="fa-solid fa-users-viewfinder text-xs" aria-hidden="true"></i>
                            @Localizer["People"]
                        </a>
                        <a asp-controller="Studio" asp-action="Index" class="nav-link-modern @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Studio" ? "active" : "")" role="menuitem">
                            <i class="fa-solid fa-building-columns text-xs" aria-hidden="true"></i>
                            @Localizer["Studios"]
                        </a>
                    }
                </div>
            </div>

            <!-- Right Actions -->
            <div class="flex items-center gap-3">
                
                @if (SignInManager.IsSignedIn(User))
                {
                    <!-- Notifications -->
                    <div class="relative">
                        <a asp-controller="User" asp-action="Dashboard" class="flex h-10 w-10 items-center justify-center rounded-xl text-nav-link hover:text-brand-primary hover:bg-brand-primary/5 transition-all relative" aria-label="@Localizer["Notifications"]">
                            <i class="fa-regular fa-bell text-lg" aria-hidden="true"></i>
                            @await Component.InvokeAsync("NotificationCount")
                        </a>
                    </div>

                    <div class="h-8 w-px bg-glass-border mx-2 hidden lg:block" aria-hidden="true"></div>

                    <!-- User Profile Dropdown -->
                    <div class="relative group ml-1">
                         @{
                            var user = await UserManager.GetUserAsync(User);
                        }
                        <button class="flex items-center gap-3 pl-1 pr-3 py-1 rounded-xl bg-glass-bg border border-glass-border-muted hover:border-brand-primary/30 transition-all hover:bg-glass-bg-hover" aria-haspopup="true" aria-expanded="false">
                            <div class="h-8 w-8 rounded-lg bg-brand-primary/20 flex items-center justify-center text-brand-primary font-black text-xs overflow-hidden border border-brand-primary/20">
                                @if (user?.ProfilePicture != null)
                                {
                                    <img src="data:@(user.ProfilePictureContentType);base64,@Convert.ToBase64String(user.ProfilePicture)" class="h-full w-full object-cover" alt="@user.FirstName's profile picture" />
                                }
                                else
                                {
                                    <span aria-hidden="true">@User.Identity.Name?[0].ToString().ToUpper()</span>
                                }
                            </div>
                            <span class="text-xs font-bold text-white hidden sm:block">@user?.FirstName</span>
                            <i class="fa-solid fa-chevron-down text-[10px] text-text-muted transition-transform group-hover:rotate-180" aria-hidden="true"></i>
                        </button>

                        <div class="absolute right-0 top-full pt-2 w-64 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all z-50">
                            <div class="p-2 rounded-2xl bg-nav-surface border border-nav-border shadow-2xl">
                                <div class="px-4 py-3 border-b border-nav-border mb-2 flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-brand-primary/20 flex items-center justify-center text-brand-primary font-black overflow-hidden">
                                         @if (user?.ProfilePicture != null)
                                         {
                                             <img src="data:@user.ProfilePictureContentType;base64,@Convert.ToBase64String(user.ProfilePicture)" class="w-full h-full object-cover" alt="" />
                                         }
                                         else { <span aria-hidden="true">@user?.FirstName?[0]</span> }
                                    </div>
                                    <div class="flex flex-col overflow-hidden text-left">
                                        <p class="text-xs font-black text-white truncate">@user?.FirstName @user?.LastName</p>
                                        <p class="text-[10px] text-text-muted truncate">@user?.Email</p>
                                    </div>
                                </div>
                                
                                <a asp-controller="User" asp-action="Profile" class="dropdown-item">
                                    <i class="fa-solid fa-user-gear text-brand-primary" aria-hidden="true"></i>
                                    @Localizer["SettingsProfile"]
                                </a>
                                <a asp-controller="User" asp-action="Settings" class="dropdown-item">
                                    <i class="fa-solid fa-palette text-brand-primary" aria-hidden="true"></i>
                                    @Localizer["AppearanceAndSettings"]
                                </a>
                                <a asp-controller="User" asp-action="Groups" class="dropdown-item">
                                    <i class="fa-solid fa-people-roof text-brand-primary" aria-hidden="true"></i>
                                    @Localizer["MyCommunities"]
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="h-px bg-nav-border my-2"></div>
                                    <a asp-controller="Admin" asp-action="ManageUsers" class="dropdown-item text-brand-primary">
                                        <i class="fa-solid fa-users-gear" aria-hidden="true"></i>
                                        @Localizer["UserManagement"]
                                    </a>
                                }

                                <div class="h-px bg-nav-border my-2"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="w-full dropdown-item text-danger-primary hover:bg-danger-primary/10">
                                        <i class="fa-solid fa-power-off" aria-hidden="true"></i>
                                        @Localizer["SignOut"]
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-2">
                        <a asp-controller="Account" asp-action="Login" class="text-sm font-bold text-nav-link hover:text-white transition-colors px-4 py-2">
                            @Localizer["Login"]
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="px-5 py-2.5 rounded-xl bg-brand-primary text-white text-sm font-black hover:bg-brand-hover transition-all shadow-lg shadow-brand-primary/30 hover:-translate-y-0.5">
                            @Localizer["JoinNow"]
                        </a>
                    </div>
                }

                <!-- Mobile Menu Button -->
                <button class="lg:hidden h-10 w-10 flex items-center justify-center rounded-xl bg-glass-bg text-white" aria-label="@Localizer["Menu"]" id="mobile-menu-toggle">
                    <i class="fa-solid fa-bars-staggered" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </nav>
</header>

<style>
    .glass-navigation {
        background: var(--color-dark-surface-overlay);
        backdrop-filter: blur(24px) saturate(200%);
        -webkit-backdrop-filter: blur(24px) saturate(200%);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-link-modern {
        @@apply flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold text-nav-link hover:text-white hover:bg-glass-bg transition-all duration-300;
    }

    .nav-link-modern.active {
        @@apply text-white bg-glass-bg-hover border border-glass-border-muted shadow-inner shadow-glass-border-muted;
    }

    .dropdown-item {
        @@apply flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-bold text-nav-link hover:bg-glass-bg hover:text-white transition-all duration-200;
    }

    #main-nav.scrolled #nav-container {
        @@apply py-2 px-0 max-w-none;
    }

    #main-nav.scrolled .glass-navigation {
        @@apply rounded-none border-x-0 border-t-0 bg-nav-surface/95 shadow-2xl px-8;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('main-nav');
            if (window.scrollY > 20) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });
    });
</script>
