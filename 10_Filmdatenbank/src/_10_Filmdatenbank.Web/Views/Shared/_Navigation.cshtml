@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject SignInManager<IdentityUser> SignInManager

<header class="sticky top-0 z-50 w-full bg-nav-bg border-b border-nav-border shadow-xl transition-all duration-300">
    <nav class="mx-auto flex max-w-7xl items-center justify-between p-3 px-6 lg:px-8" aria-label="Global">
        <div class="flex items-center gap-10">
            <!-- Logo -->
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-3 group" aria-label="FilmDB Home">
                <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-brand-primary shadow-lg shadow-brand-primary/20 group-hover:bg-brand-hover transition-all duration-300 group-hover:scale-105" aria-hidden="true">
                    <i aria-hidden="true" class="fa-solid fa-clapperboard text-white text-lg"></i>
                </div>
                <span class="text-lg font-black tracking-tighter text-white">Film<span class="text-brand-primary">DB</span></span>
            </a>

            <!-- Primary Nav -->
            <div class="hidden lg:flex lg:gap-x-8">
                <a asp-area="" asp-controller="Home" asp-action="Index" 
                   class="text-sm font-bold text-nav-link hover:text-nav-link-hover transition-colors flex items-center gap-2"
                   aria-current='@(Context.Request.Path == "/" || Context.Request.Path == "/Home/Index" ? "page" : null)'>
                    @Localizer["Home"]
                </a>
                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-area="" asp-controller="Film" asp-action="Index" 
                       class="text-sm font-bold text-nav-link hover:text-nav-link-hover transition-colors flex items-center gap-2"
                       aria-current='@(Context.Request.Path.StartsWithSegments("/Film") ? "page" : null)'>
                        @Localizer["Films"]
                    </a>
                    <a asp-area="" asp-controller="Person" asp-action="Index" 
                       class="text-sm font-bold text-nav-link hover:text-nav-link-hover transition-colors flex items-center gap-2"
                       aria-current='@(Context.Request.Path.StartsWithSegments("/Schauspieler") ? "page" : null)'>
                        @Localizer["Contributors"]
                    </a>
                    <a asp-area="" asp-controller="Collection" asp-action="Index" 
                       class="text-sm font-bold text-nav-link hover:text-nav-link-hover transition-colors flex items-center gap-2"
                       aria-current='@(Context.Request.Path.StartsWithSegments("/Kollektionen") ? "page" : null)'>
                        @Localizer["Collections"]
                    </a>
                    <a asp-area="" asp-controller="ProductionCompany" asp-action="Index" 
                       class="text-sm font-bold text-nav-link hover:text-nav-link-hover transition-colors flex items-center gap-2"
                       aria-current='@(Context.Request.Path.StartsWithSegments("/Studios") ? "page" : null)'>
                        @Localizer["Studios"]
                    </a>
                }
            </div>
        </div>
        
        <div class="flex items-center gap-6">
            @if (SignInManager.IsSignedIn(User))
            {
                <!-- Quick Action for Admins -->
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Film" asp-action="Create" class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-lg bg-brand-primary text-white text-xs font-black hover:bg-brand-hover transition-all shadow-lg shadow-brand-primary/20 hover:-translate-y-0.5">
                        <i aria-hidden="true" class="fa-solid fa-plus-circle text-sm"></i>
                        @Localizer["NewFilm"]
                    </a>
                }

                <div class="h-6 w-px bg-nav-accent hidden sm:block"></div>

                <!-- Admin Settings Dropdown -->
                @if (User.IsInRole("Admin"))
                {
                    <div class="relative" x-data="{ open: false }" @@click.away="open = false">
                        <button type="button" @@click="open = !open" 
                                class="w-9 h-9 flex items-center justify-center rounded-lg bg-nav-surface border border-nav-border text-nav-link hover:text-brand-primary hover:border-brand-primary/50 transition-all" 
                                aria-haspopup="true" :aria-expanded="open">
                            <i class="fa-solid fa-bars text-sm"></i>
                        </button>
                        <div x-show="open"
                             x-transition:enter="transition ease-out duration-200"
                             x-transition:enter-start="opacity-0 translate-y-2"
                             x-transition:enter-end="opacity-100 translate-y-0"
                             x-transition:leave="transition ease-in duration-150"
                             x-transition:leave-start="opacity-100 translate-y-0"
                             x-transition:leave-end="opacity-0 translate-y-2"
                             class="absolute right-0 mt-2 w-56 p-2 rounded-xl bg-nav-bg border border-nav-border shadow-2xl z-50">
                            <div class="flex flex-col gap-1">
                                <div class="px-3 py-2 border-b border-nav-border mb-1">
                                    <span class="text-[10px] font-black text-text-muted uppercase tracking-widest">@Localizer["AdminSettings"]</span>
                                </div>
                                <a asp-controller="Admin" asp-action="EditProfile" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-bold text-nav-link hover:bg-nav-accent hover:text-brand-primary transition-all group/item">
                                    <div class="flex items-center gap-3">
                                        <i class="fa-solid fa-user-gear text-sm opacity-60 group-hover/item:opacity-100"></i>
                                        <span>@Localizer["EditProfile"]</span>
                                    </div>
                                    <span class="text-[10px] font-black px-1.5 py-0.5 rounded bg-brand-primary/10 text-brand-primary/70 uppercase">IAM</span>
                                </a>
                                <a asp-controller="Admin" asp-action="ManageUsers" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-bold text-nav-link hover:bg-nav-accent hover:text-brand-primary transition-all group/item">
                                    <div class="flex items-center gap-3">
                                        <i class="fa-solid fa-users-gear text-sm opacity-60 group-hover/item:opacity-100"></i>
                                        <span>@Localizer["UserManagement"]</span>
                                    </div>
                                    <span class="text-[10px] font-black px-1.5 py-0.5 rounded bg-brand-primary/10 text-brand-primary/70 uppercase">RBAC</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }

                <!-- User Profile / Logout -->
                <div class="flex items-center gap-4">
                    <div class="hidden md:flex flex-col items-end">
                        <span class="text-[9px] font-black text-text-muted uppercase tracking-widest leading-none mb-1">@Localizer["SignedInAs"]</span>
                        <span class="text-xs font-bold text-dark-text-secondary">@User.Identity?.Name</span>
                    </div>
                    
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        <button type="submit" class="w-9 h-9 flex items-center justify-center rounded-lg bg-nav-surface border border-nav-border text-nav-link hover:text-danger-primary hover:border-danger-primary/50 transition-all group" 
                                title='@Localizer["Logout"]' aria-label='@Localizer["Logout"]'>
                            <i aria-hidden="true" class="fa-solid fa-power-off text-sm group-hover:rotate-12"></i>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="flex items-center gap-4">
                    <a asp-controller="Account" asp-action="Register" class="text-sm font-bold text-nav-link hover:text-nav-link-hover transition-colors">
                        @Localizer["Register"]
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="px-5 py-2 rounded-lg bg-surface-bright text-text-main text-sm font-black hover:bg-surface-soft transition-all shadow-lg shadow-surface-bright/5 hover:-translate-y-0.5">
                        @Localizer["Login"]
                    </a>
                </div>
            }
        </div>
    </nav>
</header>
