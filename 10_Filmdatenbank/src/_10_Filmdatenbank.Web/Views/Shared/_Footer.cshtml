@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
<footer class="bg-surface-bright dark:bg-dark-surface border-t border-border-default dark:border-dark-border py-12 mt-20 transition-colors duration-300">
    <div class="mx-auto max-w-screen-2xl px-6 lg:px-8">
        <div class="grid-standard gap-12 items-center mb-8">
            <div class="flex items-center justify-center md:justify-start gap-3">
                <div class="flex-center w-8 h-8 rounded bg-brand-soft shadow-sm border border-brand-border" aria-hidden="true">
                    <i aria-hidden="true" class="fa-solid fa-clapperboard text-brand-primary text-sm"></i>
                </div>
                <span class="text-lg font-bold tracking-tight text-text-main dark:text-white">FILM<span class="text-brand-primary">DB</span></span>
            </div>
            
            <div class="flex flex-col items-center gap-6">
                <!-- Dark Mode Toggle -->
                <div class="flex items-center p-1 bg-surface-muted dark:bg-dark-surface-soft rounded-lg border border-border-default dark:border-dark-border shadow-inner" role="radiogroup" aria-label='@Localizer["DesignSelection"]'>
                    <label class="cursor-pointer relative flex-center w-9 h-9 rounded-md text-text-muted dark:text-dark-text-muted hover:text-brand-primary has-[:checked]:bg-surface-bright has-[:checked]:dark:bg-dark-surface-soft/80 has-[:checked]:text-brand-primary has-[:checked]:shadow-sm transition-all text-sm group">
                        <input type="radio" name="theme-toggle" value="light" class="sr-only" aria-label='@Localizer["LightDesign"]'>
                        <i aria-hidden="true" class="fa-solid fa-sun group-has-[:checked]:fa-beat-fade transition-all"></i>
                    </label>
                    <label class="cursor-pointer relative flex-center w-9 h-9 rounded-md text-text-muted dark:text-dark-text-muted hover:text-brand-primary has-[:checked]:bg-surface-bright has-[:checked]:dark:bg-dark-surface-soft/80 has-[:checked]:text-brand-primary has-[:checked]:shadow-sm transition-all text-sm group">
                        <input type="radio" name="theme-toggle" value="system" class="sr-only" aria-label='@Localizer["SystemDesign"]'>
                        <i aria-hidden="true" class="fa-solid fa-desktop group-has-[:checked]:fa-beat-fade transition-all"></i>
                    </label>
                    <label class="cursor-pointer relative flex-center w-9 h-9 rounded-md text-text-muted dark:text-dark-text-muted hover:text-brand-primary has-[:checked]:bg-surface-bright has-[:checked]:dark:bg-dark-surface-soft has-[:checked]:text-brand-primary has-[:checked]:shadow-sm transition-all text-sm group">
                        <input type="radio" name="theme-toggle" value="dark" class="sr-only" aria-label='@Localizer["DarkDesign"]'>
                        <i aria-hidden="true" class="fa-solid fa-moon group-has-[:checked]:fa-beat-fade transition-all"></i>
                    </label>
                </div>

                <!-- Language Selector -->
                <div class="flex flex-wrap items-center justify-center gap-2">
                    @foreach (var culture in new[] { ("de", "DE"), ("en", "EN"), ("pt", "PT"), ("ru", "RU"), ("ar", "AR"), ("tr", "TR") })
                    {
                        <form asp-controller="Home" asp-action="SetLanguage" asp-route-culture="@culture.Item1" asp-route-returnUrl="@Context.Request.Path" method="post" class="inline">
                            <button type="submit" 
                                    class='px-2 py-1 text-[10px] font-black rounded border transition-all @(System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith(culture.Item1) ? "bg-brand-primary text-white border-brand-primary shadow-lg shadow-brand-primary/20" : "bg-surface-muted/50 dark:bg-dark-surface text-text-muted border-border-default dark:border-dark-border hover:border-brand-primary hover:text-brand-primary")'>
                                @culture.Item2
                            </button>
                        </form>
                    }
                </div>
            </div>
            
            <div class="flex justify-center md:justify-end gap-3">
                <a href="https://github.com/T-Boyke/C-Sharp-ASP-Fundamentals/tree/main/10_Filmdatenbank" target="_blank" class="btn-secondary px-4 py-2 border border-border-default dark:border-dark-border !text-sm" aria-label='@Localizer["Repository"] Github'>
                    <i aria-hidden="true" class="fa-brands fa-github text-lg mr-2"></i> @Localizer["Repository"]
                </a>
            </div>
        </div>
        
        <div class="border-t border-border-muted dark:border-dark-border pt-8 flex flex-col items-center justify-center gap-2">
            <p class="text-sm text-text-muted dark:text-dark-text-muted font-medium text-center">
                @Localizer["CodedBy"] <span class="font-bold text-text-main dark:text-dark-text-secondary">Tobias Boyke</span> @Localizer["WithMug"] <i aria-hidden="true" class="fa-solid fa-mug-hot text-amber-600 fa-flip-horizontal fa-bounce mx-1" style="--fa-animation-duration: 3s;"></i>
            </p>
            <p class="text-xs text-text-muted/80 dark:text-dark-text-muted flex items-center text-center">
                @Localizer["MadeWith"] <i aria-hidden="true" class="fa-solid fa-heart text-danger-primary fa-beat mx-1" style="--fa-animation-duration: 2s;"></i> @Localizer["ForExcellence"]
            </p>
            
            <div class="mt-4 flex gap-6 text-xs text-text-muted dark:text-dark-text-muted">
                <a asp-controller="Home" asp-action="Impressum" class="hover:text-brand-primary transition-colors">@Localizer["Impressum"]</a>
                <a asp-controller="Home" asp-action="Privacy" class="hover:text-brand-primary transition-colors">@Localizer["Privacy"]</a>
            </div>
        </div>
    </div>
</footer>
