@model _10_Filmdatenbank.Domain.Entities.Collection
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Model.Name;
}

<div class="mx-auto max-w-7xl px-6 lg:px-8 py-16">
    <nav class="flex mb-8 items-center gap-4 text-sm font-bold text-text-muted uppercase tracking-widest">
        <a asp-action="Index" class="nav-link">
            <i class="fa-solid fa-arrow-left"></i> @Localizer["BackToCollections"]
        </a>
        <span class="h-1 w-1 rounded-full bg-border-default"></span>
    </nav>

    <div class="relative w-full h-[500px] rounded-3xl overflow-hidden mb-12 shadow-2xl transition-all group">
        @if (!string.IsNullOrEmpty(Model.BackdropUrl))
        {
            <img src="@Model.BackdropUrl" alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
        }
        else
        {
            <div class="w-full h-full bg-dark-surface-soft"></div>
        }
        <div class="absolute inset-0 bg-linear-to-t from-dark-surface via-dark-surface/60 to-transparent"></div>
        
        <div class="absolute bottom-12 left-12 right-12 flex flex-col md:flex-row gap-12 items-end">
            @if (!string.IsNullOrEmpty(Model.PosterUrl))
            {
                <div class="hidden md:block w-48 shrink-0 rounded-2xl overflow-hidden shadow-2xl border-4 border-glass-border transition-transform hover:scale-105">
                    <img src="@Model.PosterUrl" alt="@Model.Name Poster" class="w-full h-full object-cover" />
                </div>
            }
            <div class="flex-grow">
                <h1 class="text-4xl md:text-6xl font-black text-white tracking-tighter drop-shadow-2xl">@Model.Name</h1>
                @if (!string.IsNullOrEmpty(Model.Overview))
                {
                    <p class="mt-6 text-lg text-text-white-bright font-medium leading-relaxed drop-shadow-lg max-w-3xl line-clamp-3">@Model.Overview</p>
                }
                <div class="mt-6 flex flex-wrap gap-4">
                    @if (Model.TmdbId > 0)
                    {
                        <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-glass-bg-hover backdrop-blur-md border border-white-a20 text-[10px] font-black text-white uppercase tracking-widest leading-none">
                            <i class="fa-solid fa-database"></i> TMDB #@Model.TmdbId
                        </div>
                    }
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-glass-bg-hover backdrop-blur-md border border-white-a20 text-[10px] font-black text-white uppercase tracking-widest leading-none">
                        <i class="fa-solid fa-film"></i> @Model.Films.Count @Localizer["Films"]
                    </div>
                </div>
            </div>
            
            @if (User.IsInRole("Admin"))
            {
                <div class="shrink-0 mb-2">
                    <a asp-action="Edit" asp-route-id="@Model.CollectionID" class="btn-primary">@Localizer["Edit"]</a>
                </div>
            }
        </div>
    </div>

    <!-- Mastery Tracking Board -->
    <section class="mb-16">
        @{
            var totalParts = (int)(ViewData["TotalParts"] ?? Model.Films.Count);
            var ownedParts = Model.Films.Count;
            var completionPercentage = totalParts > 0 ? (double)ownedParts / totalParts * 100 : 0;
            
            var sortedFilms = Model.Films.OrderBy(f => f.Erscheinungsjahr).ToList();
            var cumulativeBudget = sortedFilms.Sum(f => f.Budget ?? 0);
            var cumulativeRevenue = sortedFilms.Sum(f => f.Revenue ?? 0);
            var totalProfit = cumulativeRevenue - cumulativeBudget;
            var avgRating = sortedFilms.Any() ? sortedFilms.Average(f => f.VoteAverage ?? 0) : 0;
        }

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="glass-premium p-6 rounded-2xl border border-glass-border">
                <p class="text-[10px] font-black text-brand-primary uppercase tracking-widest mb-2">@Localizer["CollectionCompletion"]</p>
                <div class="flex items-end justify-between mb-2">
                    <span class="text-3xl font-black text-text-main dark:text-white">@ownedParts <span class="text-sm font-bold text-text-muted">/ @totalParts</span></span>
                    <span class="text-xs font-black text-brand-primary">@completionPercentage.ToString("0")%</span>
                </div>
                <div class="w-full h-1.5 bg-glass-bg rounded-full overflow-hidden border border-glass-border">
                    <div class="h-full bg-brand-primary" style="width: @completionPercentage%"></div>
                </div>
            </div>

            <div class="glass-premium p-6 rounded-2xl border border-glass-border">
                <p class="text-[10px] font-black text-text-muted uppercase tracking-widest mb-2">@Localizer["CumulativeRevenue"]</p>
                <p class="text-2xl font-black text-text-main dark:text-white">$@cumulativeRevenue.ToString("N0")</p>
                <p class="text-[10px] font-bold text-text-muted mt-1 uppercase">@Localizer["SeriesTotal"]</p>
            </div>

            <div class="glass-premium p-6 rounded-2xl border border-glass-border">
                <p class="text-[10px] font-black text-text-muted uppercase tracking-widest mb-2">@Localizer["FinancialEfficiency"]</p>
                @{
                    var roi = cumulativeBudget > 0 ? (double)totalProfit / cumulativeBudget * 100 : 0;
                }
                <div class="flex items-center gap-2">
                    <p class="text-2xl font-black @(totalProfit >= 0 ? "text-green-500" : "text-red-500")">@roi.ToString("N1")%</p>
                    <span class="text-[10px] font-black uppercase text-text-muted">ROI</span>
                </div>
                <p class="text-[10px] font-bold text-text-muted mt-1 uppercase">@Localizer["ProfitMargin"]</p>
            </div>

            <div class="glass-premium p-6 rounded-2xl border border-glass-border">
                <p class="text-[10px] font-black text-text-muted uppercase tracking-widest mb-2">@Localizer["SeriesAvgRating"]</p>
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-star text-star-primary"></i>
                    <p class="text-2xl font-black text-text-main dark:text-white">@avgRating.ToString("0.0")</p>
                </div>
                <p class="text-[10px] font-bold text-text-muted mt-1 uppercase">@Localizer["BasedOnLocalData"]</p>
            </div>
        </div>
    </section>

    <!-- Visual Timeline & Deep Insights -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-12">
        <!-- LEFT: Timeline -->
        <div class="xl:col-span-2 space-y-12">
            <div class="form-group-header !mb-0">
                <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["Timeline"]</h2>
                <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
            </div>

            <div class="relative pl-12 border-l-2 border-border-muted dark:border-dark-border space-y-12">
                @foreach (var film in sortedFilms)
                {
                    <div class="relative group">
                        <!-- Dot -->
                        <div class="absolute -left-[57px] top-6 w-10 h-10 rounded-full bg-surface-subtle dark:bg-dark-surface-soft border-4 border-white dark:border-dark-surface flex items-center justify-center text-brand-primary shadow-xl transition-all group-hover:bg-brand-primary group-hover:text-white">
                            <i class="fa-solid fa-film text-xs"></i>
                        </div>
                        
                        <div class="glass-premium p-8 rounded-3xl border border-glass-border flex flex-col md:flex-row gap-8 transition-all hover:translate-x-2">
                            <div class="w-32 shrink-0 aspect-[2/3] rounded-xl overflow-hidden shadow-lg">
                                <img src="@film.PosterUrl" alt="" class="w-full h-full object-cover" />
                            </div>
                            <div class="flex-grow min-w-0">
                                    <div class="flex items-center gap-3">
                                        <!-- Score Matrix -->
                                        <div class="flex items-center gap-3 px-3 py-1.5 rounded-xl bg-surface-bright/5 border border-white/5">
                                            @if (film.VoteAverage.HasValue)
                                            {
                                                <div class="flex items-center gap-1.5" title="TMDB Score">
                                                    <img src="/images/logos/tmdb.svg" class="h-2 w-auto" alt="TMDB" />
                                                    <span class="text-xs font-black text-white">@film.VoteAverage.Value.ToString("0.0")</span>
                                                </div>
                                            }
                                            @if (film.ImdbRating.HasValue)
                                            {
                                                <div class="flex items-center gap-1.5" title="IMDb Rating">
                                                    <img src="/images/logos/imdb.svg" class="h-2 w-auto" alt="IMDb" />
                                                    <span class="text-xs font-black text-white">@film.ImdbRating.Value.ToString("0.0")</span>
                                                </div>
                                            }
                                            @if (film.MetacriticRating.HasValue)
                                            {
                                                <div class="flex items-center gap-1.5" title="Metascore">
                                                    <img src="/images/logos/metacritic.svg" class="h-2 w-auto" alt="Metacritic" />
                                                    <span class="text-xs font-black @(film.MetacriticRating >= 61 ? "text-[#6c3]" : (film.MetacriticRating >= 40 ? "text-[#fc3]" : "text-[#f33]"))">@film.MetacriticRating</span>
                                                </div>
                                            }
                                            @if (film.TvdbRating.HasValue && film.TvdbRating > 0)
                                            {
                                                <div class="flex items-center gap-1.5" title="TVDB Score">
                                                    <img src="/images/logos/tvdb.svg" class="h-2 w-auto opacity-80" alt="TVDB" />
                                                    <span class="text-xs font-black text-white">@film.TvdbRating.Value.ToString("0.0")</span>
                                                </div>
                                            }
                                            @if (film.RottenTomatoesCriticRating.HasValue)
                                            {
                                                <div class="flex items-center gap-1.5" title="Tomatometer">
                                                    <img src="@(film.RottenTomatoesCriticRating >= 60 ? "/images/logos/rt.svg" : "/images/logos/rt_tomato_splat.svg")" class="h-2 w-auto" alt="RT" />
                                                    <span class="text-xs font-black text-white">@film.RottenTomatoesCriticRating%</span>
                                                </div>
                                            }
                                            @if (film.RottenTomatoesAudienceRating.HasValue)
                                            {
                                                <div class="flex items-center gap-1.5" title="RT Audience">
                                                    <img src="@(film.RottenTomatoesAudienceRating >= 60 ? "/images/logos/rt_popcorn_fresh.svg" : "/images/logos/rt_popcorn_splat.svg")" class="h-2 w-auto" alt="RT Audience" />
                                                    <span class="text-xs font-black text-white">@film.RottenTomatoesAudienceRating%</span>
                                                </div>
                                            }
                                        </div>
                                        <span class="text-sm font-black text-brand-primary uppercase tracking-widest">@film.Erscheinungsjahr</span>
                                    </div>
                                <h3 class="text-2xl font-black text-text-main dark:text-white mb-4">@film.Titel</h3>
                                <p class="text-sm text-text-description dark:text-dark-text-muted leading-relaxed line-clamp-3 mb-6">@film.Handlung</p>
                                
                                <div class="flex flex-wrap gap-4 pt-6 border-t border-border-muted dark:border-dark-border">
                                    <div class="flex flex-col">
                                        <span class="text-[9px] font-black text-text-muted uppercase tracking-tighter">Budget</span>
                                        <span class="text-xs font-bold text-text-main dark:text-white">@(film.Budget > 0 ? $"${film.Budget?.ToString("N0")}" : "N/A")</span>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-[9px] font-black text-text-muted uppercase tracking-tighter">Revenue</span>
                                        <span class="text-xs font-bold text-text-main dark:text-white">@(film.Revenue > 0 ? $"${film.Revenue?.ToString("N0")}" : "N/A")</span>
                                    </div>
                                    <div class="flex-grow"></div>
                                    <a asp-controller="Film" asp-action="Details" asp-route-id="@film.FilmID" class="btn-secondary !py-2 !px-4 !text-[10px]">
                                        @Localizer["Details"]
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: Financial Analytics & Stats -->
        <div class="space-y-12">
            <div class="form-group-header !mb-0">
                <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["FinancialAnalytics"]</h2>
                <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
            </div>

            <div class="glass-premium p-8 rounded-3xl border border-glass-border space-y-8">
                @foreach (var film in sortedFilms)
                {
                    <div class="space-y-3">
                        <div class="flex items-center justify-between text-[10px] font-black uppercase tracking-widest">
                            <span class="text-text-main dark:text-white truncate max-w-[150px]">@film.Titel</span>
                            @if (film.Budget > 0 && film.Revenue > 0)
                            {
                                var margin = (double)(film.Revenue - film.Budget) / film.Revenue * 100;
                                <span class="@(margin >= 0 ? "text-green-500" : "text-red-500")">@((margin ?? 0).ToString("0"))% Profit</span>
                            }
                        </div>
                        
                        <div class="relative h-4 bg-surface-subtle dark:bg-dark-surface-soft rounded-full overflow-hidden flex shadow-inner">
                            @{
                                var maxVal = sortedFilms.Max(f => Math.Max(f.Budget ?? 0, f.Revenue ?? 0));
                                var bPct = maxVal > 0 ? (double)(film.Budget ?? 0) / maxVal * 100 : 0;
                                var rPct = maxVal > 0 ? (double)(film.Revenue ?? 0) / maxVal * 100 : 0;
                            }
                            <!-- Budget Bar -->
                            <div class="absolute inset-y-0 left-0 bg-brand-primary/20 border-r border-brand-primary/30" style="width: @bPct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            <!-- Revenue Bar -->
                            <div class="absolute inset-y-1.5 left-0 bg-brand-primary rounded-full mt-1.5 mx-1" style="height: 4px; width: calc(@rPct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)% - 8px)"></div>
                        </div>
                        <div class="flex justify-between text-[11px] font-black text-text-muted mt-1 uppercase tracking-tighter">
                            <span>B: <span class="text-text-main dark:text-white">@(film.Budget > 0 ? $"${(film.Budget / 1000000.0)?.ToString("0.0")}M" : "0")</span></span>
                            <span>R: <span class="text-text-main dark:text-white">@(film.Revenue > 0 ? $"${(film.Revenue / 1000000.0)?.ToString("0.0")}M" : "0")</span></span>
                        </div>
                    </div>
                }

                <div class="pt-8 border-t border-border-muted dark:border-dark-border">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-brand-primary/10 flex items-center justify-center text-brand-primary text-xl">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                        <div>
                            <p class="text-[10px] font-black text-text-muted uppercase">Total Net Profit</p>
                            <p class="text-xl font-black text-text-main dark:text-white">@((totalProfit / 1000000.0).ToString("N1")) M</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Insights / Summary -->
            <div class="form-group-header !mb-0">
                <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["CollectionInsights"]</h2>
                <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
            </div>

            <div class="glass-premium p-8 rounded-3xl border border-glass-border space-y-6">
                @{
                    var highestRated = sortedFilms.OrderByDescending(f => f.VoteAverage).FirstOrDefault();
                    var mostProfitable = sortedFilms.OrderByDescending(f => (f.Revenue ?? 0) - (f.Budget ?? 0)).FirstOrDefault();
                    var earliest = sortedFilms.FirstOrDefault();
                    var latest = sortedFilms.LastOrDefault();
                }

                @if (highestRated != null)
                {
                    <div class="flex items-start gap-4">
                        <div class="mt-1 w-2 h-2 rounded-full bg-brand-primary"></div>
                        <div>
                            <p class="text-[10px] font-black text-text-muted uppercase">Critic's Choice</p>
                             <p class="text-sm font-bold text-text-main dark:text-white">@highestRated.Titel (@(highestRated.VoteAverage?.ToString("0.0") ?? "N/A"))</p>
                        </div>
                    </div>
                }

                @if (mostProfitable != null && mostProfitable.Revenue > 0)
                {
                    <div class="flex items-start gap-4">
                        <div class="mt-1 w-2 h-2 rounded-full bg-green-500"></div>
                        <div>
                            <p class="text-[10px] font-black text-text-muted uppercase">Box Office King</p>
                            <p class="text-sm font-bold text-text-main dark:text-white">@mostProfitable.Titel ($@((mostProfitable.Revenue / 1000000.0)?.ToString("N0"))M)</p>
                        </div>
                    </div>
                }

                <div class="flex items-start gap-4">
                    <div class="mt-1 w-2 h-2 rounded-full bg-surface-muted"></div>
                    <div>
                        <p class="text-[10px] font-black text-text-muted uppercase">Series Lifespan</p>
                        <p class="text-sm font-bold text-text-main dark:text-white">@((latest?.Erscheinungsjahr ?? 0) - (earliest?.Erscheinungsjahr ?? 0)) Years (@earliest?.Erscheinungsjahr - @latest?.Erscheinungsjahr)</p>
                    </div>
                </div>

                @if (completionPercentage >= 100)
                {
                    <div class="mt-8 p-6 rounded-2xl bg-brand-primary/5 border border-brand-primary/20 flex flex-col items-center text-center">
                        <i class="fa-solid fa-crown text-3xl text-brand-primary mb-4 drop-shadow-glow"></i>
                        <p class="text-[10px] font-black text-brand-primary uppercase tracking-[0.2em]">Mastery Achieved</p>
                        <p class="text-xs font-bold text-text-main dark:text-white mt-2">You own the complete saga.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
</div>
