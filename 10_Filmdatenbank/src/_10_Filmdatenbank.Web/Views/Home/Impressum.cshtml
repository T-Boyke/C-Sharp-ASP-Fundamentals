@{
    ViewData["Title"] = "Impressum";
}

<div class="mx-auto max-w-4xl px-6 lg:px-8 py-20">
    <div class="text-center mb-16">
        <h1 class="text-4xl font-black tracking-tight text-text-main dark:text-white sm:text-6xl transition-colors">Impressum</h1>
        <p class="mt-4 text-lg text-text-muted dark:text-dark-text-muted font-medium transition-colors">Gesetzliche Anbieterkennung</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="bg-surface-bright/50 dark:bg-dark-surface/50 p-8 rounded-2xl border border-border-default dark:border-dark-border shadow-sm transition-colors backdrop-blur-sm">
            <h2 class="text-xl font-bold text-text-main dark:text-white mb-6 flex items-center gap-3 transition-colors">
                            <i aria-hidden="true" class="fa-solid fa-user-tie text-brand-primary"></i>
                Angaben gemäß § 5 TMG
            </h2>
            <div class="space-y-4 text-text-description dark:text-dark-text-muted leading-relaxed transition-colors">
                <p>
                    <span class="block font-bold text-text-main dark:text-white">Tobias Boyke</span>
                    Musterstraße 123<br>
                    12345 Musterstadt
                </p>
                <p>
                    <span class="block font-bold text-text-main dark:text-white">Kontakt</span>
                    Telefon: +49 (0) 123 456789<br>
                    E-Mail: tobias.boyke@example.de
                </p>
            </div>
        </div>

        <div class="bg-surface-bright/50 dark:bg-dark-surface/50 p-8 rounded-2xl border border-border-default dark:border-dark-border shadow-sm transition-colors backdrop-blur-sm">
            <h2 class="text-xl font-bold text-text-main dark:text-white mb-6 flex items-center gap-3 transition-colors">
                            <i aria-hidden="true" class="fa-solid fa-scale-balanced text-brand-primary"></i>
                Haftungsausschluss
            </h2>
            <div class="space-y-6 text-sm text-text-description dark:text-dark-text-muted leading-relaxed transition-colors">
                <p>
                    Die Inhalte unserer Seiten wurden mit größter Sorgfalt erstellt. Für die Richtigkeit, Vollständigkeit und Aktualität der Inhalte können wir jedoch keine Gewähr übernehmen.
                </p>
                <p>
                    Unser Angebot enthält Links zu externen Webseiten Dritter, auf deren Inhalte wir keinen Einfluss haben. Deshalb können wir für diese fremden Inhalte auch keine Gewähr übernehmen.
                </p>
            </div>
        </div>
    </div>

    <div class="mt-12 p-8 bg-surface-muted/50 dark:bg-dark-surface-soft/40 rounded-2xl border border-border-muted dark:border-dark-border text-center transition-colors backdrop-blur-sm">
        <p class="text-xs font-medium text-text-muted dark:text-dark-text-muted transition-colors">
            Dieses Projekt wurde im Rahmen der IHK-Weiterbildung NE4 Excellence erstellt.<br>
            Alle Daten sind rein fiktiv und dienen zu Demonstrationszwecken.
        </p>
