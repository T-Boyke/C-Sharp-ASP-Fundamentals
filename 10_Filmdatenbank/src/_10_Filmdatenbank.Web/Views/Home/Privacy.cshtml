@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PrivacyTitle"];
}

<div class="py-24 px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl font-extrabold tracking-tight text-text-main dark:text-white mb-8 border-l-4 border-brand-primary pl-6 uppercase">
            @Localizer["PrivacyHeaderPrefix"]<span class="text-brand-primary">@Localizer["PrivacyHeaderHighlight"]</span>
        </h1>
        
        <div class="prose prose-slate dark:prose-invert max-w-none space-y-8 text-text-description dark:text-dark-text-muted">
            <section class="accent-border bg-white/50 dark:bg-dark-surface/50 p-8 rounded-xl shadow-sm border border-border-default dark:border-dark-border transition-all backdrop-blur-sm">
                <h2 class="text-xl font-bold text-text-main dark:text-white mb-4 flex items-center gap-3">
                    <i aria-hidden="true" class="fa-solid fa-shield-halved text-brand-primary"></i>
                    @Localizer["GeneralInfoTitle"]
                </h2>
                <p>
                    @Localizer["GeneralInfoText"]
                </p>
            </section>

            <section class="accent-border bg-white/50 dark:bg-dark-surface/50 p-8 rounded-xl shadow-sm border border-border-default dark:border-dark-border transition-all backdrop-blur-sm">
                <h2 class="text-xl font-bold text-text-main dark:text-white mb-4 flex items-center gap-3">
                    <i aria-hidden="true" class="fa-solid fa-server text-brand-primary"></i>
                    @Localizer["LocalProcessingTitle"]
                </h2>
                <p>
                    @Localizer["LocalProcessingIntro"]
                </p>
                <ul class="list-disc pl-6 space-y-2 mt-4">
                    <li>@Localizer["LocalProcessingItem1"]</li>
                    <li>@Localizer["LocalProcessingItem2"]</li>
                    <li>@Localizer["LocalProcessingItem3"]</li>
                </ul>
                <p class="mt-4 italic text-sm text-text-muted dark:text-dark-text-muted transition-colors">
                    @Localizer["LocalProcessingFooter"]
                </p>
            </section>

            <section class="accent-border bg-white/50 dark:bg-dark-surface/50 p-8 rounded-xl shadow-sm border border-border-default dark:border-dark-border transition-all backdrop-blur-sm">
                <h2 class="text-xl font-bold text-text-main dark:text-white mb-4 flex items-center gap-3">
                    <i aria-hidden="true" class="fa-solid fa-database text-brand-primary"></i>
                    @Localizer["DataStorageTitle"]
                </h2>
                <p>
                    @Localizer["DataStorageText"]
                </p>
            </section>
        </div>

        <div class="mt-16 flex items-center justify-center">
            <a asp-controller="Home" asp-action="Index" class="btn-primary">
                <i aria-hidden="true" class="fa-solid fa-arrow-left mr-2"></i>
                @Localizer["BackToHome"]
            </a>
        </div>
    </div>
</div>
