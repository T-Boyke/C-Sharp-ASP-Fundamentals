@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["HomeTitle"];
}

<div class="bg-transparent transition-colors duration-300">
    <!-- Hero Section -->
    <div class="hero-container relative isolate overflow-hidden">
        <div class="mx-auto max-w-screen-2xl px-6 pt-10 pb-24 sm:pb-32 lg:flex lg:px-8 lg:py-40">
            <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-2xl lg:flex-shrink-0 lg:pt-8 flex-stack">
                <div>
                     <span class="badge-premium px-3 py-1">Version 4.2 Release</span>
                </div>
                <h1 class="mt-10 text-4xl font-extrabold tracking-tight text-text-main dark:text-white sm:text-7xl text-balance">
                    @Localizer["HeroTitlePrefix"] <span class="text-brand-primary">@Localizer["HeroTitleHighlight"]</span>
                </h1>
                <p class="mt-6 text-xl leading-9 text-text-description dark:text-dark-text-muted text-pretty">
                    @Localizer["HeroDescription"]
                </p>
                <div class="mt-12 flex-wrap-gap">
                    <a asp-controller="Film" asp-action="Index" class="btn-primary scale-110 origin-left">
                        <i aria-hidden="true" class="fa-solid fa-play mr-2"></i> @Localizer["GetStarted"]
                    </a>
                    <a href="#features" class="btn-secondary px-6 py-2.5 rounded-lg border border-border-default dark:border-dark-border font-bold hover:bg-surface-soft dark:hover:bg-dark-surface-soft transition-all shadow-sm">
                        <i aria-hidden="true" class="fa-solid fa-circle-info mr-2"></i> @Localizer["LearnMore"]
                    </a>
                </div>

                <!-- Testimonials Section -->
                <div class="mt-20 space-y-8">
                    <div class="flex items-center gap-4">
                        <div class="h-px bg-brand-primary/20 flex-grow"></div>
                        <span class="text-[10px] font-black uppercase tracking-[0.3em] text-brand-primary">Was unsere Nutzer sagen</span>
                        <div class="h-px bg-brand-primary/20 flex-grow"></div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="card-glass p-6 border-l-4 border-l-brand-primary">
                            <div class="flex gap-1 text-brand-primary mb-3">
                                <i class="fa-solid fa-star text-[10px]"></i>
                                <i class="fa-solid fa-star text-[10px]"></i>
                                <i class="fa-solid fa-star text-[10px]"></i>
                                <i class="fa-solid fa-star text-[10px]"></i>
                                <i class="fa-solid fa-star text-[10px]"></i>
                            </div>
                            <p class="text-sm font-medium text-white italic leading-relaxed">"Endlich eine Filmdatenbank, die nicht nur funktional ist, sondern auch fantastisch aussieht. Die Community-Features sind unschlagbar!"</p>
                            <div class="mt-4 flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-brand-primary/20 flex items-center justify-center text-[10px] font-black text-brand-primary">JD</div>
                                <div>
                                    <p class="text-xs font-bold text-white leading-none">Jonas D.</p>
                                    <p class="text-[9px] text-text-muted leading-none mt-1">Cineast & Beta Tester</p>
                                </div>
                            </div>
                        </div>

                        <div class="card-glass p-6 border-l-4 border-l-brand-primary">
                            <div class="flex gap-1 text-brand-primary mb-3">
                                <i class="fa-solid fa-star text-[10px]"></i>
                                <i class="fa-solid fa-star text-[10px]"></i>
                                <i class="fa-solid fa-star text-[10px]"></i>
                                <i class="fa-solid fa-star text-[10px]"></i>
                                <i class="fa-solid fa-star text-[10px]"></i>
                            </div>
                            <p class="text-sm font-medium text-white italic leading-relaxed">"Die TMDB Integration spart so viel Zeit. Ich kann meine Sammlung jetzt mühelos verwalten und mit meinen Freunden teilen."</p>
                            <div class="mt-4 flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-brand-primary/20 flex items-center justify-center text-[10px] font-black text-brand-primary">ML</div>
                                <div>
                                    <p class="text-xs font-bold text-white leading-none">Maria L.</p>
                                    <p class="text-[9px] text-text-muted leading-none mt-1">Film-Sammlerin</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Feature Grid Side -->
            <div class="mx-auto mt-16 flex max-w-2xl sm:mt-24 lg:ml-10 lg:mr-0 lg:mt-0 lg:max-w-none lg:flex-1 xl:ml-32" id="features">
                <div class="w-full">
                    <div class="grid grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-8">
                        <div class="card-glass p-8 group aspect-[4/3] flex flex-col justify-center items-center text-center transition-all duration-500 hover:-translate-y-2">
                            <i aria-hidden="true" class="fa-solid fa-layer-group text-2xl text-brand-primary mb-3"></i>
                            <h3 class="font-bold text-text-main dark:text-white">@Localizer["Feature1Title"]</h3>
                            <p class="text-xs text-text-muted dark:text-dark-text-muted leading-relaxed mt-1">@Localizer["Feature1Desc"]</p>
                        </div>
                        <div class="card-glass p-8 group aspect-[4/3] flex flex-col justify-center items-center text-center transition-all duration-500 hover:-translate-y-2">
                            <i aria-hidden="true" class="fa-solid fa-box-open text-2xl text-brand-primary mb-3"></i>
                            <h3 class="font-bold text-text-main dark:text-white">@Localizer["Feature2Title"]</h3>
                            <p class="text-xs text-text-muted dark:text-dark-text-muted leading-relaxed mt-1">@Localizer["Feature2Desc"]</p>
                        </div>
                        <div class="card-glass p-8 group aspect-[4/3] flex flex-col justify-center items-center text-center transition-all duration-500 hover:-translate-y-2">
                            <i aria-hidden="true" class="fa-solid fa-shield-halved text-2xl text-brand-primary mb-3"></i>
                            <h3 class="font-bold text-text-main dark:text-white">@Localizer["Feature3Title"]</h3>
                            <p class="text-xs text-text-muted dark:text-dark-text-muted leading-relaxed mt-1">@Localizer["Feature3Desc"]</p>
                        </div>
                        <div class="card-glass p-8 group aspect-[4/3] flex flex-col justify-center items-center text-center transition-all duration-500 hover:-translate-y-2">
                            <i aria-hidden="true" class="fa-solid fa-gauge-high text-2xl text-brand-primary mb-3"></i>
                            <h3 class="font-bold text-text-main dark:text-white">@Localizer["Feature4Title"]</h3>
                            <p class="text-xs text-text-muted dark:text-dark-text-muted leading-relaxed mt-1">@Localizer["Feature4Desc"]</p>
                        </div>
                        <div class="card-glass p-8 group aspect-[4/3] flex flex-col justify-center items-center text-center transition-all duration-500 hover:-translate-y-2">
                            <i aria-hidden="true" class="fa-solid fa-code text-2xl text-brand-primary mb-3"></i>
                            <h3 class="font-bold text-text-main dark:text-white">@Localizer["Feature5Title"]</h3>
                            <p class="text-xs text-text-muted dark:text-dark-text-muted leading-relaxed mt-1">@Localizer["Feature5Desc"]</p>
                        </div>
                        <div class="card-glass p-8 group aspect-[4/3] flex flex-col justify-center items-center text-center transition-all duration-500 hover:-translate-y-2">
                            <i aria-hidden="true" class="fa-solid fa-wand-magic-sparkles text-2xl text-brand-primary mb-3"></i>
                            <h3 class="font-bold text-text-main dark:text-white">@Localizer["Feature6Title"]</h3>
                            <p class="text-xs text-text-muted dark:text-dark-text-muted leading-relaxed mt-1">@Localizer["Feature6Desc"]</p>
                        </div>
                        <div class="card-glass p-8 group aspect-[4/3] flex flex-col justify-center items-center text-center transition-all duration-500 hover:-translate-y-2">
                            <i aria-hidden="true" class="fa-solid fa-mobile-screen-button text-2xl text-brand-primary mb-3"></i>
                            <h3 class="font-bold text-text-main dark:text-white">@Localizer["Feature7Title"]</h3>
                            <p class="text-xs text-text-muted dark:text-dark-text-muted leading-relaxed mt-1">@Localizer["Feature7Desc"]</p>
                        </div>
                        <div class="card-glass p-8 group aspect-[4/3] flex flex-col justify-center items-center text-center transition-all duration-500 hover:-translate-y-2">
                            <i aria-hidden="true" class="fa-solid fa-server text-2xl text-brand-primary mb-3"></i>
                            <h3 class="font-bold text-text-main dark:text-white">@Localizer["Feature8Title"]</h3>
                            <p class="text-xs text-text-muted dark:text-dark-text-muted leading-relaxed mt-1">@Localizer["Feature8Desc"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
