@{
    ViewData["Title"] = "Willkommen";
}

<div class="relative bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto">
        <div class="relative z-10 pb-8 bg-white sm:pb-16 md:pb-20 lg:max-w-2xl lg:w-full lg:pb-28 xl:pb-32">
            <main class="mt-10 mx-auto max-w-7xl px-4 sm:mt-12 sm:px-6 md:mt-16 lg:mt-20 lg:px-8 xl:mt-28">
                <div class="sm:text-center lg:text-left">
                    <h1 class="text-4xl tracking-tight font-extrabold text-slate-900 sm:text-5xl md:text-6xl">
                        <span class="block xl:inline">Professionelle</span>
                        <span class="block text-brand-primary xl:inline">Filmdatenverwaltung</span>
                    </h1>
                    <p class="mt-3 text-base text-slate-500 sm:mt-5 sm:text-lg sm:max-w-xl sm:mx-auto md:mt-5 md:text-xl lg:mx-0">
                        Verwalten Sie Ihre Filmkollektion mit System. Unsere Plattform bietet Ihnen alle Werkzeuge für eine strukturierte Datenbankpflege – effizient, sicher und modern.
                    </p>
                    <div class="mt-5 sm:mt-8 sm:flex sm:justify-center lg:justify-start gap-4">
                        <a asp-controller="Film" asp-action="Index" class="btn-primary">
                            <i class="fa-solid fa-play mr-2"></i> Jetzt starten
                        </a>
                        <a href="#" class="inline-flex items-center justify-center px-6 py-2.5 border border-slate-300 text-slate-700 font-bold rounded-lg bg-white hover:bg-slate-50 transition-all duration-200">
                            <i class="fa-solid fa-circle-info mr-2"></i> Mehr erfahren
                        </a>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <div class="lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2 bg-slate-100 flex items-center justify-center p-12">
        <div class="grid grid-cols-2 gap-6 w-full max-w-md">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 hover:border-brand-primary transition-colors">
                <i class="fa-solid fa-database text-3xl text-brand-primary mb-4"></i>
                <h3 class="font-bold text-slate-900">Echtdaten</h3>
                <p class="text-sm text-slate-500">Volle SQL Integration</p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 hover:border-brand-primary transition-colors">
                <i class="fa-solid fa-shield-halved text-3xl text-brand-primary mb-4"></i>
                <h3 class="font-bold text-slate-900">Sicher</h3>
                <p class="text-sm text-slate-500">Identity Framework</p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 hover:border-brand-primary transition-colors">
                <i class="fa-solid fa-bolt text-3xl text-brand-primary mb-4"></i>
                <h3 class="font-bold text-slate-900">Schnell</h3>
                <p class="text-sm text-slate-500">Optimierte Queries</p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 hover:border-brand-primary transition-colors">
                <i class="fa-solid fa-mobile-screen-button text-3xl text-brand-primary mb-4"></i>
                <h3 class="font-bold text-slate-900">Responsive</h3>
                <p class="text-sm text-slate-500">Tailwind CSS 4.2</p>
            </div>
        </div>
    </div>
</div>
