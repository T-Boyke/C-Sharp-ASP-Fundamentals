@using _10_Filmdatenbank.Domain.Entities
@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "User Management (RBAC)";
}

<div class="max-w-7xl mx-auto px-6 py-12">
    <div class="mb-12 flex items-center justify-between">
        <div>
            <h1 class="text-4xl font-extrabold text-white tracking-tight">
                User <span class="text-brand-primary">Management</span>
            </h1>
            <p class="mt-2 text-dark-text-muted">Role-Based Access Control (RBAC) overview.</p>
        </div>
        <div class="px-4 py-2 rounded-lg bg-brand-primary/10 border border-brand-primary/20">
            <span class="text-xs font-black text-brand-primary tracking-widest uppercase">RBAC System Active</span>
        </div>
    </div>

    <div class="card-glass overflow-hidden border border-nav-border">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-nav-surface border-b border-nav-border">
                        <th class="px-6 py-4 text-xs font-black text-text-muted uppercase tracking-widest">User / Registered</th>
                        <th class="px-6 py-4 text-xs font-black text-text-muted uppercase tracking-widest">Email / Name</th>
                        <th class="px-6 py-4 text-xs font-black text-text-muted uppercase tracking-widest">Status</th>
                        <th class="px-6 py-4 text-xs font-black text-text-muted uppercase tracking-widest text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-nav-border/50">
                    @foreach (var user in Model)
                    {
                        <tr class="hover:bg-nav-accent/30 transition-colors group">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-surface-bright flex items-center justify-center text-brand-primary font-bold border border-brand-primary/20 overflow-hidden">
                                        @if (user.ProfilePicture != null)
                                        {
                                            <img src="data:@user.ProfilePictureContentType;base64,@Convert.ToBase64String(user.ProfilePicture)" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            @(user.UserName?[0].ToString().ToUpper() ?? "?")
                                        }
                                    </div>
                                    <div>
                                        <span class="font-bold text-white block">@user.UserName</span>
                                        <span class="text-[10px] text-text-muted uppercase tracking-wider">Seit @user.CreatedAt.ToString("dd.MM.yyyy")</span>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm text-white font-medium block">@user.FirstName @user.LastName</span>
                                <span class="text-xs text-dark-text-muted">@user.Email</span>
                            </td>
                            <td class="px-6 py-4">
                                @if (user.IsDisabled)
                                {
                                    <span class="badge badge-error">Deaktiviert</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Aktiv</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="p-2 rounded-lg hover:bg-brand-primary/10 text-text-muted hover:text-brand-primary transition-all" title="Editieren">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <form asp-action="ToggleUserStatus" method="post" class="inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="p-2 rounded-lg hover:bg-danger-primary/10 text-text-muted hover:text-danger-primary transition-all" title="@(user.IsDisabled ? "Aktivieren" : "Deaktivieren")">
                                            @if (user.IsDisabled)
                                            {
                                                <i class="fa-solid fa-user-check"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-user-slash"></i>
                                            }
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
