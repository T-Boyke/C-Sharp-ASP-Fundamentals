@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityUser>
@{
    ViewData["Title"] = "User Management (RBAC)";
}

<div class="max-w-7xl mx-auto px-6 py-12">
    <div class="mb-12 flex items-center justify-between">
        <div>
            <h1 class="text-4xl font-extrabold text-white tracking-tight">
                User <span class="text-brand-primary">Management</span>
            </h1>
            <p class="mt-2 text-dark-text-muted">Role-Based Access Control (RBAC) overview.</p>
        </div>
        <div class="px-4 py-2 rounded-lg bg-brand-primary/10 border border-brand-primary/20">
            <span class="text-xs font-black text-brand-primary tracking-widest uppercase">RBAC System Active</span>
        </div>
    </div>

    <div class="card-glass overflow-hidden border border-nav-border">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-nav-surface border-b border-nav-border">
                        <th class="px-6 py-4 text-xs font-black text-text-muted uppercase tracking-widest">User</th>
                        <th class="px-6 py-4 text-xs font-black text-text-muted uppercase tracking-widest">Email</th>
                        <th class="px-6 py-4 text-xs font-black text-text-muted uppercase tracking-widest">Identity ID</th>
                        <th class="px-6 py-4 text-xs font-black text-text-muted uppercase tracking-widest text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-nav-border/50">
                    @foreach (var user in Model)
                    {
                        <tr class="hover:bg-nav-accent/30 transition-colors group">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-surface-bright flex items-center justify-center text-brand-primary font-bold border border-brand-primary/20">
                                        @(user.UserName?[0].ToString().ToUpper() ?? "?")
                                    </div>
                                    <span class="font-bold text-white">@user.UserName</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm text-dark-text-muted">@user.Email</span>
                            </td>
                            <td class="px-6 py-4">
                                <code class="text-[10px] bg-nav-surface px-2 py-1 rounded text-text-muted">@user.Id</code>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <button class="p-2 rounded-lg hover:bg-brand-primary/10 text-text-muted hover:text-brand-primary transition-all">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button class="p-2 rounded-lg hover:bg-danger-primary/10 text-text-muted hover:text-danger-primary transition-all ml-1">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
