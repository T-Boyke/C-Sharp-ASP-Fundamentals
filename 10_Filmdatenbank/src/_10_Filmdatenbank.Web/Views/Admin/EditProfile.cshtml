@* Edit Profile Partial *@
@{
    var user = await UserManager.GetUserAsync(User);
    ViewData["Title"] = "Profile Settings (IAM)";
}

<div class="max-w-3xl mx-auto px-6 py-12">
    <div class="mb-12">
        <h1 class="text-4xl font-extrabold text-white tracking-tight">
            Profile <span class="text-brand-primary">Settings</span>
        </h1>
        <p class="mt-2 text-dark-text-muted">Identity and Access Management (IAM) for your administrative account.</p>
    </div>

    <div class="card-glass p-8 border border-nav-border">
        <form class="space-y-6">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div class="flex flex-col gap-2">
                    <label class="text-xs font-black text-text-muted uppercase tracking-widest">Username</label>
                    <input type="text" value="@user?.UserName" readonly class="px-4 py-3 rounded-xl bg-nav-surface border border-nav-border text-white text-sm focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all outline-none opacity-60 cursor-not-allowed">
                </div>
                <div class="flex flex-col gap-2">
                    <label class="text-xs font-black text-text-muted uppercase tracking-widest">Email Address</label>
                    <input type="email" value="@user?.Email" class="px-4 py-3 rounded-xl bg-nav-surface border border-nav-border text-white text-sm focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all outline-none">
                </div>
            </div>

            <div class="pt-6 border-t border-nav-border">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-white">Security</h3>
                        <p class="text-xs text-dark-text-muted mt-1">Manage your authentication methods and roles.</p>
                    </div>
                    <div class="flex gap-2">
                        <span class="text-[10px] font-black px-2 py-1 rounded bg-brand-primary/10 text-brand-primary uppercase">Admin Role</span>
                        <span class="text-[10px] font-black px-2 py-1 rounded bg-success-primary/10 text-success-primary uppercase">Verified</span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4">
                <button type="button" class="btn-primary">
                    <i class="fa-solid fa-save mr-2"></i> Save Changes
                </button>
                <button type="button" class="btn-secondary px-6 py-2.5 rounded-lg border border-border-default dark:border-dark-border font-bold hover:bg-surface-soft dark:hover:bg-dark-surface-soft transition-all">
                    Cancel
                </button>
            </div>
        </form>
    </div>

    <div class="mt-8 p-6 rounded-2xl bg-danger-primary/5 border border-danger-primary/20">
        <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-danger-primary/10 flex items-center justify-center text-danger-primary flex-shrink-0">
                <i class="fa-solid fa-triangle-exclamation text-lg"></i>
            </div>
            <div>
                <h4 class="font-bold text-white text-sm">Sensitive Operations</h4>
                <p class="text-xs text-dark-text-muted mt-1 leading-relaxed">
                    Changes to your IAM profile may affect your access level. Ensure your recovery email is up to date before proceeding with password changes.
                </p>
            </div>
        </div>
    </div>
</div>
