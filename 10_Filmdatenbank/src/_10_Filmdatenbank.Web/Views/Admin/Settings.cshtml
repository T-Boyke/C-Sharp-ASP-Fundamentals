@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["AdminSettingsTitle"];
}

<div class="max-w-4xl mx-auto px-6 py-12">
    <header class="mb-12">
        <h1 class="text-4xl font-extrabold text-white tracking-tight">
            System <span class="text-brand-primary">Settings</span>
        </h1>
        <p class="mt-2 text-dark-text-muted">Global configuration and system maintenance.</p>
    </header>

    <div class="space-y-8">
        <!-- Generic Settings (Placeholder) -->
        <section class="card-glass p-8 border-nav-border">
            <h2 class="text-xl font-black text-white uppercase tracking-tight mb-6 flex items-center gap-3">
                <i class="fa-solid fa-gears text-brand-primary"></i>
                @Localizer["GeneralSettings"]
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="p-4 rounded-xl bg-surface-bright/5 border border-white/5 opacity-50">
                    <p class="text-xs font-black text-brand-primary uppercase mb-2">API Refresh Rate</p>
                    <p class="text-sm font-bold text-white">60 Minutes</p>
                </div>
                <div class="p-4 rounded-xl bg-surface-bright/5 border border-white/5 opacity-50">
                    <p class="text-xs font-black text-brand-primary uppercase mb-2">Notification System</p>
                    <p class="text-sm font-bold text-white">WebSocket Active</p>
                </div>
            </div>
            <p class="mt-6 text-[10px] text-text-muted italic">Only the system administrator can modify these values via appsettings.json.</p>
        </section>

        <!-- Danger Zone -->
        <section class="p-8 rounded-3xl border border-danger-primary/30 bg-danger-primary/5 shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 right-0 p-4 opacity-10">
                <i class="fa-solid fa-triangle-exclamation text-8xl text-danger-primary"></i>
            </div>
            
            <h2 class="text-xl font-black text-danger-primary uppercase tracking-tight mb-2 flex items-center gap-3">
                <i class="fa-solid fa-skull-crossbones"></i>
                @Localizer["DangerZone"]
            </h2>
            <p class="text-sm text-dark-text-muted mb-8 max-w-xl">
                These operations are destructive and cannot be undone. Extreme caution is advised.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                <!-- Clear Films -->
                <div class="p-4 rounded-2xl bg-black/20 border border-danger-primary/10 flex items-center justify-between">
                    <div>
                        <h4 class="text-[10px] font-black text-white uppercase">@Localizer["ClearFilms"]</h4>
                        <p class="text-[9px] text-dark-text-muted">Delete all movies</p>
                    </div>
                    <button type="button" onclick="confirmAction('ClearFilms', 'DELETE-FILMS', 'All movies and their related data (ratings, genres) will be permanently deleted!')" 
                            class="p-2 rounded-lg bg-danger-primary/10 text-danger-primary hover:bg-danger-primary hover:text-white transition-all">
                        <i class="fa-solid fa-film"></i>
                    </button>
                </div>

                <!-- Clear People -->
                <div class="p-4 rounded-2xl bg-black/20 border border-danger-primary/10 flex items-center justify-between">
                    <div>
                        <h4 class="text-[10px] font-black text-white uppercase">@Localizer["ClearPeople"]</h4>
                        <p class="text-[9px] text-dark-text-muted">Delete all persons</p>
                    </div>
                    <button type="button" onclick="confirmAction('ClearPeople', 'DELETE-PEOPLE', 'All cast and crew members will be permanently deleted!')" 
                            class="p-2 rounded-lg bg-danger-primary/10 text-danger-primary hover:bg-danger-primary hover:text-white transition-all">
                        <i class="fa-solid fa-user-ninja"></i>
                    </button>
                </div>

                <!-- Clear Collections -->
                <div class="p-4 rounded-2xl bg-black/20 border border-danger-primary/10 flex items-center justify-between">
                    <div>
                        <h4 class="text-[10px] font-black text-white uppercase">@Localizer["ClearCollections"]</h4>
                        <p class="text-[9px] text-dark-text-muted">Delete movie series</p>
                    </div>
                    <button type="button" onclick="confirmAction('ClearCollections', 'DELETE-COLLECTIONS', 'All movie collections will be permanently deleted!')" 
                            class="p-2 rounded-lg bg-danger-primary/10 text-danger-primary hover:bg-danger-primary hover:text-white transition-all">
                        <i class="fa-solid fa-layer-group"></i>
                    </button>
                </div>

                <!-- Clear Studios -->
                <div class="p-4 rounded-2xl bg-black/20 border border-danger-primary/10 flex items-center justify-between">
                    <div>
                        <h4 class="text-[10px] font-black text-white uppercase">@Localizer["ClearStudios"]</h4>
                        <p class="text-[9px] text-dark-text-muted">Delete production companies</p>
                    </div>
                    <button type="button" onclick="confirmAction('ClearStudios', 'DELETE-STUDIOS', 'All production companies (studios) will be permanently deleted!')" 
                            class="p-2 rounded-lg bg-danger-primary/10 text-danger-primary hover:bg-danger-primary hover:text-white transition-all">
                        <i class="fa-solid fa-building"></i>
                    </button>
                </div>
            </div>

            <div class="p-6 rounded-2xl bg-danger-primary/10 border border-danger-primary/20">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div>
                        <h4 class="text-sm font-black text-white uppercase mb-1">@Localizer["DropDatabase"]</h4>
                        <p class="text-[11px] text-dark-text-muted font-bold">
                            @Localizer["DropDatabaseHint"]
                        </p>
                    </div>
                    
                    <button type="button" 
                            onclick="confirmDatabaseDrop()"
                            class="px-6 py-3 rounded-xl bg-danger-primary text-white font-black hover:bg-danger-hover transition-all shadow-lg shadow-danger-primary/20 text-xs shrink-0 whitespace-nowrap">
                        <i class="fa-solid fa-trash-can mr-2"></i>
                        @Localizer["ExecuteDrop"]
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

<!-- Generic Confirmation Modal -->
<div id="actionConfirmModal" class="fixed inset-0 z-[60] hidden">
    <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeActionModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md p-6">
        <div class="card-glass p-8 border-danger-primary/50 shadow-[0_0_50px_rgba(239,68,68,0.2)] animate-in zoom-in duration-300">
            <div class="w-16 h-16 rounded-full bg-danger-primary/10 flex items-center justify-center text-danger-primary text-3xl mx-auto mb-6">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            
            <h2 id="modalTitle" class="text-xl font-black text-white text-center mb-2 uppercase">Confirm Action</h2>
            <p id="modalDescription" class="text-sm text-center text-dark-text-muted mb-8"></p>
            
            <form id="modalForm" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <div class="space-y-2">
                    <label id="modalHint" class="text-[10px] font-black text-text-muted uppercase tracking-widest block text-center"></label>
                    <input type="text" id="actionConfirmInput" class="w-full bg-black/40 border border-nav-border rounded-xl px-4 py-3 text-white text-center font-black focus:border-danger-primary focus:ring-1 focus:ring-danger-primary transition-all outline-none" placeholder="....">
                </div>

                <div class="flex gap-3">
                    <button type="button" onclick="closeActionModal()" class="flex-1 px-4 py-3 rounded-xl bg-surface-muted text-white font-bold hover:bg-surface-bright transition-all text-sm">
                        @Localizer["Cancel"]
                    </button>
                    <button type="submit" id="finalActionBtn" disabled class="flex-1 px-4 py-3 rounded-xl bg-danger-primary text-white font-black opacity-30 cursor-not-allowed transition-all text-sm">
                        @Localizer["Confirm"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let requiredText = '';

        function confirmAction(action, confirmWord, description) {
            const modal = document.getElementById('actionConfirmModal');
            const form = document.getElementById('modalForm');
            const title = document.getElementById('modalTitle');
            const desc = document.getElementById('modalDescription');
            const hint = document.getElementById('modalHint');
            const input = document.getElementById('actionConfirmInput');
            const btn = document.getElementById('finalActionBtn');

            requiredText = confirmWord;
            form.action = '/Admin/' + action;
            title.innerText = action.replace('Clear', 'Clear ').toUpperCase();
            desc.innerText = description;
            hint.innerText = `Type "${confirmWord}" to confirm`;
            
            input.value = '';
            btn.disabled = true;
            btn.classList.add('opacity-30', 'cursor-not-allowed');

            modal.classList.remove('hidden');
            input.focus();
        }

        function confirmDatabaseDrop() {
            confirmAction('DropDatabase', 'DELETE-ALL', 'This will delete EVERYTHING: Users, Films, Groups, Comments. This action is terminal and will sign you out.');
        }

        function closeActionModal() {
            document.getElementById('actionConfirmModal').classList.add('hidden');
        }

        document.getElementById('actionConfirmInput')?.addEventListener('input', (e) => {
            const btn = document.getElementById('finalActionBtn');
            if (e.target.value === requiredText) {
                btn.disabled = false;
                btn.classList.remove('opacity-30', 'cursor-not-allowed');
            } else {
                btn.disabled = true;
                btn.classList.add('opacity-30', 'cursor-not-allowed');
            }
        });
    </script>
}
