@model IEnumerable<_10_Filmdatenbank.Domain.Entities.Film>

@{
    ViewData["Title"] = "Filme Bibliothek";
}

<div class="mx-auto max-w-7xl px-6 lg:px-8 py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 border-b border-slate-200 dark:border-slate-800 pb-8 transition-colors duration-300">
        <div>
            <div class="flex items-center gap-2 mb-2">
                <i aria-hidden="true" class="fa-solid fa-rectangle-list text-brand-primary"></i>
                <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest leading-none">Bestand</span>
            </div>
            <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white transition-colors">Film-Katalog</h1>
            <p class="mt-3 text-lg text-slate-500 dark:text-slate-400 max-w-2xl font-medium transition-colors">Durchsuchen Sie unsere kuratierte Sammlung erstklassiger Filmproduktionen.</p>
        </div>
        
        @if (User.IsInRole("Admin"))
        {
            <div class="flex-shrink-0">
                <a asp-action="Create" class="btn-primary">
                    <i aria-hidden="true" class="fa-solid fa-square-plus mr-2"></i> Neuer Eintrag
                </a>
            </div>
        }
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        @foreach (var film in Model)
        {
            <div class="card-premium dark:bg-slate-900 overflow-hidden flex flex-col h-full group transition-all duration-300">
                <div class="relative w-full aspect-[2/3] bg-linear-to-br from-brand-primary/80 to-indigo-900/90 flex items-center justify-center p-6 border-b border-slate-100 dark:border-slate-800 transition-colors">
                    <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-500"></div>
                    <i aria-hidden="true" class="fa-solid fa-film text-white/50 text-7xl group-hover:scale-110 group-hover:text-white/70 transition-all duration-500"></i>
                    
                    @if (film.Erscheinungsjahr >= DateTime.Now.Year - 1)
                    {
                        <div class="absolute top-4 right-4 bg-emerald-500 text-white text-[10px] font-bold px-2 py-1 rounded uppercase tracking-tighter shadow-md">
                            Neu
                        </div>
                    }
                    
                    <div class="absolute bottom-0 inset-x-0 h-1/2 bg-gradient-to-t from-slate-900/80 to-transparent"></div>
                </div>
                
                <div class="p-5 flex-1 flex flex-col justify-between bg-white dark:bg-slate-900 transition-colors">
                    <div>
                        <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-brand-primary transition-colors line-clamp-2">
                            @film.Titel
                        </h3>
                    
                    <div class="flex items-center gap-3 mt-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wide">
                        <span class="flex items-center gap-1">
                            <i aria-hidden="true" class="fa-regular fa-calendar"></i> @film.Erscheinungsjahr
                        </span>
                        <span class="h-1 w-1 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                        <span class="flex items-center gap-1">
                            <i aria-hidden="true" class="fa-regular fa-clock"></i> @film.Spieldauer min
                        </span>
                    </div>

                    <div class="mt-5 flex flex-wrap gap-2 min-h-[50px]">
                        @foreach (var pef in film.PersonEigenschaftFilme.Take(2))
                        {
                            <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-[11px] font-bold text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition-colors">
                                <i aria-hidden="true" class="fa-solid fa-user text-brand-primary/70 mr-1.5 line-clamp-1"></i> @pef.Person.Nachname
                            </span>
                        }
                    </div>
                </div>

                <div class="px-5 py-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 flex items-center justify-between transition-colors">
                        <span class="text-lg font-extrabold text-slate-900 dark:text-slate-100 transition-colors">
                            @film.Preis.ToString("C")
                        </span>
                        
                        <div class="flex gap-2">
                             <a asp-action="Details" asp-route-id="@film.FilmID" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 text-slate-400 hover:text-brand-primary hover:border-brand-primary dark:hover:border-brand-primary transition-all shadow-sm" title="Details" aria-label="Details">
                                <i aria-hidden="true" class="fa-solid fa-magnifying-glass text-sm"></i>
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@film.FilmID" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-emerald-200 dark:hover:border-emerald-700 transition-all shadow-sm" title="Bearbeiten" aria-label="Bearbeiten">
                                    <i aria-hidden="true" class="fa-solid fa-pen-to-square text-sm"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@film.FilmID" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 text-slate-400 hover:text-red-600 dark:hover:text-red-400 hover:border-red-200 dark:hover:border-red-700 transition-all shadow-sm" title="Löschen" aria-label="Löschen">
                                    <i aria-hidden="true" class="fa-solid fa-trash-can text-sm"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
