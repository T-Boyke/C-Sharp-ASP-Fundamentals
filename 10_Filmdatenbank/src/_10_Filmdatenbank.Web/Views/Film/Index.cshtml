@model IEnumerable<_10_Filmdatenbank.Domain.Entities.Film>

@{
    ViewData["Title"] = "Filme Bibliothek";
}

<div class="mx-auto max-w-7xl px-6 lg:px-8 py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 border-b border-slate-200 pb-8">
        <div>
            <div class="flex items-center gap-2 mb-2">
                <i class="fa-solid fa-rectangle-list text-brand-primary"></i>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest leading-none">Bestand</span>
            </div>
            <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">Film-Katalog</h1>
            <p class="mt-3 text-lg text-slate-500 max-w-2xl font-medium">Durchsuchen Sie unsere kuratierte Sammlung erstklassiger Filmproduktionen.</p>
        </div>
        
        @if (User.IsInRole("Admin"))
        {
            <div class="flex-shrink-0">
                <a asp-action="Create" class="btn-primary">
                    <i class="fa-solid fa-square-plus mr-2"></i> Neuer Eintrag
                </a>
            </div>
        }
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        @foreach (var film in Model)
        {
            <div class="card-premium group">
                <div class="aspect-h-1 aspect-w-1 w-full overflow-hidden bg-slate-50 flex items-center justify-center h-48 border-b border-slate-100">
                    <i class="fa-solid fa-film text-slate-200 text-6xl group-hover:text-brand-primary/20 transition-colors duration-500"></i>
                    @if (film.Erscheinungsjahr >= DateTime.Now.Year - 1)
                    {
                        <div class="absolute top-4 right-4 bg-brand-primary text-white text-[10px] font-bold px-2 py-1 rounded uppercase tracking-tighter shadow-sm">
                            Neu
                        </div>
                    }
                </div>
                
                <div class="p-5">
                    <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-primary transition-colors line-clamp-1">
                        @film.Titel
                    </h3>
                    
                    <div class="flex items-center gap-3 mt-2 text-xs font-bold text-slate-400 uppercase tracking-wide">
                        <span class="flex items-center gap-1">
                            <i class="fa-regular fa-calendar"></i> @film.Erscheinungsjahr
                        </span>
                        <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                        <span class="flex items-center gap-1">
                            <i class="fa-regular fa-clock"></i> @film.Spieldauer min
                        </span>
                    </div>

                    <div class="mt-4 flex flex-wrap gap-1.5 min-h-[44px]">
                        @foreach (var pef in film.PersonEigenschaftFilme.Take(2))
                        {
                            <span class="inline-flex items-center px-2 py-0.5 rounded bg-brand-soft text-[10px] font-bold text-brand-primary border border-brand-border">
                                <i class="fa-solid fa-user-tag mr-1 opacity-60"></i> @pef.Person.Nachname
                            </span>
                        }
                    </div>

                    <div class="mt-6 flex items-center justify-between">
                        <span class="text-lg font-extrabold text-slate-900">
                            @film.Preis.ToString("C")
                        </span>
                        
                        <div class="flex gap-2">
                             <a asp-action="Details" asp-route-id="@film.FilmID" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:text-brand-primary hover:border-brand-primary transition-all shadow-sm" title="Details">
                                <i class="fa-solid fa-magnifying-glass text-sm"></i>
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@film.FilmID" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:text-emerald-600 hover:border-emerald-200 transition-all shadow-sm" title="Bearbeiten">
                                    <i class="fa-solid fa-pen-to-square text-sm"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@film.FilmID" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:text-red-600 hover:border-red-200 transition-all shadow-sm" title="Löschen">
                                    <i class="fa-solid fa-trash-can text-sm"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
