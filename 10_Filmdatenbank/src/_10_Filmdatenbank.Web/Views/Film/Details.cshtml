@model _10_Filmdatenbank.Domain.Entities.Film

@{
    ViewData["Title"] = "Film Details";
}

<div class="mx-auto max-w-7xl px-6 lg:px-8 py-12">
    <div class="mb-8 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <div class="h-16 w-16 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-3xl shadow-lg shadow-indigo-200">
                <i class="fa-solid fa-film"></i>
            </div>
            <div>
                <h1 class="text-3xl font-bold leading-9 tracking-tight text-slate-900">@Model.Titel</h1>
                <p class="mt-1 text-sm text-slate-500">Filmdatenbank &middot; ID #@Model.FilmID</p>
            </div>
        </div>
        <div class="flex gap-4">
            <a asp-action="Index" class="inline-flex items-center rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 transition-all duration-200">
                <i class="fa-solid fa-list mr-2 text-slate-400"></i>Liste
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.FilmID" class="inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-all duration-200">
                    <i class="fa-solid fa-pen-to-square mr-2"></i>Bearbeiten
                </a>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        <!-- Main Stats -->
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden divide-y divide-slate-100">
                <div class="p-6">
                    <h3 class="text-sm font-semibold text-slate-900 mb-4 uppercase tracking-wider">Informationen</h3>
                    <dl class="space-y-4">
                        <div>
                            <dt class="text-xs font-medium text-slate-500 uppercase">Erscheinungsjahr</dt>
                            <dd class="mt-1 text-lg font-bold text-slate-900">@Model.Erscheinungsjahr</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-slate-500 uppercase">Spieldauer</dt>
                            <dd class="mt-1 text-lg font-bold text-slate-900">@Model.Spieldauer <span class="text-sm font-normal text-slate-400">Minuten</span></dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-slate-500 uppercase">Preis</dt>
                            <dd class="mt-1 text-2xl font-black text-indigo-600">@Model.Preis.ToString("C")</dd>
                        </div>
                    </dl>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <div class="p-6 bg-slate-50/50">
                        <a asp-action="Delete" asp-route-id="@Model.FilmID" class="text-sm font-semibold text-red-600 hover:text-red-900 flex items-center transition-colors">
                            <i class="fa-solid fa-trash-can mr-2"></i>Film dauerhaft löschen
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Cast & Roles -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-8 py-6 border-b border-slate-100 flex items-center justify-between">
                    <h2 class="text-xl font-bold text-slate-900">Beteiligte Personen</h2>
                    <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10">
                        @Model.PersonEigenschaftFilme.Count Personen
                    </span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50/50 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                            <tr>
                                <th class="px-8 py-4">Name</th>
                                <th class="px-8 py-4">Rolle / Eigenschaft</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var pef in Model.PersonEigenschaftFilme)
                            {
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-8 py-5 whitespace-nowrap">
                                        <div class="flex items-center gap-3">
                                            <div class="h-8 w-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                                <i class="fa-solid fa-user text-sm"></i>
                                            </div>
                                            <div class="text-sm font-bold text-slate-900">@pef.Person.Vorname @pef.Person.Nachname</div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-5 whitespace-nowrap">
                                        <span class="inline-flex items-center rounded-md bg-white px-2 py-1 text-xs font-medium text-slate-700 ring-1 ring-inset ring-slate-200 shadow-sm capitalize">
                                            @pef.Eigenschaft.Bezeichnung
                                        </span>
                                    </td>
                                </tr>
                            }
                            @if (!Model.PersonEigenschaftFilme.Any())
                            {
                                <tr>
                                    <td colspan="2" class="px-8 py-12 text-center text-slate-400 italic text-sm">
                                        Keine Verknüpfungen für diesen Film gefunden.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
