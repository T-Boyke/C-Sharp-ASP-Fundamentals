@model _10_Filmdatenbank.Domain.Entities.Film
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject _10_Filmdatenbank.Infrastructure.Persistence.ApplicationDbContext _db

@using Microsoft.EntityFrameworkCore
@{
    ViewData["Title"] = Model.Titel;
    var userId = UserManager.GetUserId(User);
    var isFavorite = userId != null && _db.FavoriteFilms.Any(ff => ff.FilmID == Model.FilmID && ff.UserID == userId);

    // Fetch countries for full names
    var countryDict = await _db.Countries.ToDictionaryAsync(c => c.Iso3166_1, c => c.Name);
}

@functions {
    string GetRatingLogo(string iso, string cert)
    {
        if (string.IsNullOrEmpty(cert)) return null;
        var c = cert.ToUpper()
            .Replace("FSK", "").Replace("AB", "").Replace("MINORI", "")
            .Replace("ANNI", "").Replace("Y", "").Replace("PLUS", "+")
            .Replace("ANS", "").Replace("YEARS", "").Replace("ALT", "")
            .Replace("ALDER", "").Replace("JAAR", "").Replace("ANS", "")
            .Replace("RATED", "").Replace("BBFC", "").Replace("OFLC", "")
            .Trim();
        
        switch (iso)
        {
            case "DE":
                 if (c.Contains("0") || c == "L") return "/images/ratings/de/FSK_0.svg";
                 if (c.Contains("6")) return "/images/ratings/de/FSK_6.svg";
                 if (c.Contains("12")) return "/images/ratings/de/FSK_12.svg";
                 if (c.Contains("16")) return "/images/ratings/de/FSK_16.svg";
                 if (c.Contains("18")) return "/images/ratings/de/FSK_18.svg";
                 break;
            case "US":
                 if (c == "G") return "/images/ratings/us/MPA_G_RATING.svg";
                 if (c == "PG") return "/images/ratings/us/MPA_PG_RATING.svg";
                 if (c == "PG-13" || c == "PG13") return "/images/ratings/us/MPA_PG-13_RATING.svg";
                 if (c == "R") return "/images/ratings/us/MPA_R_RATING.svg";
                 if (c == "NC-17" || c == "NC17") return "/images/ratings/us/MPA_NC-17_RATING.svg";
                 break;
            case "GB":
                 if (c == "U") return "/images/ratings/gb/BBFC_U_2019.svg";
                 if (c == "PG") return "/images/ratings/gb/BBFC_PG_2019.svg";
                 if (c == "12") return "/images/ratings/gb/BBFC_12_2019.svg";
                 if (c == "12A") return "/images/ratings/gb/BBFC_12A_2019.svg";
                 if (c == "15") return "/images/ratings/gb/BBFC_15_2019.svg";
                 if (c == "15A") return "/images/ratings/gb/BBFC_15A_2019.svg";
                 if (c == "18") return "/images/ratings/gb/BBFC_18_2019.svg";
                 if (c == "R18") return "/images/ratings/gb/BBFC_R18_2019.svg";
                 break;
            case "AU":
                 if (c == "G") return "/images/ratings/au/Australian_Classification_General_(G).svg";
                 if (c == "PG") return "/images/ratings/au/Australian_Classification_Parental_Guidance_(PG).svg";
                 if (c == "M") return "/images/ratings/au/Australian_Classification_Mature_(M).svg";
                 if (c.Contains("15")) return "/images/ratings/au/Australian_Classification_Mature_15+_(MA_15+).svg";
                 if (c == "R" || (c.Contains("18") && c.Contains("R"))) return "/images/ratings/au/Australian_Classification_Restricted_18+_(R_18+).svg";
                 if (c == "X" || (c.Contains("18") && c.Contains("X"))) return "/images/ratings/au/Australian_Classification_Restricted_18+_(X_18+).svg";
                 break;
            case "FR":
                 if (c.Contains("12")) return "/images/ratings/fr/Moins12.svg";
                 if (c.Contains("16")) return "/images/ratings/fr/Moins16.svg";
                 if (c.Contains("18")) return "/images/ratings/fr/Moins18.svg";
                 break;
            case "IT":
                 if (c == "T" || c == "ALL") return "/images/ratings/it/Mibact_Tutti.svg";
                 if (c.Contains("6")) return "/images/ratings/it/Mibact_Minori6anni.svg";
                 if (c.Contains("10")) return "/images/ratings/it/Mibact_Minori10anni.svg";
                 if (c.Contains("14")) return "/images/ratings/it/Mibact_Minori14anni.svg";
                 if (c.Contains("18")) return "/images/ratings/it/Mibact_Minori18anni.svg";
                 break;
            case "JP":
                 if (c == "G") return "/images/ratings/jp/Eirin_Rated_G.svg";
                 if (c.Contains("12")) return "/images/ratings/jp/Eirin_Rated_PG12.svg";
                 if (c.Contains("15")) return "/images/ratings/jp/Eirin_Rated_R15+.svg";
                 if (c.Contains("18")) return "/images/ratings/jp/Eirin_Rated_R18+.svg";
                 break;
            case "KR":
                 if (c == "ALL" || c == "G") return "/images/ratings/kr/KMRB_All_(2021).svg";
                 if (c.Contains("12")) return "/images/ratings/kr/KMRB_12_(2021).svg";
                 if (c.Contains("15")) return "/images/ratings/kr/KMRB_15_(2021).svg";
                 if (c.Contains("18") || c.Contains("19")) return "/images/ratings/kr/KMRB_19_(2024).svg";
                 break;
            case "NL":
                 if (c == "AL" || c == "G") return "/images/ratings/nl/Kijkwijzer_AL.svg";
                 if (c.Contains("6")) return "/images/ratings/nl/Kijkwijzer_6.svg";
                 if (c.Contains("9")) return "/images/ratings/nl/Kijkwijzer_9.svg";
                 if (c.Contains("12")) return "/images/ratings/nl/Kijkwijzer_12.svg";
                 if (c.Contains("14")) return "/images/ratings/nl/Kijkwijzer_14.svg";
                 if (c.Contains("16")) return "/images/ratings/nl/Kijkwijzer_16.svg";
                 if (c.Contains("18")) return "/images/ratings/nl/Kijkwijzer_18.svg";
                 break;
            case "RU":
                 if (c.Contains("0")) return "/images/ratings/ru/RARS_(0+).svg";
                 if (c.Contains("6")) return "/images/ratings/ru/RARS_(6+).svg";
                 if (c.Contains("12")) return "/images/ratings/ru/RARS_(12+).svg";
                 if (c.Contains("16")) return "/images/ratings/ru/RARS_(16+).svg";
                 if (c.Contains("18")) return "/images/ratings/ru/RARS_(18+).svg";
                 break;
            case "CA":
                 if (c == "G") return "/images/ratings/ca/CHVRS_G_2014.svg";
                 if (c == "PG") return "/images/ratings/ca/CHVRS_PG_2014.svg";
                 if (c.Contains("14")) return "/images/ratings/ca/CHVRS_14A_2014.svg";
                 if (c.Contains("18")) return "/images/ratings/ca/CHVRS_18A_2014.svg";
                 if (c == "R") return "/images/ratings/ca/CHVRS_R_2014.svg";
                 break;
            case "CH":
                 if (c == "G") return "/images/ratings/ch/GSRR_G_logo.svg";
                 if (c == "P") return "/images/ratings/ch/GSRR_P_logo.svg";
                 if (c.Contains("12")) return "/images/ratings/ch/GSRR_PG_12_logo.svg";
                 if (c.Contains("14")) return "/images/ratings/ch/GSRR_PG_14_logo.svg";
                 if (c.Contains("16")) return "/images/ratings/ch/GSRR_16_logo.svg";
                 break;
            case "DK":
                 if (c == "A" || c == "ALL") return "/images/ratings/dk/DK_All.svg";
                 if (c.Contains("7")) return "/images/ratings/dk/DK_7.svg";
                 if (c.Contains("11")) return "/images/ratings/dk/DK_11.svg";
                 if (c.Contains("15")) return "/images/ratings/dk/DK_15.svg";
                 if (c.Contains("E")) return "/images/ratings/dk/DK_Exempt.svg";
                 break;
            case "FI":
                 if (c == "S" || c == "ALL") return "/images/ratings/fi/FI-SALLITTU_(2016).svg";
                 if (c.Contains("7")) return "/images/ratings/fi/FI-7_(2016).svg";
                 if (c.Contains("12")) return "/images/ratings/fi/FI-12_(2016).svg";
                 if (c.Contains("16")) return "/images/ratings/fi/FI-16_(2016).svg";
                 if (c.Contains("18")) return "/images/ratings/fi/FI-18_(2016).svg";
                 break;
            case "NZ":
                 if (c == "G") return "/images/ratings/nz/OFLC_G_label_(2022).svg";
                 if (c == "PG") return "/images/ratings/nz/OFLC_PG_label_(2022).svg";
                 if (c == "M") return "/images/ratings/nz/OFLC_M_label_(2022).svg";
                 if (c == "R13") return "/images/ratings/nz/OFLC_Restricted_13_(R13)_label_(2022).svg";
                 if (c == "R15") return "/images/ratings/nz/OFLC_Restricted_15_(R15)_label_(2022).svg";
                 if (c == "R16") return "/images/ratings/nz/OFLC_Restricted_16_(R16)_label_(2022).svg";
                 if (c == "R18") return "/images/ratings/nz/OFLC_Restricted_18_(R18)_label_(2022).svg";
                 if (c.Contains("R") && !c.Contains("1")) return "/images/ratings/nz/OFLC_Restricted_(R)_label_(2022).svg";
                 break;
        }

        return null;
    }
}

<div class="mx-auto max-w-7xl px-6 lg:px-8 py-16">
    <!-- Breadcrumb & Back -->
    <nav class="flex mb-8 items-center gap-4 text-sm font-bold text-text-muted uppercase tracking-widest" aria-label='@Localizer["Breadcrumb"]'>
        <a asp-action="Index" class="nav-link">
            <i aria-hidden="true" class="fa-solid fa-arrow-left"></i> @Localizer["Catalog"]
        </a>
        <span class="h-1 w-1 rounded-full bg-border-default"></span>
    </nav>
    
    @if (!string.IsNullOrEmpty(Model.BackdropUrl))
    {
        <div class="relative w-full h-64 md:h-96 rounded-3xl overflow-hidden mb-12 group shadow-2xl" aria-hidden="true">
            <img src="@Model.BackdropUrl" alt="" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
            <div class="absolute inset-0 bg-linear-to-t from-dark-surface via-dark-surface-soft/40 to-transparent"></div>
            <div class="absolute bottom-8 left-8 right-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                    <div class="badge-premium px-3 py-1 mb-4 inline-flex">
                        <i aria-hidden="true" class="fa-solid fa-hashtag text-brand-primary"></i> @Model.FilmID
                        @if (Model.TmdbId.HasValue)
                        {
                            <span class="mx-2 text-white-a20">|</span>
                            <span class="text-[10px] font-black text-text-white-muted uppercase tracking-widest">TMDB: @Model.TmdbId</span>
                        }
                        @if (Model.TvdbId.HasValue)
                        {
                            <span class="mx-2 text-white-a20">|</span>
                            <div class="flex items-center gap-1.5">
                                <img src="/images/logos/tvdb.svg" class="h-2 w-auto opacity-80" alt="TVDB" />
                                <span class="text-[10px] font-black text-text-white-muted uppercase tracking-widest">@Model.TvdbId</span>
                            </div>
                        }
                    </div>
                   <h1 class="text-4xl md:text-6xl font-black text-white tracking-tighter drop-shadow-2xl">@Model.Titel</h1>
                   @if (!string.IsNullOrEmpty(Model.Tagline))
                   {
                       <p class="mt-2 text-xl md:text-2xl font-bold text-brand-primary italic drop-shadow-lg">@Model.Tagline</p>
                   }
                </div>
                    <div class="flex items-center gap-4">
                        <button type="button" 
                                class="favorite-toggle glass-premium w-16 h-16 rounded-2xl flex items-center justify-center transition-all group/heart @(isFavorite ? "text-danger-primary shadow-2xl shadow-danger-primary/20" : "text-text-white-muted hover:text-white hover:bg-glass-bg-hover")" 
                                data-film-id="@Model.FilmID" 
                                data-url="@Url.Action("ToggleFavorite", "Film", new { filmId = Model.FilmID })"
                                title='@(isFavorite ? Localizer["RemoveFromWatchlist"] : Localizer["AddToWatchlist"])'>
                            <i class="fa-@(isFavorite ? "solid" : "regular") fa-heart text-2xl group-hover/heart:scale-110 transition-transform"></i>
                        </button>
                        <div class="glass-premium px-6 py-3 rounded-2xl flex items-center gap-3 border border-surface-bright/20">
                            <div class="w-10 h-10 rounded-full bg-[#01d277]/10 flex items-center justify-center shadow-lg border border-[#01d277]/20">
                                <img src="/images/logos/tmdb.svg" class="w-6 h-6 object-contain" alt="TMDB" />
                            </div>
                            <div>
                                <p class="text-[10px] font-black text-text-white-muted uppercase tracking-widest">TMDB</p>
                                <p class="text-xl font-black text-white">@(Model.VoteAverage?.ToString("0.0") ?? "N/A")</p>
                            </div>
                        </div>

                        <div class="glass-premium px-6 py-3 rounded-2xl flex items-center gap-3 border border-surface-bright/20">
                            <div class="w-10 h-10 rounded-full bg-brand-primary flex items-center justify-center text-white shadow-lg">
                                <i class="fa-solid fa-couch"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-black text-text-white-muted uppercase tracking-widest">CouchDB</p>
                                <p class="text-xl font-black text-white">@(Model.Nutzerwertung?.ToString("0.0") ?? "N/A")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <!-- Left: Poster / Key Info -->
        <div class="lg:col-span-1 space-y-8">
            <div class="card-premium overflow-hidden group">
                <div class="aspect-[2/3] bg-surface-subtle dark:bg-dark-surface-soft flex items-center justify-center transition-colors relative" aria-hidden="true">
                    @if (!string.IsNullOrEmpty(Model.PosterUrl))
                    {
                        <img src="@Model.PosterUrl" alt='@Localizer["PosterOf", Model.Titel]' class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                    }
                    else
                    {
                        <i aria-hidden="true" class="fa-solid fa-film text-text-muted dark:text-dark-surface-muted text-9xl"></i>
                    }
                    
                    <div class="absolute inset-x-0 bottom-0 p-8 bg-linear-to-t from-dark-surface/80 via-dark-surface/40 to-transparent">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-brand-primary/90 backdrop-blur-md text-white shadow-xl shadow-brand-shadow-lg border border-brand-primary/50"
                                 aria-label='@Localizer["Rating"]: @(Model.Nutzerwertung?.ToString("0.0") ?? "N/A")'>
                                <i aria-hidden="true" class="fa-solid fa-star text-[10px] text-star-primary"></i>
                                <span class="text-xs font-black tracking-tighter">@(Model.Nutzerwertung?.ToString("0.0") ?? "N/A")</span>
                            </div>
                             @{
                                 var primaryRelease = Model.Releases?.FirstOrDefault();
                                 if (primaryRelease != null)
                                 {
                                    <span class="px-2 py-1 rounded bg-dark-surface/80 backdrop-blur-md text-[10px] font-black text-white border border-glass-border uppercase tracking-tighter">
                                        @primaryRelease.Certification
                                    </span>
                                 }
                             }
                        </div>
                    </div>
                </div>
                <div class="p-8 space-y-6 bg-surface-overlay dark:bg-dark-surface-soft transition-colors">
                    <div>
                        <h3 class="text-xs font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest mb-4">@Localizer["Pricing"]</h3>
                        <div class="flex items-baseline gap-2 text-3xl font-black text-text-main dark:text-white transition-colors">
                            @Model.Preis.ToString("C")
                            <span class="text-sm font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-tighter">@Localizer["IncVat"]</span>
                        </div>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="pt-6 border-t border-border-muted dark:border-dark-border flex flex-wrap gap-4 transition-colors">
                            <a asp-action="Edit" asp-route-id="@Model.FilmID" class="btn-primary flex-1 shadow-lg shadow-brand-shadow whitespace-nowrap" aria-label='@Localizer["Edit"]'>
                                <i aria-hidden="true" class="fa-solid fa-pen-to-square mr-2"></i> @Localizer["Edit"]
                            </a>
                            <form asp-action="SyncExternalScores" method="post" class="flex-1">
                                <input type="hidden" name="id" value="@Model.FilmID" />
                                <button type="submit" class="w-full btn-secondary shadow-lg shadow-brand-primary/10 whitespace-nowrap" title="Cloud Sync">
                                    <i class="fa-solid fa-cloud-arrow-down mr-2"></i> Sync
                                </button>
                            </form>
                            <a asp-action="Delete" asp-route-id="@Model.FilmID" class="btn-danger p-2.5 shadow-lg shadow-danger-primary/20" aria-label='@Localizer["Delete"]' title='@Localizer["Delete"]'>
                                <i aria-hidden="true" class="fa-solid fa-trash-can"></i>
                            </a>
                        </div>
                    }
                </div>

                <!-- CouchDB Rating Widget -->
                <div class="p-8 border-t border-border-muted dark:border-dark-border bg-brand-primary/5">
                    <h3 class="text-[10px] font-black text-brand-primary uppercase tracking-[0.2em] mb-4">@Localizer["YourCouchRating"]</h3>
                    <form asp-action="Rate" method="post" class="space-y-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.FilmID" />
                        <div class="relative pt-2">
                             <input type="range" name="rating" min="0" max="10" step="0.5" 
                                   value="@(ViewBag.CurrentUserRating ?? 5.0)" 
                                   class="w-full h-1.5 bg-brand-primary/20 rounded-lg appearance-none cursor-pointer accent-brand-primary"
                                   oninput="this.nextElementSibling.innerText = parseFloat(this.value).toFixed(1)">
                             <span class="block mt-3 text-3xl font-black text-text-main dark:text-white transition-colors">@(ViewBag.CurrentUserRating?.ToString("0.0") ?? "5.0")</span>
                        </div>
                        <button type="submit" class="w-full btn-primary py-3 rounded-xl flex items-center justify-center gap-2 group/btn">
                            <i class="fa-solid fa-couch group-hover/btn:scale-110 transition-transform"></i>
                            <span>@Localizer["RateNow"]</span>
                        </button>
                    </form>
                </div>

                    <!-- Global Critics Score Matrix -->
                    <div class="p-8 border-t border-border-muted dark:border-dark-border">
                        <h3 class="text-[10px] font-black text-white/50 uppercase tracking-[0.2em] mb-6">@Localizer["CriticalConsensus"]</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <!-- IMDb -->
                             <div class="p-3 rounded-xl bg-nav-surface/50 border border-white/5 hover:border-brand-primary/30 transition-all group/stat">
                                 <div class="flex items-center gap-2 mb-2">
                                     <img src="/images/logos/imdb.svg" class="h-3 w-auto" alt="IMDb" />
                                     <span class="text-[8px] font-black text-text-muted uppercase tracking-widest">IMDb</span>
                                 </div>
                                 <span class="text-lg font-black text-white">@(Model.ImdbRating?.ToString("0.0") ?? "N/A")</span>
                             </div>
                             <!-- Metacritic -->
                             <div class="p-3 rounded-xl bg-nav-surface/50 border border-white/5 hover:border-brand-primary/30 transition-all group/stat">
                                <div class="flex items-center justify-between mb-2">
                                     <div class="flex items-center gap-2">
                                         <img src="/images/logos/metacritic.svg" class="h-3 w-auto" alt="Metascore" />
                                         <span class="text-[8px] font-black text-text-muted uppercase tracking-widest">Metascore</span>
                                     </div>
                                     @if (!string.IsNullOrEmpty(Model.MetacriticUrl))
                                     {
                                         <a href="@Model.MetacriticUrl" target="_blank" class="text-[8px] font-black text-brand-primary hover:underline group-hover/stat:translate-x-0.5 transition-transform">Link <i class="fa-solid fa-external-link text-[6px]"></i></a>
                                     }
                                 </div>
                                 <div class="flex items-baseline gap-3">
                                    @{
                                        var consensusMetaColorClass = Model.MetacriticRating >= 61 ? "bg-metascore-high" : (Model.MetacriticRating >= 40 ? "bg-metascore-med" : "bg-metascore-low");
                                        if (Model.MetacriticRating == null) consensusMetaColorClass = "bg-surface-soft";
                                    }
                                    <span class="px-2 py-0.5 rounded text-lg font-black text-black @consensusMetaColorClass">@(Model.MetacriticRating?.ToString() ?? "N/A")</span>
                                    @if (Model.MetacriticUserScore.HasValue)
                                    {
                                        <div class="flex flex-col">
                                            <span class="text-[8px] font-black text-text-muted uppercase leading-none">User</span>
                                            <span class="text-sm font-black text-white leading-tight">@Model.MetacriticUserScore.Value.ToString("0.0")</span>
                                        </div>
                                    }
                                 </div>
                             </div>
                             <!-- Rotten Tomatoes Critics -->
                             <div class="p-3 rounded-xl bg-nav-surface/50 border border-white/5 hover:border-brand-primary/30 transition-all group/stat">
                                 <div class="flex items-center gap-2 mb-2">
                                     @if (Model.RottenTomatoesCriticRating >= 60)
                                     {
                                         <img src="/images/logos/rt.svg" class="h-3 w-auto" alt="Fresh" />
                                     }
                                     else if (Model.RottenTomatoesCriticRating != null)
                                     {
                                         <img src="/images/logos/rt_tomato_splat.svg" class="h-3 w-auto" alt="Rotten" />
                                     }
                                     else
                                     {
                                         <img src="/images/logos/rt.svg" class="h-3 w-auto grayscale opacity-50" alt="N/A" />
                                     }
                                     <span class="text-[8px] font-black text-text-muted uppercase tracking-widest">Tomatometer</span>
                                 </div>
                                 <span class="text-lg font-black text-white">@(Model.RottenTomatoesCriticRating?.ToString() ?? "N/A")%</span>
                             </div>
                             <!-- Rotten Tomatoes Audience -->
                             <div class="p-3 rounded-xl bg-nav-surface/50 border border-white/5 hover:border-brand-primary/30 transition-all group/stat">
                                 <div class="flex items-center gap-2 mb-2">
                                     @if (Model.RottenTomatoesAudienceRating >= 60)
                                     {
                                         <img src="/images/logos/rt_popcorn_fresh.svg" class="h-3 w-auto" alt="Fresh" />
                                     }
                                     else if (Model.RottenTomatoesAudienceRating != null)
                                     {
                                         <img src="/images/logos/rt_popcorn_splat.svg" class="h-3 w-auto" alt="Splat" />
                                     }
                                     else
                                     {
                                         <img src="/images/logos/rt_popcorn_fresh.svg" class="h-3 w-auto grayscale opacity-50" alt="N/A" />
                                     }
                                     <span class="text-[8px] font-black text-text-muted uppercase tracking-widest">Audience</span>
                                 </div>
                                 <span class="text-lg font-black text-white">@(Model.RottenTomatoesAudienceRating?.ToString() ?? "N/A")%</span>
                             </div>
                        </div>
                    </div>
            </div>
            </div>
            
            <div class="form-group-card p-8 border-l-4 border-l-brand-primary">
                <h3 class="text-sm font-black text-brand-primary uppercase tracking-[0.2em] mb-6">@Localizer["MovieFacts"]</h3>
                <div class="space-y-6">
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-3">@Localizer["Genre"]</span>
                        <div class="flex flex-wrap gap-2">
                             @if (Model.Genres?.Any() == true)
                             {
                                 @foreach (var genre in Model.Genres)
                                 {
                                     <span class="px-3 py-1 rounded-full bg-brand-primary/10 border border-brand-primary/20 text-[11px] font-black text-brand-primary hover:bg-brand-primary hover:text-white transition-all cursor-default">
                                         @genre.Name
                                     </span>
                                 }
                             }
                             else
                             {
                                 <span class="text-xs font-bold text-text-muted italic">Keine Genres hinterlegt</span>
                             }
                        </div>
                    </div>

                    @if (Model.Keywords?.Any() == true)
                    {
                        <div class="flex flex-col pt-2">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-3">Keywords & Tags</span>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var keyword in Model.Keywords)
                                {
                                    <span class="px-2 py-0.5 rounded-lg bg-surface-bright/5 border border-white/5 text-[9px] font-bold text-text-muted hover:text-white hover:border-white/20 transition-all cursor-default uppercase">
                                        #@keyword.Name
                                    </span>
                                }
                            </div>
                        </div>
                    }
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["OriginalTitle"]</span>
                        <span class="text-sm font-black text-text-main dark:text-white">@Model.OriginalTitle (@Model.OriginalLanguage?.ToUpper())</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Popularity"]</span>
                        <span class="text-sm font-black text-text-main dark:text-white">@(Model.Popularity?.ToString("0.0") ?? "N/A") (@Model.VoteCount @Localizer["Votes"])</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Release"]</span>
                        <span class="text-sm font-black text-text-main dark:text-white transition-colors">@(Model.Erscheinungsdatum.HasValue ? Model.Erscheinungsdatum.Value.ToString("dd.MM.yyyy") : Model.Erscheinungsjahr.ToString())</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Runtime"]</span>
                        <span class="text-sm font-black text-text-main dark:text-white transition-colors">@Model.Spieldauer @Localizer["MinSuffix"]</span>
                    </div>
                    @if (Model.Collection != null)
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["CollectionSeries"]</span>
                            <a asp-controller="Collection" asp-action="Details" asp-route-id="@Model.CollectionID" class="text-sm font-black text-brand-primary hover:text-brand-hover transition-colors">
                                @Model.Collection.Name
                            </a>
                        </div>
                    }
                    @if (Model.ProductionCompanies?.Any() == true)
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Studios"]</span>
                            <div class="flex flex-wrap gap-2 mt-1">
                                @foreach (var studio in Model.ProductionCompanies)
                                {
                                    <a asp-controller="ProductionCompany" asp-action="Details" asp-route-id="@studio.ProductionCompanyID" class="group/studio px-3 py-2 rounded-xl bg-surface-bright/5 border border-white/5 hover:border-brand-primary/30 transition-all flex flex-col gap-1">
                                        <div class="flex items-center gap-2">
                                            @if (!string.IsNullOrEmpty(studio.LogoUrl))
                                            {
                                                <img src="@studio.LogoUrl" alt="" class="w-4 h-4 object-contain" />
                                            }
                                            <span class="text-xs font-black text-text-main dark:text-white group-hover/studio:text-brand-primary transition-colors">@studio.Name</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(studio.Headquarters) || studio.FoundedYear.HasValue)
                                        {
                                            <span class="text-[9px] font-bold text-text-muted flex items-center gap-1">
                                                <i class="fa-solid fa-location-dot text-[8px]"></i> 
                                                @($"{studio.Headquarters}{(studio.FoundedYear.HasValue ? $" (Est. {studio.FoundedYear})" : "")}")
                                            </span>
                                        }
                                    </a>
                                }
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Status))
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Status"]</span>
                            <span class="text-sm font-black text-text-main dark:text-white">@Model.Status</span>
                        </div>
                    }
                    @if (Model.Budget.HasValue || Model.Revenue.HasValue)
                    {
                        var budgetVal = Model.Budget ?? 0;
                        var revenueVal = Model.Revenue ?? 0;
                        var roi = budgetVal > 0 ? (double)revenueVal / budgetVal : 0;
                        var isBlockbuster = roi >= 3.0;
                        var isProfitable = roi >= 1.0;
                        
                        <div class="flex flex-col pt-6 border-t border-glass-border/30 gap-6">
                            <span class="text-[10px] font-black text-brand-primary uppercase tracking-[0.2em] mb-1">📊 @Localizer["FinancialDashboard"]</span>
                            
                            <div class="grid grid-cols-2 gap-3">
                                <div class="p-4 rounded-2xl bg-surface-bright/5 border border-white/5 shadow-inner">
                                    <span class="text-[9px] text-text-muted uppercase font-black block mb-1">@Localizer["Budget"]</span>
                                    <span class="text-sm font-black text-text-main dark:text-white transition-colors">@(Model.Budget?.ToString("C0", new System.Globalization.CultureInfo("en-US")) ?? "N/A")</span>
                                </div>
                                <div class="p-4 rounded-2xl bg-surface-bright/5 border border-white/5 shadow-inner">
                                    <span class="text-[9px] text-text-muted uppercase font-black block mb-1">@Localizer["Revenue"]</span>
                                    <span class="text-sm font-black text-text-main dark:text-white transition-colors">@(Model.Revenue?.ToString("C0", new System.Globalization.CultureInfo("en-US")) ?? "N/A")</span>
                                </div>
                            </div>

                            <div class="p-4 rounded-2xl bg-brand-primary/5 border border-brand-primary/20 shadow-lg relative overflow-hidden group">
                                <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:scale-125 transition-transform duration-700">
                                    <i class="fa-solid fa-chart-line text-4xl text-brand-primary"></i>
                                </div>
                                <div class="flex items-center justify-between relative z-10">
                                    <div class="flex flex-col">
                                        <span class="text-[9px] text-text-muted uppercase font-black block mb-1">ROI Efficiency</span>
                                        <span class="text-xl font-black @(isBlockbuster ? "text-warning-primary" : isProfitable ? "text-success-primary" : "text-danger-primary") uppercase tracking-tighter">
                                            @(roi.ToString("P1"))
                                        </span>
                                    </div>
                                    <div class="text-right">
                                        <span class="block text-[10px] font-black @(isBlockbuster ? "text-warning-primary" : isProfitable ? "text-success-primary" : "text-danger-primary") uppercase px-3 py-1 rounded-full bg-black/30 border border-white/5">
                                            @(isBlockbuster ? "🏆 Blockbuster" : isProfitable ? "✅ PROFIT" : "❌ LOSS")
                                        </span>
                                    </div>
                                </div>
                                <div class="w-full h-1.5 bg-black/20 rounded-full mt-4 overflow-hidden shadow-inner">
                                    <div class="h-full @(isBlockbuster ? "bg-warning-primary" : isProfitable ? "bg-success-primary" : "bg-danger-primary") shadow-[0_0_15px_rgba(var(--brand-primary-rgb),0.5)] transition-all duration-1000" style="width: @(Math.Min(100, roi * 25))%"></div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- 📺 WATCH & BUY (COMMERCIAL HUB) -->
                    <div class="p-6 rounded-3xl bg-surface-bright/5 border border-white/5 space-y-6 shadow-2xl relative overflow-hidden group/hub">
                        <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-brand-primary/10 blur-[50px] group-hover/hub:bg-brand-primary/20 transition-all duration-1000"></div>
                        
                        <h4 class="text-[11px] font-black text-white uppercase tracking-[0.2em] flex items-center gap-2">
                            <i class="fa-solid fa-cart-shopping text-brand-primary"></i> Streaming & Commerce
                        </h4>

                        @if (Model.WatchProviders?.Any() == true)
                        {
                            <div class="space-y-4">
                                @foreach (var type in new[] { "flatrate", "rent", "buy" })
                                {
                                    var providers = Model.WatchProviders.Where(p => p.Type == type).OrderBy(p => p.DisplayPriority).ToList();
                                    if (providers.Any())
                                    {
                                        <div>
                                            <span class="text-[9px] font-black text-text-muted uppercase tracking-widest block mb-2">@(type == "flatrate" ? "STREAMING NOW" : type.ToUpper())</span>
                                            <div class="flex flex-wrap gap-2">
                                                @foreach (var p in providers)
                                                {
                                                    <div class="group/provider relative" title="@p.Name">
                                                        <img src="@p.LogoUrl" class="w-8 h-8 rounded-lg border border-white/10 hover:border-brand-primary/50 transition-all shadow-lg" alt="@p.Name" />
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        @if (Model.ExternalResources?.Any() == true)
                        {
                            <div class="pt-4 border-t border-white/5 space-y-3">
                                @foreach (var res in Model.ExternalResources)
                                {
                                    <a href="@res.Url" target="_blank" class="flex items-center justify-between p-3 rounded-2xl bg-white/5 border border-white/5 hover:bg-white/10 hover:border-brand-primary/30 transition-all group/res">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg bg-black border border-white/10 flex items-center justify-center">
                                                @if (res.Type == "Amazon") { <i class="fa-brands fa-amazon text-[#ff9900] text-lg"></i> }
                                                else { <i class="fa-solid fa-shop text-brand-primary"></i> }
                                            </div>
                                            <span class="text-xs font-black text-white group-hover/res:text-brand-primary transition-colors">@res.Label</span>
                                        </div>
                                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px] text-text-muted"></i>
                                    </a>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.LocalNasPath))
                        {
                            <div class="pt-4 border-t border-white/5">
                                <div class="p-4 rounded-2xl bg-success-primary/10 border border-success-primary/20 flex items-center justify-between shadow-lg group/nas">
                                    <div class="flex items-center gap-3 overflow-hidden">
                                        <div class="w-10 h-10 rounded-full bg-success-primary/20 flex items-center justify-center text-success-primary shrink-0">
                                            <i class="fa-solid fa-server animate-pulse"></i>
                                        </div>
                                        <div class="flex flex-col min-w-0">
                                            <span class="text-[10px] font-black text-success-primary uppercase">NAS ONLINE</span>
                                            <span class="text-[9px] font-bold text-text-muted truncate" title="@Model.LocalNasPath">@Model.LocalNasPath</span>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-primary !p-2 !rounded-lg text-[10px] ml-2 shrink-0" title="Copy Path" onclick="navigator.clipboard.writeText('@Model.LocalNasPath.Replace("\\", "\\\\")').then(() => alert('Path copied!'))">
                                        <i class="fa-solid fa-copy"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.ProductionCountries?.Any() == true)
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["ProductionCountries"]</span>
                            <span class="text-xs font-black text-text-main dark:text-white">@(string.Join(", ", Model.ProductionCountries.Select(c => c.Name)))</span>
                        </div>
                    }
                    @if (Model.SpokenLanguages?.Any() == true)
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["SpokenLanguages"]</span>
                            <span class="text-xs font-black text-text-main dark:text-white">@(string.Join(", ", Model.SpokenLanguages.Select(l => l.Name)))</span>
                        </div>
                    }

                    <!-- 🌀 FANATIC RATINGS MONITOR -->
                    <div class="p-6 rounded-3xl bg-surface-bright/5 border border-white/5 space-y-5 shadow-2xl overflow-hidden relative group">
                        <div class="absolute -top-10 -right-10 w-32 h-32 bg-brand-primary/10 blur-[50px] group-hover:bg-brand-primary/20 transition-all duration-1000"></div>
                        
                        <h4 class="text-[11px] font-black text-white uppercase tracking-[0.2em] mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-gauge-high text-brand-primary"></i> @Localizer["RatingsMatrix"]
                        </h4>

                        <!-- TMDB -->
                        <div class="space-y-1">
                            <div class="flex items-center justify-between text-[10px]">
                                 <div class="flex items-center gap-2">
                                     <img src="/images/logos/tmdb.svg" class="h-2 w-auto" alt="TMDB" />
                                     <span class="font-black text-text-muted uppercase">The Movie DB</span>
                                 </div>
                                <span class="font-black text-white">@((Model.VoteAverage ?? 0).ToString("0.0"))<span class="text-text-muted">/10</span></span>
                            </div>
                            <div class="h-1 bg-black/30 rounded-full overflow-hidden">
                                <div class="h-full bg-[#01d277] shadow-[0_0_8px_rgba(1,210,119,0.5)]" style="width: @((Model.VoteAverage ?? 0) * 10)%"></div>
                            </div>
                        </div>

                        <!-- TVDB -->
                        <div class="space-y-1">
                            <div class="flex items-center justify-between text-[10px]">
                                <div class="flex items-center gap-2">
                                    <img src="/images/logos/tvdb.svg" class="h-2 w-auto opacity-80" alt="TVDB" />
                                    <span class="font-black text-text-muted uppercase">The TVDB</span>
                                </div>
                                <span class="font-black text-white">@((Model.TvdbRating ?? 0).ToString("0.0"))<span class="text-text-muted">/10</span></span>
                            </div>
                            <div class="h-1 bg-black/30 rounded-full overflow-hidden">
                                <div class="h-full bg-brand-primary shadow-[0_0_8px_rgba(var(--brand-primary-rgb),0.5)]" style="width: @((Model.TvdbRating ?? 0) * 10)%"></div>
                            </div>
                        </div>

                        <!-- IMDB (Global) -->
                        <div class="space-y-1">
                            <div class="flex items-center justify-between text-[10px]">
                                 <div class="flex items-center gap-2">
                                     <img src="/images/logos/imdb.svg" class="h-2 w-auto" alt="IMDb" />
                                     <span class="font-black text-text-muted uppercase">IMDb (Global)</span>
                                 </div>
                                <span class="font-black text-white">@(Model.ImdbId != null ? (Model.ImdbRating?.ToString("0.0") ?? "N/A") : "N/A")<span class="text-text-muted">/10</span></span>
                            </div>
                            <div class="h-1 bg-black/30 rounded-full overflow-hidden">
                                <div class="h-full bg-[#f5c518] shadow-[0_0_8px_rgba(245,197,24,0.5)]" style="width: @((Model.ImdbRating ?? 0) * 10)%"></div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-3 pt-4">
                             <!-- RT Tomato -->
                             <div class="flex items-center justify-between p-3 rounded-2xl bg-white/5 border border-white/5 group/rt hover:bg-white/10 transition-all">
                                 <div class="flex items-center gap-3">
                                     <div class="w-8 h-8 rounded-lg bg-[#fa320a]/5 flex items-center justify-center">
                                         @{
                                             var isFreshMatrix = (Model.RottenTomatoesCriticRating ?? 0) >= 60;
                                             var tomatoMatrixLogo = isFreshMatrix ? "/images/logos/rt.svg" : "/images/logos/rt_tomato_splat.svg";
                                             if (Model.RottenTomatoesCriticRating == null) tomatoMatrixLogo = "/images/logos/rt.svg";
                                         }
                                         <img src="@tomatoMatrixLogo" class="h-4 w-auto @(Model.RottenTomatoesCriticRating == null ? "grayscale opacity-30" : "")" alt="RT" />
                                     </div>
                                     <div class="flex flex-col">
                                         <span class="text-[10px] font-black text-white uppercase tracking-wider">Tomato @(isFreshMatrix ? "Fresh" : "Rotten")</span>
                                         <span class="text-[8px] font-bold text-text-muted uppercase">RT Critics</span>
                                     </div>
                                 </div>
                                 <span class="text-sm font-black text-white">@(Model.RottenTomatoesCriticRating?.ToString() ?? "N/A")%</span>
                             </div>

                             <!-- RT Audience -->
                             <div class="flex items-center justify-between p-3 rounded-2xl bg-white/5 border border-white/5 group/rta hover:bg-white/10 transition-all">
                                 <div class="flex items-center gap-3">
                                     <div class="w-8 h-8 rounded-lg bg-[#fa320a]/5 flex items-center justify-center">
                                         @{
                                             var isFullMatrix = (Model.RottenTomatoesAudienceRating ?? 0) >= 60;
                                             var audienceMatrixLogo = isFullMatrix ? "/images/logos/rt_popcorn_fresh.svg" : "/images/logos/rt_popcorn_splat.svg";
                                             if (Model.RottenTomatoesAudienceRating == null) audienceMatrixLogo = "/images/logos/rt_popcorn_fresh.svg";
                                         }
                                         <img src="@audienceMatrixLogo" class="h-4 w-auto @(Model.RottenTomatoesAudienceRating == null ? "grayscale opacity-30" : "")" alt="Popcorn" />
                                     </div>
                                     <div class="flex flex-col">
                                         <span class="text-[10px] font-black text-white uppercase tracking-wider">@(isFullMatrix ? "Popcorn" : "Splat")</span>
                                         <span class="text-[8px] font-bold text-text-muted uppercase">RT Audience</span>
                                     </div>
                                 </div>
                                 <span class="text-sm font-black text-white">@(Model.RottenTomatoesAudienceRating?.ToString() ?? "N/A")%</span>
                             </div>

                             <!-- Metascore -->
                             <div class="flex items-center justify-between p-3 rounded-2xl bg-white/5 border border-white/5 group/meta hover:bg-white/10 transition-all">
                                 <div class="flex items-center gap-3">
                                     <div class="w-8 h-8 rounded-lg bg-black border border-white/20 flex items-center justify-center overflow-hidden">
                                         <img src="/images/logos/metacritic.svg" class="h-5 w-auto object-contain" alt="Metacritic" />
                                     </div>
                                     <div class="flex flex-col">
                                         <span class="text-[10px] font-black text-white uppercase tracking-wider">Metascore</span>
                                         <span class="text-[8px] font-bold text-text-muted uppercase">Global Critics</span>
                                     </div>
                                 </div>
                                 @{
                                     var matrixMetaColor = Model.MetacriticRating >= 61 ? "text-[#6c3]" : (Model.MetacriticRating >= 40 ? "text-[#fc3]" : "text-[#f33]");
                                     if (Model.MetacriticRating == null) matrixMetaColor = "text-white";
                                 }
                                 <span class="text-sm font-black @matrixMetaColor">@(Model.MetacriticRating?.ToString() ?? "N/A")</span>
                             </div>
                        </div>
                        
                        <div class="pt-2">
                            <p class="text-[8px] text-text-muted italic leading-tight">@Localizer["SyncNote"]</p>
                        </div>
                    </div>
                    
                    <div class="pt-6 border-t border-border-muted dark:border-dark-border">
                        <div class="flex flex-wrap gap-4">
                            @if (!string.IsNullOrEmpty(Model.ImdbId))
                            {
                                <a href="https://www.imdb.com/title/@Model.ImdbId" target="_blank" class="w-8 h-8 rounded-lg bg-accent-imdb text-black flex items-center justify-center font-black transition-transform hover:scale-110 shadow-lg" title="IMDb">
                                    <i class="fa-brands fa-imdb text-xl"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.FacebookId))
                            {
                                <a href="https://facebook.com/@Model.FacebookId" target="_blank" class="w-8 h-8 rounded-lg bg-accent-facebook text-white flex items-center justify-center transition-transform hover:scale-110 shadow-lg">
                                    <i class="fa-brands fa-facebook-f"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.InstagramId))
                            {
                                <a href="https://instagram.com/@Model.InstagramId" target="_blank" class="w-8 h-8 rounded-lg bg-linear-to-tr from-accent-instagram-from via-accent-instagram-via to-accent-instagram-to text-white flex items-center justify-center transition-transform hover:scale-110 shadow-lg">
                                    <i class="fa-brands fa-instagram"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.TwitterId))
                            {
                                <a href="https://twitter.com/@Model.TwitterId" target="_blank" class="w-8 h-8 rounded-lg bg-accent-twitter text-white flex items-center justify-center transition-transform hover:scale-110 shadow-lg">
                                    <i class="fa-brands fa-x-twitter"></i>
                                </a>
                            }
                             @if (!string.IsNullOrEmpty(Model.WikidataId))
                            {
                                <a href="https://www.wikidata.org/wiki/@Model.WikidataId" target="_blank" class="w-8 h-8 rounded-lg bg-surface-bright text-text-main flex items-center justify-center transition-transform hover:scale-110 shadow-lg border border-border-muted" title="Wikidata">
                                    <i class="fa-solid fa-barcode"></i>
                                </a>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Homepage))
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Website"]</span>
                            <a href="@Model.Homepage" target="_blank" class="text-xs font-black text-brand-primary hover:text-brand-hover transition-colors truncate">
                                <i class="fa-solid fa-link mr-1"></i> @Model.Homepage
                            </a>
                        </div>
                    }
                </div>
            </div>

            @if (Model.Keywords?.Any() == true)
            {
                <div class="form-group-card p-8">
                    <h3 class="text-xs font-black text-text-muted uppercase tracking-widest mb-4">@Localizer["Tags"]</h3>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var fk in Model.Keywords)
                        {
                            <span class="px-2 py-1 rounded-lg bg-surface-muted dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-[10px] font-bold text-text-description dark:text-dark-text-muted uppercase tracking-tighter">
                                #@fk.Name
                            </span>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Right: Content & Metadata -->
        <div class="lg:col-span-2 space-y-16">
            <header>
                <div class="badge-premium px-3 py-1 mb-4">
                    <i aria-hidden="true" class="fa-solid fa-hashtag text-brand-primary"></i> @Model.FilmID
                </div>
                @if (string.IsNullOrEmpty(Model.BackdropUrl))
                {
                    <h1 class="text-5xl md:text-6xl font-black tracking-tighter text-text-main dark:text-white leading-none transition-colors">@Model.Titel</h1>
                    @if (!string.IsNullOrEmpty(Model.Tagline))
                    {
                        <p class="mt-4 text-2xl font-black text-brand-primary/80 italic tracking-tight transition-colors">@Model.Tagline</p>
                    }
                }
                <p class="mt-6 text-xl text-text-description dark:text-dark-text-muted font-medium italic transition-colors leading-relaxed">
                    @(string.Join(", ", Model.Genres?.Select(g => g.Name).Where(n => !string.IsNullOrEmpty(n)) ?? Array.Empty<string>())) &bull; @Model.Erscheinungsjahr
                </p>
            </header>


            @if (!string.IsNullOrEmpty(Model.ProductionNotes))
            {
                <section>
                    <div class="glass-premium p-8 rounded-3xl border border-accent-info/20 flex items-start gap-6 shadow-2xl bg-accent-info/5">
                        <div class="w-16 h-16 rounded-full bg-accent-info/10 flex items-center justify-center text-accent-info text-3xl shrink-0">
                            <i class="fa-solid fa-lightbulb"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-black text-accent-info uppercase tracking-[0.25em] mb-3">@Localizer["ProductionInsights"]</h3>
                            <div class="space-y-2">
                                @foreach (var note in Model.ProductionNotes.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <div class="flex items-center gap-2">
                                        <span class="w-1.5 h-1.5 rounded-full bg-accent-info/40"></span>
                                        <p class="text-sm font-bold text-text-description dark:text-dark-text-muted">@note</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </section>
            }

            <section>
                <div class="form-group-header !mb-6">
                    <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["Plot"]</h2>
                    <div class="h-1 w-12 bg-brand-primary rounded-full transition-colors"></div>
                </div>
                <p class="text-lg text-text-description dark:text-dark-text-muted leading-relaxed pl-8 border-l-4 border-border-muted dark:border-dark-border transition-colors">
                    @Model.Handlung
                </p>
            </section>

            <!-- Metadata Fanatic Tabs/Sections -->
            <div class="space-y-12">
                @if (Model.Releases?.Any() == true)
                {
                    <section>
                        <div class="form-group-header !mb-6">
                            <h2 class="text-xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["GlobalReleases"]</h2>
                            <div class="h-1 w-8 bg-brand-primary rounded-full"></div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                            @foreach (var rel in Model.Releases.OrderBy(r => r.ReleaseDate))
                            {
                                <div class="glass-premium p-5 rounded-2xl border border-glass-border/30 flex flex-col justify-between group hover:bg-white/5 transition-all">
                                    <div class="flex items-start justify-between mb-4">
                                        <div class="flex items-center gap-3">
                                            <img src="https://flagcdn.com/w40/@(rel.Iso3166_1.ToLower()).png" 
                                                 alt="@rel.Iso3166_1" 
                                                 class="w-6 h-4 object-cover rounded shadow-sm" />
                                            <div>
                                                <p class="text-[10px] font-black text-brand-primary uppercase tracking-widest leading-none mb-1">
                                                    @(countryDict.TryGetValue(rel.Iso3166_1, out var cName) ? cName : rel.Iso3166_1)
                                                </p>
                                                <p class="text-xs font-black text-white">@rel.ReleaseDate?.ToString("dd.MM.yyyy")</p>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(rel.Certification))
                                        {
                                            var logo = GetRatingLogo(rel.Iso3166_1, rel.Certification);
                                            if (logo != null)
                                            {
                                                <img src="@logo" class="h-6 w-auto object-contain brightness-100 group-hover:scale-110 transition-transform" alt="@rel.Certification" />
                                            }
                                            else
                                            {
                                                <span class="px-2 py-0.5 rounded bg-surface-muted dark:bg-dark-surface-soft text-[9px] font-black uppercase border border-border-muted text-white">@rel.Certification</span>
                                            }
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(rel.Note))
                                    {
                                        <p class="text-[9px] font-bold text-text-muted italic leading-tight group-hover:text-dark-text-muted transition-colors">@rel.Note</p>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (Model.AlternativeTitles?.Any() == true)
                {
                    <section>
                        <div class="form-group-header !mb-6">
                            <h2 class="text-xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["AlternativeTitles"]</h2>
                            <div class="h-1 w-8 bg-brand-primary rounded-full"></div>
                        </div>
                        <div class="max-h-48 overflow-y-auto pr-4 scrollbar-premium">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2">
                                @foreach (var alt in Model.AlternativeTitles)
                                {
                                    <div class="flex items-center justify-between py-2 border-b border-glass-border/10">
                                        <span class="text-xs font-bold text-text-main dark:text-white">@alt.Title</span>
                                        <span class="text-[9px] font-black text-text-muted uppercase">@alt.Iso3166_1</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </section>
                }
            </div>

            <!-- Accolades & Recognition -->
            @if (Model.FilmAwards?.Any() == true)
            {
                <section class="mb-12">
                    <div class="form-group-header !mb-6">
                        <h2 class="text-xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["AccoladesAndRecognition"]</h2>
                        <div class="h-1 w-8 bg-brand-primary rounded-full mt-2"></div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var award in Model.FilmAwards.OrderByDescending(a => a.Year))
                        {
                            <div class="glass-premium p-4 rounded-xl border border-glass-border flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-brand-primary/10 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-trophy text-brand-primary"></i>
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-[10px] font-black text-brand-primary uppercase">@award.Year</span>
                                        @if (award.IsWin)
                                        {
                                            <span class="px-1.5 py-0.5 rounded bg-green-500/10 text-green-500 text-[8px] font-black uppercase">Winner</span>
                                        }
                                        else
                                        {
                                            <span class="px-1.5 py-0.5 rounded bg-orange-500/10 text-orange-500 text-[8px] font-black uppercase">Nomination</span>
                                        }
                                    </div>
                                    <p class="text-sm font-black text-text-main dark:text-white truncate">@award.Name</p>
                                    <p class="text-[10px] font-bold text-text-muted truncate">@award.Category</p>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            @if (Model.BoxOfficeEntries?.Any() == true)
            {
                <section>
                    <div class="form-group-header !mb-8">
                        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["BoxOfficeHistory"]</h2>
                        <div class="h-1 w-12 bg-success-primary rounded-full mt-2"></div>
                    </div>
                    
                    <div class="glass-premium p-6 rounded-3xl border border-glass-border shadow-2xl space-y-3">
                        @foreach (var entry in Model.BoxOfficeEntries.OrderBy(e => e.Date))
                        {
                            <div class="flex items-center justify-between p-4 rounded-2xl bg-white/5 border border-white/5 hover:bg-white/10 transition-all group/box">
                                <div class="flex flex-col">
                                    <span class="text-[10px] font-black text-text-muted uppercase tracking-widest">@entry.Date.ToString("MMMM yyyy") &bull; @entry.Region</span>
                                    <span class="text-sm font-black text-white group-hover/box:text-brand-primary transition-colors">@entry.EntryType</span>
                                </div>
                                <div class="text-right flex flex-col items-end">
                                    <span class="text-lg font-black text-success-primary tracking-tighter">@entry.Revenue.ToString("C0", new System.Globalization.CultureInfo("en-US"))</span>
                                    @if (Model.Budget.HasValue && Model.Budget > 0)
                                    {
                                        <span class="text-[9px] font-bold text-text-muted italic">@(( (double)entry.Revenue / Model.Budget.Value).ToString("P0")) of Budget</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            @if (!string.IsNullOrEmpty(Model.TrailerUrl))
            {
                <section>
                    <div class="form-group-header !mb-8">
                        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["Trailer"]</h2>
                        <div class="h-1 w-12 bg-brand-primary rounded-full mt-1"></div>
                    </div>
                    
                    <div class="card-glass overflow-hidden aspect-video border border-border-default dark:border-dark-border shadow-2xl relative group">
                        <iframe width="100%" height="100%" 
                                src="@Model.TrailerUrl" 
                                title='@Localizer["TrailerPlayerTitle"]' 
                                frameborder="0" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                                referrerpolicy="strict-origin-when-cross-origin" 
                                allowfullscreen
                                class="rounded-2xl"></iframe>
                        
                        <div class="absolute inset-x-0 -bottom-1 h-2 bg-brand-primary opacity-50 group-hover:opacity-100 transition-opacity blur-sm"></div>
                    </div>
                </section>
            }

            <!-- Metacritic Deep Reviews -->
            @if (Model.MetacriticReviews?.Any() == true)
            {
                <section class="mb-16">
                    <div class="form-group-header !mb-10 flex items-center justify-between">
                        <div>
                            <h2 class="text-3xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["ExpertCritique"]</h2>
                            <div class="h-1.5 w-24 bg-metascore-high rounded-full mt-3 shadow-[0_0_15px_#6c3]"></div>
                        </div>
                        <div class="flex items-center gap-4">
                            <img src="/images/logos/metacritic.svg" class="h-6 w-auto grayscale opacity-50 contrast-125" alt="" />
                            <span class="badge-premium !bg-metascore-bg !text-metascore-high border-metascore-high/50">@Model.MetacriticReviews.Count Reviews</span>
                        </div>
                    </div>

                    <div class="space-y-6">
                        @foreach (var review in Model.MetacriticReviews)
                        {
                            <div class="glass-premium p-8 rounded-[2.5rem] border border-white/5 relative overflow-hidden group/review hover:border-brand-primary/20 transition-all duration-500">
                                <div class="absolute -top-10 -right-10 w-40 h-40 bg-brand-primary/5 blur-[60px] group-hover/review:bg-brand-primary/10 transition-all duration-1000"></div>
                                
                                <div class="flex flex-col md:flex-row md:items-start gap-8 relative z-10">
                                    <div class="shrink-0 flex flex-col items-center">
                                        @{
                                            var scoreColor = review.Score >= 61 ? "bg-metascore-high" : (review.Score >= 40 ? "bg-metascore-med" : "bg-metascore-low");
                                            if (review.Score == null) scoreColor = "bg-surface-soft";
                                        }
                                        <div class="w-16 h-16 rounded-2xl @scoreColor flex items-center justify-center shadow-2xl shadow-black/20 group-hover/review:scale-110 transition-transform duration-500">
                                            <span class="text-2xl font-black text-black">@(review.Score?.ToString() ?? "?")</span>
                                        </div>
                                        <div class="mt-4 h-12 w-px bg-linear-to-b from-white/20 to-transparent md:block hidden"></div>
                                    </div>

                                    <div class="flex-1 space-y-4">
                                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                            <div class="flex flex-col">
                                                <h4 class="text-lg font-black text-white leading-none">@review.Publication</h4>
                                                @if (!string.IsNullOrEmpty(review.Author))
                                                {
                                                    <span class="text-[10px] font-bold text-brand-primary uppercase tracking-widest mt-1">By @review.Author</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(review.ReviewUrl))
                                            {
                                                <a href="@review.ReviewUrl" target="_blank" class="px-4 py-2 rounded-xl bg-white/5 border border-white/5 hover:bg-brand-primary/10 hover:border-brand-primary/30 text-[10px] font-black text-text-muted hover:text-white transition-all uppercase tracking-widest flex items-center gap-2">
                                                    Full Review <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                                </a>
                                            }
                                        </div>

                                        <blockquote class="text-lg text-text-white-bright leading-relaxed italic border-l-4 border-white/5 pl-6 py-2">
                                            "@review.Content"
                                        </blockquote>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- Cast & Crew Section -->
            <section>
                <div class="form-group-header !mb-8 flex items-center justify-between">
                    <div>
                        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["CastTeam"]</h2>
                        <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
                    </div>
                    <span class="badge-outline">@Model.PersonEigenschaftFilme.Count @Localizer["ContributorsCount"]</span>
                </div>

                <div class="space-y-12">
                    @foreach (var group in Model.PersonEigenschaftFilme.GroupBy(p => p.Eigenschaft.Bezeichnung))
                    {
                        <div>
                            <h3 class="text-[10px] font-black text-brand-primary uppercase tracking-[0.2em] mb-4 px-2">@group.Key</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                @foreach (var participation in group)
                                {
                                    <a asp-controller="Person" asp-action="Details" asp-route-id="@participation.PersonID" 
                                       class="card-premium flex items-center p-4 group hover:border-brand-primary/30 transition-all bg-surface-subtle/30 dark:bg-dark-surface/30">
                                        <div class="w-12 h-12 rounded-lg overflow-hidden shrink-0 border border-border-muted dark:border-dark-border group-hover:shadow-lg transition-all">
                                            @if (!string.IsNullOrEmpty(participation.Person.ProfilBildUrl))
                                            {
                                                <img src="@participation.Person.ProfilBildUrl" alt="@participation.Person.Vorname @participation.Person.Nachname" class="w-full h-full object-cover transition-transform group-hover:scale-110" />
                                            }
                                            else
                                            {
                                                <div class="w-full h-full flex items-center justify-center bg-surface-muted dark:bg-dark-surface-soft">
                                                    <i aria-hidden="true" class="fa-solid fa-user text-lg text-text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="ml-4 flex-grow min-w-0">
                                            <p class="text-sm font-black text-text-main dark:text-white group-hover:text-brand-primary transition-colors truncate">@participation.Person.Vorname @participation.Person.Nachname</p>
                                            
                                            <div class="flex items-center gap-2 mt-1">
                                                @if (!string.IsNullOrEmpty(participation.Person.Geburtsort))
                                                {
                                                    <span class="text-[9px] font-bold text-text-muted truncate">
                                                        <i class="fa-solid fa-map-pin text-[7px] mr-1"></i> @participation.Person.Geburtsort
                                                    </span>
                                                }
                                                @if (!string.IsNullOrEmpty(participation.Person.Tags))
                                                {
                                                    <span class="text-[9px] font-black text-brand-primary/60 uppercase tracking-tighter">
                                                        @participation.Person.Tags
                                                    </span>
                                                }
                                            </div>

                                            @if (!string.IsNullOrEmpty(participation.Person.InstagramId) || !string.IsNullOrEmpty(participation.Person.TwitterId))
                                            {
                                                <div class="flex gap-2 mt-2">
                                                    @if (!string.IsNullOrEmpty(participation.Person.InstagramId))
                                                    {
                                                        <span class="text-[9px] text-text-muted hover:text-[#E4405F] transition-colors"><i class="fa-brands fa-instagram"></i></span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(participation.Person.TwitterId))
                                                    {
                                                        <span class="text-[9px] text-text-muted hover:text-[#1DA1F2] transition-colors"><i class="fa-brands fa-x-twitter"></i></span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <i aria-hidden="true" class="fa-solid fa-chevron-right ml-auto text-border-default dark:text-dark-surface-muted transition-transform group-hover:translate-x-1 text-xs px-2"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            @if (Model.SimilarFilms?.Any() == true)
            {
                <section>
                    <div class="form-group-header !mb-8">
                        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["SimilarFilms"]</h2>
                        <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                        @foreach (var sim in Model.SimilarFilms.Take(4))
                        {
                            <a asp-action="Details" asp-route-id="@sim.FilmID" class="group block">
                                <div class="aspect-[2/3] rounded-xl overflow-hidden border border-border-muted transition-all group-hover:border-brand-primary shadow-sm hover:shadow-xl">
                                    <img src="@sim.PosterUrl" alt="@sim.Titel" class="w-full h-full object-cover transition-transform group-hover:scale-110" />
                                </div>
                                <p class="mt-2 text-[10px] font-black text-text-main dark:text-white truncate">@sim.Titel</p>
                            </a>
                        }
                    </div>
                </section>
            }

            @if (Model.RecommendedFilms?.Any() == true)
            {
                <section>
                    <div class="form-group-header !mb-8">
                        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["RecommendedFilms"]</h2>
                        <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                        @foreach (var rec in Model.RecommendedFilms.Take(4))
                        {
                            <a asp-action="Details" asp-route-id="@rec.FilmID" class="group block">
                                <div class="aspect-[2/3] rounded-xl overflow-hidden border border-border-muted transition-all group-hover:border-brand-primary shadow-sm hover:shadow-xl">
                                    <img src="@rec.PosterUrl" alt="@rec.Titel" class="w-full h-full object-cover transition-transform group-hover:scale-110" />
                                </div>
                                <p class="mt-2 text-[10px] font-black text-text-main dark:text-white truncate">@rec.Titel</p>
                            </a>
                        }
                    </div>
                </section>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/favorites.js"></script>
}
