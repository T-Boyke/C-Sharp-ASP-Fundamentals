@model _10_Filmdatenbank.Domain.Entities.Film
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject _10_Filmdatenbank.Infrastructure.Persistence.ApplicationDbContext _db

@{
    ViewData["Title"] = Model.Titel;
    var userId = UserManager.GetUserId(User);
    var isFavorite = userId != null && _db.FavoriteFilms.Any(ff => ff.FilmID == Model.FilmID && ff.UserID == userId);
}

<div class="mx-auto max-w-7xl px-6 lg:px-8 py-16">
    <!-- Breadcrumb & Back -->
    <nav class="flex mb-8 items-center gap-4 text-sm font-bold text-text-muted uppercase tracking-widest" aria-label='@Localizer["Breadcrumb"]'>
        <a asp-action="Index" class="nav-link">
            <i aria-hidden="true" class="fa-solid fa-arrow-left"></i> @Localizer["Catalog"]
        </a>
        <span class="h-1 w-1 rounded-full bg-border-default"></span>
    </nav>
    
    @if (!string.IsNullOrEmpty(Model.BackdropUrl))
    {
        <div class="relative w-full h-64 md:h-96 rounded-3xl overflow-hidden mb-12 group shadow-2xl" aria-hidden="true">
            <img src="@Model.BackdropUrl" alt="" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
            <div class="absolute inset-0 bg-linear-to-t from-dark-surface via-dark-surface-soft/40 to-transparent"></div>
            <div class="absolute bottom-8 left-8 right-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                    <div class="badge-premium px-3 py-1 mb-4 inline-flex">
                        <i aria-hidden="true" class="fa-solid fa-hashtag text-brand-primary"></i> @Model.FilmID
                        @if (Model.TmdbId.HasValue)
                        {
                            <span class="mx-2 text-white-a20">|</span>
                            <span class="text-[10px] font-black text-text-white-muted uppercase tracking-widest">TMDB: @Model.TmdbId</span>
                        }
                    </div>
                   <h1 class="text-4xl md:text-6xl font-black text-white tracking-tighter drop-shadow-2xl">@Model.Titel</h1>
                   @if (!string.IsNullOrEmpty(Model.Tagline))
                   {
                       <p class="mt-2 text-xl md:text-2xl font-bold text-brand-primary italic drop-shadow-lg">@Model.Tagline</p>
                   }
                </div>
                    <div class="flex items-center gap-4">
                        <button type="button" 
                                class="favorite-toggle glass-premium w-16 h-16 rounded-2xl flex items-center justify-center transition-all group/heart @(isFavorite ? "text-danger-primary shadow-2xl shadow-danger-primary/20" : "text-text-white-muted hover:text-white hover:bg-glass-bg-hover")" 
                                data-film-id="@Model.FilmID" 
                                data-url="@Url.Action("ToggleFavorite", "Film", new { filmId = Model.FilmID })"
                                title='@(isFavorite ? Localizer["RemoveFromWatchlist"] : Localizer["AddToWatchlist"])'>
                            <i class="fa-@(isFavorite ? "solid" : "regular") fa-heart text-2xl group-hover/heart:scale-110 transition-transform"></i>
                        </button>
                        <div class="glass-premium px-6 py-3 rounded-2xl flex items-center gap-3 border border-surface-bright/20">
                        <div class="w-10 h-10 rounded-full bg-brand-primary flex items-center justify-center text-white shadow-lg">
                            <i class="fa-solid fa-star"></i>
                        </div>
                        <div>
                            <p class="text-[10px] font-black text-text-white-muted uppercase tracking-widest">@Localizer["TmdbScore"]</p>
                            <p class="text-xl font-black text-white">@(Model.VoteAverage?.ToString("0.0") ?? "N/A")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <!-- Left: Poster / Key Info -->
        <div class="lg:col-span-1 space-y-8">
            <div class="card-premium overflow-hidden group">
                <div class="aspect-[2/3] bg-surface-subtle dark:bg-dark-surface-soft flex items-center justify-center transition-colors relative" aria-hidden="true">
                    @if (!string.IsNullOrEmpty(Model.PosterUrl))
                    {
                        <img src="@Model.PosterUrl" alt='@Localizer["PosterOf", Model.Titel]' class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                    }
                    else
                    {
                        <i aria-hidden="true" class="fa-solid fa-film text-text-muted dark:text-dark-surface-muted text-9xl"></i>
                    }
                    
                    <div class="absolute inset-x-0 bottom-0 p-8 bg-linear-to-t from-dark-surface/80 via-dark-surface/40 to-transparent">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-brand-primary/90 backdrop-blur-md text-white shadow-xl shadow-brand-shadow-lg border border-brand-primary/50"
                                 aria-label='@Localizer["Rating"]: @(Model.Nutzerwertung?.ToString("0.0") ?? "N/A")'>
                                <i aria-hidden="true" class="fa-solid fa-star text-[10px] text-star-primary"></i>
                                <span class="text-xs font-black tracking-tighter">@(Model.Nutzerwertung?.ToString("0.0") ?? "N/A")</span>
                            </div>
                             @{
                                 var primaryRelease = Model.Releases?.FirstOrDefault();
                                 if (primaryRelease != null)
                                 {
                                    <span class="px-2 py-1 rounded bg-dark-surface/80 backdrop-blur-md text-[10px] font-black text-white border border-glass-border uppercase tracking-tighter">
                                        @primaryRelease.Certification
                                    </span>
                                 }
                             }
                        </div>
                    </div>
                </div>
                <div class="p-8 space-y-6 bg-surface-overlay dark:bg-dark-surface-soft transition-colors">
                    <div>
                        <h3 class="text-xs font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest mb-4">@Localizer["Pricing"]</h3>
                        <div class="flex items-baseline gap-2 text-3xl font-black text-text-main dark:text-white transition-colors">
                            @Model.Preis.ToString("C")
                            <span class="text-sm font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-tighter">@Localizer["IncVat"]</span>
                        </div>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="pt-6 border-t border-border-muted dark:border-dark-border flex gap-4 transition-colors">
                            <a asp-action="Edit" asp-route-id="@Model.FilmID" class="btn-primary flex-1 shadow-lg shadow-brand-shadow" aria-label='@Localizer["Edit"]'>
                                <i aria-hidden="true" class="fa-solid fa-pen-to-square mr-2"></i> @Localizer["Edit"]
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.FilmID" class="btn-danger p-2.5 shadow-lg shadow-danger-primary/20" aria-label='@Localizer["Delete"]' title='@Localizer["Delete"]'>
                                <i aria-hidden="true" class="fa-solid fa-trash-can"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
            
            <div class="form-group-card p-8 border-l-4 border-l-brand-primary">
                <h3 class="text-sm font-black text-brand-primary uppercase tracking-[0.2em] mb-6">@Localizer["MovieFacts"]</h3>
                <div class="space-y-6">
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Genre"]</span>
                        <span class="text-sm font-black text-text-main dark:text-white transition-colors">
                            @(string.Join(", ", Model.Genres?.Select(g => g.Name).Where(n => !string.IsNullOrEmpty(n)) ?? Array.Empty<string>()))
                        </span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["OriginalTitle"]</span>
                        <span class="text-sm font-black text-text-main dark:text-white">@Model.OriginalTitle (@Model.OriginalLanguage?.ToUpper())</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Popularity"]</span>
                        <span class="text-sm font-black text-text-main dark:text-white">@(Model.Popularity?.ToString("0.0") ?? "N/A") (@Model.VoteCount @Localizer["Votes"])</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Release"]</span>
                        <span class="text-sm font-black text-text-main dark:text-white transition-colors">@(Model.Erscheinungsdatum.HasValue ? Model.Erscheinungsdatum.Value.ToString("dd.MM.yyyy") : Model.Erscheinungsjahr.ToString())</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Runtime"]</span>
                        <span class="text-sm font-black text-text-main dark:text-white transition-colors">@Model.Spieldauer @Localizer["MinSuffix"]</span>
                    </div>
                    @if (Model.Collection != null)
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["CollectionSeries"]</span>
                            <a asp-controller="Collection" asp-action="Details" asp-route-id="@Model.CollectionID" class="text-sm font-black text-brand-primary hover:text-brand-hover transition-colors">
                                @Model.Collection.Name
                            </a>
                        </div>
                    }
                    @if (Model.ProductionCompanies?.Any() == true)
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Studios"]</span>
                            <div class="flex flex-wrap gap-2 mt-1">
                                @foreach (var studio in Model.ProductionCompanies)
                                {
                                    <a asp-controller="ProductionCompany" asp-action="Details" asp-route-id="@studio.ProductionCompanyID" class="text-xs font-bold text-text-main dark:text-white hover:text-brand-primary transition-colors flex items-center gap-1">
                                        @if (!string.IsNullOrEmpty(studio.LogoUrl))
                                        {
                                            <img src="@studio.LogoUrl" alt="" class="w-4 h-4 object-contain" />
                                        }
                                        @studio.Name
                                    </a>
                                }
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Status))
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Status"]</span>
                            <span class="text-sm font-black text-text-main dark:text-white">@Model.Status</span>
                        </div>
                    }
                     @if (Model.Budget > 0)
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Budget"]</span>
                            <span class="text-sm font-black text-text-main dark:text-white">$@Model.Budget?.ToString("N0")</span>
                        </div>
                    }
                    @if (Model.Revenue > 0)
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Revenue"]</span>
                            <span class="text-sm font-black text-text-main dark:text-white">$@Model.Revenue?.ToString("N0")</span>
                        </div>
                    }
                    @if (Model.ProductionCountries?.Any() == true)
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["ProductionCountries"]</span>
                            <span class="text-xs font-black text-text-main dark:text-white">@(string.Join(", ", Model.ProductionCountries.Select(c => c.Name)))</span>
                        </div>
                    }
                    @if (Model.SpokenLanguages?.Any() == true)
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["SpokenLanguages"]</span>
                            <span class="text-xs font-black text-text-main dark:text-white">@(string.Join(", ", Model.SpokenLanguages.Select(l => l.Name)))</span>
                        </div>
                    }
                    
                    <div class="pt-6 border-t border-border-muted dark:border-dark-border">
                        <div class="flex flex-wrap gap-4">
                            @if (!string.IsNullOrEmpty(Model.ImdbId))
                            {
                                <a href="https://www.imdb.com/title/@Model.ImdbId" target="_blank" class="w-8 h-8 rounded-lg bg-accent-imdb text-black flex items-center justify-center font-black transition-transform hover:scale-110 shadow-lg" title="IMDb">
                                    <i class="fa-brands fa-imdb text-xl"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.FacebookId))
                            {
                                <a href="https://facebook.com/@Model.FacebookId" target="_blank" class="w-8 h-8 rounded-lg bg-accent-facebook text-white flex items-center justify-center transition-transform hover:scale-110 shadow-lg">
                                    <i class="fa-brands fa-facebook-f"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.InstagramId))
                            {
                                <a href="https://instagram.com/@Model.InstagramId" target="_blank" class="w-8 h-8 rounded-lg bg-linear-to-tr from-accent-instagram-from via-accent-instagram-via to-accent-instagram-to text-white flex items-center justify-center transition-transform hover:scale-110 shadow-lg">
                                    <i class="fa-brands fa-instagram"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.TwitterId))
                            {
                                <a href="https://twitter.com/@Model.TwitterId" target="_blank" class="w-8 h-8 rounded-lg bg-accent-twitter text-white flex items-center justify-center transition-transform hover:scale-110 shadow-lg">
                                    <i class="fa-brands fa-x-twitter"></i>
                                </a>
                            }
                             @if (!string.IsNullOrEmpty(Model.WikidataId))
                            {
                                <a href="https://www.wikidata.org/wiki/@Model.WikidataId" target="_blank" class="w-8 h-8 rounded-lg bg-surface-bright text-text-main flex items-center justify-center transition-transform hover:scale-110 shadow-lg border border-border-muted" title="Wikidata">
                                    <i class="fa-solid fa-barcode"></i>
                                </a>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Homepage))
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-1">@Localizer["Website"]</span>
                            <a href="@Model.Homepage" target="_blank" class="text-xs font-black text-brand-primary hover:text-brand-hover transition-colors truncate">
                                <i class="fa-solid fa-link mr-1"></i> @Model.Homepage
                            </a>
                        </div>
                    }
                </div>
            </div>

            @if (Model.Keywords?.Any() == true)
            {
                <div class="form-group-card p-8">
                    <h3 class="text-xs font-black text-text-muted uppercase tracking-widest mb-4">@Localizer["Tags"]</h3>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var fk in Model.Keywords)
                        {
                            <span class="px-2 py-1 rounded-lg bg-surface-muted dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-[10px] font-bold text-text-description dark:text-dark-text-muted uppercase tracking-tighter">
                                #@fk.Name
                            </span>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Right: Content & Metadata -->
        <div class="lg:col-span-2 space-y-16">
            <header>
                <div class="badge-premium px-3 py-1 mb-4">
                    <i aria-hidden="true" class="fa-solid fa-hashtag text-brand-primary"></i> @Model.FilmID
                </div>
                @if (string.IsNullOrEmpty(Model.BackdropUrl))
                {
                    <h1 class="text-5xl md:text-6xl font-black tracking-tighter text-text-main dark:text-white leading-none transition-colors">@Model.Titel</h1>
                    @if (!string.IsNullOrEmpty(Model.Tagline))
                    {
                        <p class="mt-4 text-2xl font-black text-brand-primary/80 italic tracking-tight transition-colors">@Model.Tagline</p>
                    }
                }
                <p class="mt-6 text-xl text-text-description dark:text-dark-text-muted font-medium italic transition-colors leading-relaxed">
                    @(string.Join(", ", Model.Genres?.Select(g => g.Name).Where(n => !string.IsNullOrEmpty(n)) ?? Array.Empty<string>())) &bull; @Model.Erscheinungsjahr
                </p>
            </header>

            @if (!string.IsNullOrEmpty(Model.Awards))
            {
                <section>
                    <div class="glass-premium p-8 rounded-3xl border border-brand-primary/20 flex items-center gap-6 shadow-2xl">
                        <div class="w-16 h-16 rounded-full bg-brand-primary/10 flex items-center justify-center text-brand-primary text-3xl">
                            <i class="fa-solid fa-trophy"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-black text-brand-primary uppercase tracking-[0.25em] mb-2">@Localizer["Awards"]</h3>
                            <p class="text-lg font-bold text-text-main dark:text-white leading-tight">@Model.Awards</p>
                        </div>
                    </div>
                </section>
            }

            <section>
                <div class="form-group-header !mb-6">
                    <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["Plot"]</h2>
                    <div class="h-1 w-12 bg-brand-primary rounded-full"></div>
                </div>
                <p class="text-lg text-text-description dark:text-dark-text-muted leading-relaxed pl-8 border-l-4 border-border-muted dark:border-dark-border transition-colors">
                    @Model.Handlung
                </p>
            </section>

            @if (!string.IsNullOrEmpty(Model.TrailerUrl))
            {
                <section>
                    <div class="form-group-header !mb-8">
                        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["Trailer"]</h2>
                        <div class="h-1 w-12 bg-brand-primary rounded-full mt-1"></div>
                    </div>
                    
                    <div class="card-glass overflow-hidden aspect-video border border-border-default dark:border-dark-border shadow-2xl relative group">
                        <iframe width="100%" height="100%" 
                                src="@Model.TrailerUrl" 
                                title='@Localizer["TrailerPlayerTitle"]' 
                                frameborder="0" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                                referrerpolicy="strict-origin-when-cross-origin" 
                                allowfullscreen
                                class="rounded-2xl"></iframe>
                        
                        <div class="absolute inset-x-0 -bottom-1 h-2 bg-brand-primary opacity-50 group-hover:opacity-100 transition-opacity blur-sm"></div>
                    </div>
                </section>
            }

            <!-- Cast & Crew Section -->
            <section>
                <div class="form-group-header !mb-8 flex items-center justify-between">
                    <div>
                        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["CastTeam"]</h2>
                        <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
                    </div>
                    <span class="badge-outline">@Model.PersonEigenschaftFilme.Count @Localizer["ContributorsCount"]</span>
                </div>

                <div class="space-y-12">
                    @foreach (var group in Model.PersonEigenschaftFilme.GroupBy(p => p.Eigenschaft.Bezeichnung))
                    {
                        <div>
                            <h3 class="text-[10px] font-black text-brand-primary uppercase tracking-[0.2em] mb-4 px-2">@group.Key</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                @foreach (var participation in group)
                                {
                                    <a asp-controller="Person" asp-action="Details" asp-route-id="@participation.PersonID" 
                                       class="card-premium flex items-center p-4 group hover:border-brand-primary/30 transition-all bg-surface-subtle/30 dark:bg-dark-surface/30">
                                        <div class="w-12 h-12 rounded-lg overflow-hidden shrink-0 border border-border-muted dark:border-dark-border group-hover:shadow-lg transition-all">
                                            @if (!string.IsNullOrEmpty(participation.Person.ProfilBildUrl))
                                            {
                                                <img src="@participation.Person.ProfilBildUrl" alt="@participation.Person.Vorname @participation.Person.Nachname" class="w-full h-full object-cover transition-transform group-hover:scale-110" />
                                            }
                                            else
                                            {
                                                <div class="w-full h-full flex items-center justify-center bg-surface-muted dark:bg-dark-surface-soft">
                                                    <i aria-hidden="true" class="fa-solid fa-user text-lg text-text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="ml-4 flex-grow min-w-0">
                                            <p class="text-sm font-black text-text-main dark:text-white group-hover:text-brand-primary transition-colors truncate">@participation.Person.Vorname @participation.Person.Nachname</p>
                                        </div>
                                        <i aria-hidden="true" class="fa-solid fa-chevron-right ml-auto text-border-default dark:text-dark-surface-muted transition-transform group-hover:translate-x-1 text-xs px-2"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            @if (Model.SimilarFilms?.Any() == true)
            {
                <section>
                    <div class="form-group-header !mb-8">
                        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["SimilarFilms"]</h2>
                        <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                        @foreach (var sim in Model.SimilarFilms.Take(4))
                        {
                            <a asp-action="Details" asp-route-id="@sim.FilmID" class="group block">
                                <div class="aspect-[2/3] rounded-xl overflow-hidden border border-border-muted transition-all group-hover:border-brand-primary shadow-sm hover:shadow-xl">
                                    <img src="@sim.PosterUrl" alt="@sim.Titel" class="w-full h-full object-cover transition-transform group-hover:scale-110" />
                                </div>
                                <p class="mt-2 text-[10px] font-black text-text-main dark:text-white truncate">@sim.Titel</p>
                            </a>
                        }
                    </div>
                </section>
            }

            @if (Model.RecommendedFilms?.Any() == true)
            {
                <section>
                    <div class="form-group-header !mb-8">
                        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["RecommendedFilms"]</h2>
                        <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                        @foreach (var rec in Model.RecommendedFilms.Take(4))
                        {
                            <a asp-action="Details" asp-route-id="@rec.FilmID" class="group block">
                                <div class="aspect-[2/3] rounded-xl overflow-hidden border border-border-muted transition-all group-hover:border-brand-primary shadow-sm hover:shadow-xl">
                                    <img src="@rec.PosterUrl" alt="@rec.Titel" class="w-full h-full object-cover transition-transform group-hover:scale-110" />
                                </div>
                                <p class="mt-2 text-[10px] font-black text-text-main dark:text-white truncate">@rec.Titel</p>
                            </a>
                        }
                    </div>
                </section>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/favorites.js"></script>
}
