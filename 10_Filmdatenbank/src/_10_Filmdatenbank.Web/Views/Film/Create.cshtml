@model _10_Filmdatenbank.Domain.Entities.Film
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["CreatePageTitle"];
}

<div class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-12">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-brand-soft border border-brand-border flex items-center justify-center text-brand-primary shadow-sm transition-transform hover:scale-105" aria-hidden="true">
                <i aria-hidden="true" class="fa-solid fa-square-plus text-2xl"></i>
            </div>
            <div>
                <h1 class="text-3xl font-black tracking-tight text-text-main dark:text-white leading-none transition-colors">@Localizer["CreateHeader"]</h1>
                <p class="mt-2 text-sm font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest">@Localizer["CreateSubheader"]</p>
            </div>
        </div>
        <a asp-action="Index" class="text-sm font-bold text-text-muted hover:text-brand-primary transition-all flex items-center gap-2 uppercase tracking-widest" aria-label='@Localizer["BackToCatalog"]'>
            <i aria-hidden="true" class="fa-solid fa-chevron-left"></i> @Localizer["Back"]
        </a>
    </div>

    <div class="form-group-card mb-8">
        <div class="p-8">
            <div class="flex flex-col gap-1.5 relative">
                <label class="text-[10px] font-black text-brand-primary uppercase tracking-widest px-1">@Localizer["TmdbSearchLabel"]</label>
                <div class="relative group">
                    <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-brand-primary opacity-50">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input type="text" id="tmdbSearchInput" 
                           class="w-full pl-12 pr-4 py-4 rounded-xl bg-brand-soft/30 dark:bg-dark-surface-soft border-2 border-brand-border/20 focus:border-brand-primary focus:ring-4 focus:ring-brand-primary/10 outline-hidden transition-all font-black text-text-main dark:text-white" 
                           placeholder='@Localizer["TmdbSearchPlaceholder"]' />
                    
                    <!-- Search Results Dropdown -->
                    <div id="searchResults" class="hidden absolute top-full left-0 right-0 mt-2 bg-surface-bright dark:bg-dark-surface rounded-2xl shadow-2xl border border-border-default dark:border-dark-border z-100 max-h-96 overflow-y-auto overflow-x-hidden backdrop-blur-xl bg-surface-bright/95 dark:bg-dark-surface/95 scroll-smooth">
                        <!-- Filled by JS -->
                    </div>
                </div>
                <p class="mt-2 text-[9px] font-bold text-text-muted dark:text-dark-text-muted italic px-1">
                    <i class="fa-solid fa-circle-info mr-1 text-brand-primary opacity-70"></i> @Localizer["TmdbSearchHint"]
                </p>
            </div>
        </div>
    </div>

    <form asp-action="Create" id="createForm" class="space-y-8">
        <div asp-validation-summary="ModelOnly" role="alert" class="p-4 rounded-xl bg-danger-bg dark:bg-danger-dark-bg text-danger-content dark:text-danger-dark-content text-sm font-bold border border-danger-border dark:border-danger-dark-border italic mb-8"></div>

        <div class="form-group-card focus-within:shadow-xl transition-shadow duration-500">
            <div class="form-group-header">
                <h2 class="text-xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["MovieInfo"]</h2>
                <p class="text-[10px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest mt-1">@Localizer["MovieInfoSub"]</p>
            </div>

            <div class="p-8 space-y-8">
                <!-- Title row -->
                <div class="form-group-row">
                    <div class="flex flex-col gap-1.5 flex-grow">
                        <label for="inputTitel" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelTitle"]</label>
                        <input asp-for="Titel" id="inputTitel" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder='@Localizer["PlaceholderTitle"]' />
                        <span asp-validation-for="Titel" class="text-[10px] font-bold text-danger-primary mt-1 px-1"></span>
                    </div>
                </div>



                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="flex flex-col gap-1.5">
                        <label for="inputYear" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelYear"]</label>
                        <input asp-for="Erscheinungsjahr" id="inputYear" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label for="inputDate" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelDate"]</label>
                        <input asp-for="Erscheinungsdatum" id="inputDate" type="date" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label for="inputRating" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelRating"]</label>
                        <input asp-for="Nutzerwertung" id="inputRating" type="number" step="0.1" min="0" max="10" value="0.0" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="flex flex-col gap-1.5">
                        <label for="inputRuntime" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelRuntime"]</label>
                        <input asp-for="Spieldauer" id="inputRuntime" type="number" min="1" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                        <span asp-validation-for="Spieldauer" class="text-[10px] font-bold text-danger-primary mt-1 px-1"></span>
                    </div>
                    <div class="flex flex-col gap-1.5 slice-group">
                        <label for="inputPrice" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelPrice"]</label>
                        <input asp-for="Preis" id="inputPrice" type="number" step="0.01" value="9.99" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                        <span asp-validation-for="Preis" class="text-[10px] font-bold text-danger-primary mt-1 px-1"></span>
                    </div>
                    <div class="flex flex-col gap-1.5 flex-grow">
                         <label for="inputNovel" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Romanvorlage</label>
                         <input asp-for="NovelSource" id="inputNovel" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder="Autor: Buch (Jahr)..." />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="flex flex-col gap-1.5">
                        <label for="inputPosterUrl" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelPosterUrl"]</label>
                        <input asp-for="PosterUrl" id="inputPosterUrl" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder='@Localizer["PlaceholderPosterUrl"]' />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label for="inputHomepage" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Homepage</label>
                        <input asp-for="Homepage" id="inputHomepage" type="url" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder="https://www.example.com" />
                    </div>
                </div>



                <div class="flex flex-col gap-1.5">
                    <label for="inputPlot" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelPlot"]</label>
                    <textarea asp-for="Handlung" id="inputPlot" rows="5" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-medium text-text-description dark:text-dark-text-muted" placeholder='@Localizer["PlaceholderPlot"]'></textarea>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="inputTagline" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Tagline</label>
                    <input asp-for="Tagline" id="inputTagline" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder="Believe the unbelievable" />
                </div>

                <!-- Cast / Credits Section -->
                <div id="castSection" class="hidden space-y-4 pt-8 border-t border-border-muted dark:border-dark-border">
                    <div class="flex items-center justify-between px-1">
                        <div>
                            <h3 class="text-sm font-black text-text-main dark:text-white uppercase tracking-tight">Cast & Crew</h3>
                            <p class="text-[9px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest">Wähle die Mitwirkenden zum Synchronisieren</p>
                        </div>
                        <button type="button" id="toggleAllCast" class="text-[10px] font-black text-brand-primary hover:text-brand-hover uppercase tracking-widest transition-colors">Alle abwählen</button>
                    </div>
                    
                    <div id="castList" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-80 overflow-y-auto pr-2 custom-scrollbar">
                        <!-- Filled by JS -->
                    </div>

                    <div class="flex items-center justify-between px-1 pt-4">
                        <div>
                            <h3 class="text-sm font-black text-text-main dark:text-white uppercase tracking-tight">Crew Members</h3>
                            <p class="text-[9px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest">Wähle die Crew-Mitglieder zum Synchronisieren</p>
                        </div>
                        <button type="button" id="toggleAllCrew" class="text-[10px] font-black text-brand-primary hover:text-brand-hover uppercase tracking-widest transition-colors">Alle abwählen</button>
                    </div>

                    <div id="crewList" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-80 overflow-y-auto pr-2 custom-scrollbar">
                        <!-- Filled by JS -->
                    </div>
                    
                    <input type="hidden" name="SelectedCastJson" id="inputSelectedCastJson" />
                    <input type="hidden" name="SelectedCrewJson" id="inputSelectedCrewJson" />
                    <input type="hidden" name="SelectedGenresJson" id="inputSelectedGenresJson" />
                    <input type="hidden" name="SelectedKeywordsJson" id="inputSelectedKeywordsJson" />
                    <input type="hidden" name="SelectedCompaniesJson" id="inputSelectedCompaniesJson" />
                </div>

                <!-- Hidden TMDB alignment fields -->
                <input type="hidden" asp-for="TmdbId" id="inputTmdbId" />
                <input type="hidden" asp-for="ImdbId" id="inputImdbId" />
                <input type="hidden" asp-for="FacebookId" id="inputFacebookId" />
                <input type="hidden" asp-for="InstagramId" id="inputInstagramId" />
                <input type="hidden" asp-for="TwitterId" id="inputTwitterId" />
                <input type="hidden" asp-for="WikidataId" id="inputWikidataId" />
                <input type="hidden" asp-for="OriginalTitle" id="inputOriginalTitle" />
                <input type="hidden" asp-for="OriginalLanguage" id="inputOriginalLanguage" />
                <input type="hidden" asp-for="BackdropUrl" id="inputBackdropUrl" />
                <input type="hidden" asp-for="Popularity" id="inputPopularity" />
                <input type="hidden" asp-for="VoteCount" id="inputVoteCount" />
                <input type="hidden" asp-for="Budget" id="inputBudget" />
                <input type="hidden" asp-for="Revenue" id="inputRevenue" />
                <input type="hidden" asp-for="VoteAverage" id="inputVoteAverage" />
                <input type="hidden" asp-for="Status" id="inputStatus" />
                <input type="hidden" asp-for="TrailerUrl" id="inputTrailerUrl" />
                <input type="hidden" asp-for="CollectionID" id="inputCollectionID" />
                <input type="hidden" name="TmdbCollectionId" id="inputTmdbCollectionId" />
                <input type="hidden" name="TmdbCollectionName" id="inputTmdbCollectionName" />

                <div class="flex items-center gap-3 px-1">
                    <input asp-for="Adult" id="inputAdult" type="checkbox" class="w-5 h-5 rounded border-border-default dark:border-dark-border text-brand-primary focus:ring-brand-primary" />
                    <label for="inputAdult" class="text-sm font-bold text-text-main dark:text-white">Nur für Erwachsene</label>
                </div>
            </div>

            <div class="form-group-footer">
                <a asp-action="Index" class="btn-secondary px-8">@Localizer["Cancel"]</a>
                <button type="submit" class="btn-primary px-10 shadow-xl shadow-brand-shadow">
                    <i aria-hidden="true" class="fa-solid fa-plus-circle mr-2"></i> @Localizer["CreateButton"]
                </button>
            </div>
        </div>
    </form>
    
    <p class="mt-4 text-center text-[9px] text-text-muted dark:text-dark-text-muted italic">
        @Localizer["ValidationNotice"]
    </p>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('tmdbSearchInput');
            const resultsDropdown = document.getElementById('searchResults');
            let debounceTimer;

            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                const query = this.value.trim();
                
                if (query.length < 2) {
                    resultsDropdown.classList.add('hidden');
                    return;
                }

                debounceTimer = setTimeout(() => {
                    fetchSearchResults(query);
                }, 400);
            });

            async function fetchSearchResults(query) {
                try {
                    resultsDropdown.innerHTML = `<div class="p-6 text-center text-xs font-bold text-text-muted dark:text-dark-text-muted italic animate-pulse">@Localizer["Searching"]</div>`;
                    resultsDropdown.classList.remove('hidden');
                    
                    const response = await fetch(`/api/tmdb/search?query=${encodeURIComponent(query)}`);
                    if (!response.ok) throw new Error('Search failed');
                    
                    const results = await response.json();
                    
                    if (results.length === 0) {
                        resultsDropdown.innerHTML = `<div class="p-6 text-center text-xs font-bold text-danger-primary">@Localizer["NoResults"]</div>`;
                        return;
                    }

                    resultsDropdown.innerHTML = results.map(movie => `
                        <button type="button" class="w-full flex items-center gap-4 p-4 hover:bg-brand-soft/20 dark:hover:bg-brand-primary/5 transition-colors border-b border-border-muted dark:border-dark-border last:border-0 group select-none text-left" 
                                onclick="selectMovie(${movie.id})">
                            <div class="w-12 h-16 rounded-lg bg-surface-subtle overflow-hidden shrink-0 border border-border-default dark:border-dark-border">
                                ${movie.posterPath ? 
                                    `<img src="https://image.tmdb.org/t/p/w92${movie.posterPath}" class="w-full h-full object-cover" />` : 
                                    `<div class="w-full h-full flex items-center justify-center bg-surface-soft text-text-muted"><i class="fa-solid fa-image"></i></div>`
                                }
                            </div>
                            <div class="flex-grow">
                                <div class="text-sm font-black text-text-main dark:text-white group-hover:text-brand-primary transition-colors">${movie.title}</div>
                                <div class="text-[10px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest mt-0.5">${movie.releaseYear || 'N/A'}</div>
                            </div>
                            <i class="fa-solid fa-plus-circle text-brand-primary opacity-0 group-hover:opacity-100 transition-opacity"></i>
                        </button>
                    `).join('');
                } catch (error) {
                    console.error('TMDB Search Error:', error);
                    resultsDropdown.innerHTML = `<div class="p-6 text-center text-xs font-bold text-danger-primary">Error fetching results</div>`;
                }
            }

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!searchInput.contains(e.target) && !resultsDropdown.contains(e.target)) {
                    resultsDropdown.classList.add('hidden');
                }
            });
        });

        async function selectMovie(id) {
            const dropdown = document.getElementById('searchResults');
            const searchInput = document.getElementById('tmdbSearchInput');
            
            try {
                const response = await fetch(`/api/tmdb/details/${id}`);
                if (!response.ok) throw new Error('Details fetch failed');
                
                const data = await response.json();
                
                const setVal = (id, val) => {
                    const el = document.getElementById(id);
                    if (el) el.value = val ?? '';
                };

                // Populate Form Fields
                setVal('inputTitel', data.title);
                setVal('inputYear', data.releaseYear || 0);
                setVal('inputDate', data.releaseDate || '');
                setVal('inputRuntime', data.runtime || 0);
                setVal('inputPosterUrl', data.posterUrl || '');
                setVal('inputPlot', data.overview || '');
                setVal('inputTagline', data.tagline || '');
                setVal('inputRating', (data.voteAverage || 0).toFixed(1));
                
                // Special: Trailer URL
                if (data.trailerKey) {
                    setVal('inputTrailerUrl', `https://www.youtube.com/embed/${data.trailerKey}`);
                }

                // Hidden Fields
                setVal('inputTmdbId', data.id);
                setVal('inputImdbId', data.imdbId || '');
                setVal('inputFacebookId', data.facebookId || '');
                setVal('inputInstagramId', data.instagramId || '');
                setVal('inputTwitterId', data.twitterId || '');

                // Metadata Serialization
                setVal('inputSelectedGenresJson', JSON.stringify(data.genres || []));
                setVal('inputSelectedKeywordsJson', JSON.stringify(data.keywords || []));
                setVal('inputSelectedCompaniesJson', JSON.stringify(data.productionCompanies || []));
                setVal('inputWikidataId', data.wikidataId || '');
                setVal('inputOriginalTitle', data.originalTitle || '');
                setVal('inputOriginalLanguage', data.originalLanguage || '');
                setVal('inputBackdropUrl', data.backdropUrl || '');
                setVal('inputPopularity', data.popularity || 0);
                setVal('inputVoteCount', data.voteCount || 0);
                setVal('inputBudget', data.budget || 0);
                setVal('inputRevenue', data.revenue || 0);
                setVal('inputVoteAverage', data.voteAverage || 0);
                setVal('inputStatus', data.status || '');
                setVal('inputHomepage', data.homepage || '');
                setVal('inputTrailerUrl', data.trailerKey ? `https://www.youtube.com/embed/${data.trailerKey}` : '');
                setVal('inputTmdbCollectionId', data.collectionId || '');
                setVal('inputTmdbCollectionName', data.collectionName || '');

                const adultCheck = document.getElementById('inputAdult');
                if (adultCheck) adultCheck.checked = data.adult || false;

                // Handle Cast & Crew
                const castSection = document.getElementById('castSection');
                const castList = document.getElementById('castList');
                const crewList = document.getElementById('crewList');

                if ((data.cast && data.cast.length > 0) || (data.crew && data.crew.length > 0)) {
                    castSection.classList.remove('hidden');
                    
                    castList.innerHTML = (data.cast || []).map(c => `
                        <label class="flex items-center gap-3 p-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border cursor-pointer hover:border-brand-primary/50 transition-all group">
                            <input type="checkbox" class="cast-checkbox w-4 h-4 rounded border-border-default text-brand-primary focus:ring-brand-primary focus:ring-offset-dark-surface" checked 
                                   data-id="${c.id}" data-name="${c.name}" data-character="${c.character}" data-profile="${c.profileUrl || ''}" />
                            <div class="w-8 h-8 rounded-lg overflow-hidden shrink-0 border border-border-default dark:border-dark-border bg-surface-soft dark:bg-dark-surface">
                                ${c.profileUrl ? `<img src="${c.profileUrl}" class="w-full h-full object-cover" />` : `<i class="fa-solid fa-user text-xs text-text-muted m-2"></i>`}
                            </div>
                            <div class="flex-grow min-w-0">
                                <p class="text-[10px] font-black text-text-main dark:text-white truncate leading-tight">${c.name}</p>
                                <p class="text-[8px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-tighter truncate mt-0.5">${c.character}</p>
                            </div>
                        </label>
                    `).join('');
                    
                    crewList.innerHTML = (data.crew || []).map(c => `
                        <label class="flex items-center gap-3 p-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border cursor-pointer hover:border-brand-primary/50 transition-all group">
                            <input type="checkbox" class="crew-checkbox w-4 h-4 rounded border-border-default text-brand-primary focus:ring-brand-primary focus:ring-offset-dark-surface" checked 
                                   data-id="${c.id}" data-name="${c.name}" data-job="${c.job}" data-profile="${c.profileUrl || ''}" />
                            <div class="w-8 h-8 rounded-lg overflow-hidden shrink-0 border border-border-default dark:border-dark-border bg-surface-soft dark:bg-dark-surface">
                                ${c.profileUrl ? `<img src="${c.profileUrl}" class="w-full h-full object-cover" />` : `<i class="fa-solid fa-user text-xs text-text-muted m-2"></i>`}
                            </div>
                            <div class="flex-grow min-w-0">
                                <p class="text-[10px] font-black text-text-main dark:text-white truncate leading-tight">${c.name}</p>
                                <p class="text-[8px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-tighter truncate mt-0.5">${c.job}</p>
                            </div>
                        </label>
                    `).join('');

                    updateSelectedCast();
                    updateSelectedCrew();
                    
                    // Add listeners
                    castList.querySelectorAll('.cast-checkbox').forEach(cb => cb.addEventListener('change', updateSelectedCast));
                    crewList.querySelectorAll('.crew-checkbox').forEach(cb => cb.addEventListener('change', updateSelectedCrew));
                } else {
                    castSection.classList.add('hidden');
                }

                // Close dropdown and clear search
                dropdown.classList.add('hidden');
                searchInput.value = '';
                
                // Visual Feedback: Pulse the form
                const formCard = document.querySelector('.form-group-card');
                formCard.classList.add('animate-pulse', 'ring-4', 'ring-brand-primary/20');
                setTimeout(() => formCard.classList.remove('animate-pulse', 'ring-4', 'ring-brand-primary/20'), 1000);

            } catch (error) {
                console.error('Detail fetch error:', error);
                alert('Fehler beim Abrufen der Filmdetails.');
            }
        }

        function updateSelectedCast() {
            const checkboxes = document.querySelectorAll('.cast-checkbox:checked');
            const cast = Array.from(checkboxes).map(cb => ({
                id: parseInt(cb.dataset.id),
                name: cb.dataset.name,
                character: cb.dataset.character,
                profileUrl: cb.dataset.profile
            }));
            document.getElementById('inputSelectedCastJson').value = JSON.stringify(cast);
        }

        function updateSelectedCrew() {
            const checkboxes = document.querySelectorAll('.crew-checkbox:checked');
            const crew = Array.from(checkboxes).map(cb => ({
                id: parseInt(cb.dataset.id),
                name: cb.dataset.name,
                job: cb.dataset.job,
                profileUrl: cb.dataset.profile
            }));
            document.getElementById('inputSelectedCrewJson').value = JSON.stringify(crew);
        }

        document.getElementById('toggleAllCast')?.addEventListener('click', function() {
            const checkboxes = document.querySelectorAll('.cast-checkbox');
            const allChecked = Array.from(checkboxes).every(cb => cb.checked);
            this.textContent = allChecked ? 'Alle auswählen' : 'Alle abwählen';
            checkboxes.forEach(cb => cb.checked = !allChecked);
            updateSelectedCast();
        });

        document.getElementById('toggleAllCrew')?.addEventListener('click', function() {
            const checkboxes = document.querySelectorAll('.crew-checkbox');
            const allChecked = Array.from(checkboxes).every(cb => cb.checked);
            this.textContent = allChecked ? 'Alle auswählen' : 'Alle abwählen';
            checkboxes.forEach(cb => cb.checked = !allChecked);
            updateSelectedCrew();
        });
    </script>
}
