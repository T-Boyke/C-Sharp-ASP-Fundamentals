@model _10_Filmdatenbank.Domain.Entities.Film

@{
    ViewData["Title"] = "Neuaufnahme";
}

<div class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-12">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-brand-soft border border-brand-border flex items-center justify-center text-brand-primary shadow-sm transition-transform hover:scale-105">
                <i class="fa-solid fa-square-plus text-2xl"></i>
            </div>
            <div>
                <h1 class="text-3xl font-black tracking-tight text-slate-900 leading-none">Neuer Katalogeintrag</h1>
                <p class="mt-2 text-sm font-bold text-slate-400 uppercase tracking-widest">Film-Metadaten erfassen</p>
            </div>
        </div>
        <a asp-action="Index" class="text-sm font-bold text-slate-400 hover:text-brand-primary transition-all flex items-center gap-2 uppercase tracking-widest">
            <i class="fa-solid fa-chevron-left"></i> Zurück
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
        <form asp-action="Create" class="p-10 space-y-10">
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-red-50 text-red-600 text-sm font-bold border border-red-100 italic"></div>

            <div class="space-y-8">
                <!-- Basic Info -->
                <div class="grid grid-cols-1 gap-8">
                    <div>
                        <label asp-for="Titel" class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fa-solid fa-heading mr-1 text-slate-300"></i> Film-Titel
                        </label>
                        <input asp-for="Titel" class="block w-full rounded-xl border-slate-200 py-3.5 text-slate-900 shadow-sm focus:border-brand-primary focus:ring-brand-primary bg-slate-50/50 focus:bg-white transition-all px-4 font-medium" placeholder="z.B. Interstellar" />
                        <span asp-validation-for="Titel" class="mt-2 block text-[10px] font-bold text-red-500 uppercase tracking-wider italic"></span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <div>
                            <label asp-for="Erscheinungsjahr" class="block text-sm font-bold text-slate-700 mb-2">
                                <i class="fa-solid fa-calendar mr-1 text-slate-300"></i> Jahr
                            </label>
                            <input asp-for="Erscheinungsjahr" class="block w-full rounded-xl border-slate-200 py-3.5 text-slate-900 shadow-sm focus:border-brand-primary focus:ring-brand-primary bg-slate-50/50 focus:bg-white transition-all px-4 font-medium" />
                            <span asp-validation-for="Erscheinungsjahr" class="mt-2 block text-[10px] font-bold text-red-500 uppercase tracking-wider italic"></span>
                        </div>

                        <div>
                            <label asp-for="Spieldauer" class="block text-sm font-bold text-slate-700 mb-2">
                                <i class="fa-solid fa-stopwatch mr-1 text-slate-300"></i> Dauer (min)
                            </label>
                            <input asp-for="Spieldauer" class="block w-full rounded-xl border-slate-200 py-3.5 text-slate-900 shadow-sm focus:border-brand-primary focus:ring-brand-primary bg-slate-50/50 focus:bg-white transition-all px-4 font-medium" />
                            <span asp-validation-for="Spieldauer" class="mt-2 block text-[10px] font-bold text-red-500 uppercase tracking-wider italic"></span>
                        </div>

                        <div>
                            <label asp-for="Preis" class="block text-sm font-bold text-slate-700 mb-2">
                                <i class="fa-solid fa-tag mr-1 text-slate-300"></i> Preis (€)
                            </label>
                            <input asp-for="Preis" class="block w-full rounded-xl border-slate-200 py-3.5 text-slate-900 shadow-sm focus:border-brand-primary focus:ring-brand-primary bg-slate-50/50 focus:bg-white transition-all px-4 font-medium" />
                            <span asp-validation-for="Preis" class="mt-2 block text-[10px] font-bold text-red-500 uppercase tracking-wider italic"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-10 border-t border-slate-100 flex items-center justify-between gap-6">
                 <p class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] max-w-[200px] leading-relaxed">
                    Alle Felder müssen den IHK-Qualitätsrichtlinien entsprechen.
                </p>
                <div class="flex gap-4">
                    <a asp-action="Index" class="px-6 py-3 text-sm font-bold text-slate-500 hover:text-slate-700 transition-colors">Abbrechen</a>
                    <button type="submit" class="btn-primary px-8 shadow-lg shadow-brand-primary/20">
                        <i class="fa-solid fa-floppy-disk mr-2 font-light"></i> Speichern
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
