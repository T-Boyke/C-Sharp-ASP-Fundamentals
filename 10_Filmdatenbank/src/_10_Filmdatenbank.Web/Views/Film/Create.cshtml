@model _10_Filmdatenbank.Domain.Entities.Film

@{
    ViewData["Title"] = "Neuaufnahme";
}

<div class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-12">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-brand-soft border border-brand-border flex items-center justify-center text-brand-primary shadow-sm transition-transform hover:scale-105">
                <i aria-hidden="true" class="fa-solid fa-square-plus text-2xl"></i>
            </div>
            <div>
                <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white leading-none transition-colors">Neuer Katalogeintrag</h1>
                <p class="mt-2 text-sm font-bold text-slate-400 uppercase tracking-widest">Film-Metadaten erfassen</p>
            </div>
        </div>
        <a asp-action="Index" class="text-sm font-bold text-slate-400 hover:text-brand-primary transition-all flex items-center gap-2 uppercase tracking-widest">
            <i aria-hidden="true" class="fa-solid fa-chevron-left"></i> Zurück
        </a>
    </div>

    <div class="form-group-card overflow-hidden !p-0">
        <form asp-action="Create" class="p-10 space-y-10">
            <div class="form-group-header">
                <div>
                    <h2 class="text-xl font-black text-slate-900 dark:text-white uppercase tracking-tight">Filmdetails</h2>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">Stammdaten erfassen</p>
                </div>
                <i aria-hidden="true" class="fa-solid fa-circle-info text-slate-200 dark:text-slate-800 text-2xl"></i>
            </div>

            <div asp-validation-summary="ModelOnly" role="alert" class="p-4 rounded-xl bg-red-50 text-red-600 text-sm font-bold border border-red-100 italic mb-8"></div>

            <div class="space-y-8">
                <div class="form-group">
                    <label asp-for="Titel" class="form-label">
                        <i aria-hidden="true" class="fa-solid fa-heading mr-1 text-slate-400 dark:text-slate-500"></i> Film-Titel
                    </label>
                    <input asp-for="Titel" class="form-input" placeholder="z.B. Der Pate / Inception" />
                    <span asp-validation-for="Titel" class="form-error"></span>
                </div>

                <div class="form-group-row">
                    <div class="form-group">
                        <label asp-for="Erscheinungsjahr" class="form-label">
                            <i aria-hidden="true" class="fa-solid fa-calendar mr-1 text-slate-400 dark:text-slate-500"></i> Jahr
                        </label>
                        <input asp-for="Erscheinungsjahr" class="form-input" placeholder="z.B. 1972" />
                        <span asp-validation-for="Erscheinungsjahr" class="form-error"></span>
                    </div>

                    <div class="grid grid-cols-2 gap-6">
                        <div class="form-group">
                            <label asp-for="Spieldauer" class="form-label">
                                <i aria-hidden="true" class="fa-solid fa-stopwatch mr-1 text-slate-400 dark:text-slate-500"></i> Dauer (min)
                            </label>
                            <input asp-for="Spieldauer" class="form-input" placeholder="min" />
                            <span asp-validation-for="Spieldauer" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Preis" class="form-label">
                                <i aria-hidden="true" class="fa-solid fa-tag mr-1 text-slate-400 dark:text-slate-500"></i> Preis (€)
                            </label>
                            <input asp-for="Preis" class="form-input" placeholder="€" />
                            <span asp-validation-for="Preis" class="form-error"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group-footer">
                 <p class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] max-w-[200px] leading-relaxed">
                    Alle Änderungen werden nach dem Speichern sofort im Katalog sichtbar.
                </p>
                <div class="flex flex-col gap-3">
                    <div class="flex-wrap-gap">
                        <a asp-action="Index" class="btn-secondary">Abbrechen</a>
                        <button type="submit" class="btn-primary">
                            <i aria-hidden="true" class="fa-solid fa-square-plus mr-2"></i> Eintrag anlegen
                        </button>
                    </div>
                    <p class="text-[9px] text-slate-400 dark:text-slate-500 italic text-right">
                        System-Validierung aktiv
                    </p>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
