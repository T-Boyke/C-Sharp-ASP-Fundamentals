@model _10_Filmdatenbank.Domain.Entities.Film
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["EditPageTitle"];
}

<div class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-12">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-success-bg dark:bg-success-dark-bg border border-success-border dark:border-success-dark-border flex items-center justify-center text-success-primary dark:text-success-dark-content shadow-sm transition-transform hover:scale-105" aria-hidden="true">
                <i aria-hidden="true" class="fa-solid fa-pen-to-square text-2xl"></i>
            </div>
            <div>
                <h1 class="text-3xl font-black tracking-tight text-text-main dark:text-white leading-none transition-colors">@Model.Titel</h1>
                <p class="mt-2 text-sm font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest">@Localizer["EditSubheader"]</p>
            </div>
        </div>
        <a asp-action="Index" class="text-sm font-bold text-text-muted hover:text-brand-primary transition-all flex items-center gap-2 uppercase tracking-widest" aria-label='@Localizer["BackToCatalog"]'>
            <i aria-hidden="true" class="fa-solid fa-chevron-left"></i> @Localizer["Back"]
        </a>
    </div>

    <div class="form-group-card mb-8">
        <div class="p-8">
            <div class="flex flex-col gap-1.5 relative">
                <label class="text-[10px] font-black text-brand-primary uppercase tracking-widest px-1">TMDB Abgleich</label>
                <div class="relative group">
                    <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-brand-primary opacity-50">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input type="text" id="tmdbMovieSearch" 
                           class="w-full pl-12 pr-4 py-4 rounded-xl bg-brand-soft/30 dark:bg-dark-surface-soft border-2 border-brand-border/20 focus:border-brand-primary focus:ring-4 focus:ring-brand-primary/10 outline-hidden transition-all font-black text-text-main dark:text-white" 
                           placeholder="Film auf TMDB suchen zum Aktualisieren..." />
                    <div id="searchResults" class="hidden absolute top-full left-0 right-0 mt-2 bg-surface-bright dark:bg-dark-surface rounded-2xl shadow-2xl border border-border-default dark:border-dark-border z-100 max-h-96 overflow-y-auto overflow-x-hidden backdrop-blur-xl bg-surface-bright/95 dark:bg-dark-surface/95 transition-all">
                        <!-- Results dynamic -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-group-card overflow-hidden !p-0">
        <form asp-action="Edit" class="p-10 space-y-10">
            <input type="hidden" asp-for="FilmID" />
            <input type="hidden" asp-for="TmdbId" id="inputTmdbId" />
            <input type="hidden" asp-for="CollectionID" id="inputCollectionId" />
            
            <div class="form-group-header">
                <div>
                    <h2 class="text-xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["CatalogData"]</h2>
                    <p class="text-[10px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest mt-1">@Localizer["CatalogDataSub"]</p>
                </div>
                <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-surface-muted dark:bg-dark-surface border border-border-muted dark:border-dark-border text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase">
                    ID: #@Model.FilmID
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" role="alert" class="p-4 rounded-xl bg-danger-bg dark:bg-danger-dark-bg text-danger-content dark:text-danger-dark-content text-sm font-bold border border-danger-border dark:border-danger-dark-border italic mb-8"></div>

            <div class="space-y-8">
                <div class="form-group-card">
                    <div class="p-8 space-y-8">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="flex flex-col gap-1.5 flex-grow">
                                 <label for="inputTitle" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelTitle"]</label>
                                 <input asp-for="Titel" id="inputTitle" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                                <span asp-validation-for="Titel" class="text-[10px] font-bold text-danger-primary mt-1 px-1"></span>
                            </div>
                            <div class="flex flex-col gap-1.5 flex-grow">
                                 <label for="inputOriginalTitle" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Originaltitel</label>
                                 <input asp-for="OriginalTitle" id="inputOriginalTitle" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="flex flex-col gap-1.5 flex-grow">
                                 <label for="inputTagline" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Tagline</label>
                                 <input asp-for="Tagline" id="inputTagline" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                            <div class="flex flex-col gap-1.5 flex-grow">
                                 <label for="inputHomepage" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Homepage</label>
                                 <input asp-for="Homepage" id="inputHomepage" type="url" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                            <div class="flex flex-col gap-1.5">
                                <label for="inputYear" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Jahr</label>
                                <input asp-for="Erscheinungsjahr" id="inputYear" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label for="inputDate" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Datum</label>
                                <input asp-for="Erscheinungsdatum" id="inputDate" type="date" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                             <div class="flex flex-col gap-1.5">
                                 <label for="inputRating" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">User Wertung (0-10)</label>
                                <input asp-for="Nutzerwertung" id="inputRating" type="number" step="0.1" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                             <div class="flex flex-col gap-1.5">
                                 <label for="inputStatus" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Status</label>
                                <input asp-for="Status" id="inputStatus" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                             <div class="flex flex-col gap-1.5">
                                  <label for="inputRuntime" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Dauer (Min.)</label>
                                 <input asp-for="Spieldauer" id="inputRuntime" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                 <label for="inputPrice" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Kaufpreis</label>
                                 <input asp-for="Preis" id="inputPrice" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                             <div class="flex flex-col gap-1.5">
                                  <label for="inputBudget" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Budget ($)</label>
                                 <input asp-for="Budget" id="inputBudget" type="number" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                 <label for="inputRevenue" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Einnahmen ($)</label>
                                 <input asp-for="Revenue" id="inputRevenue" type="number" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                             <div class="flex flex-col gap-1.5">
                                  <label for="inputPosterUrl" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Poster URL</label>
                                 <input asp-for="PosterUrl" id="inputPosterUrl" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                 <label for="inputBackdropUrl" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Hintergrund URL</label>
                                 <input asp-for="BackdropUrl" id="inputBackdropUrl" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                            </div>
                        </div>

                        <div class="flex flex-col gap-1.5">
                             <label for="inputPlot" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">Handlung</label>
                             <textarea asp-for="Handlung" id="inputPlot" rows="5" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-medium text-text-description dark:text-dark-text-muted"></textarea>
                        </div>

                        <!-- Cast / Credits Section (Copied from Create) -->
                        <div id="castSection" class="hidden space-y-4 pt-8 border-t border-border-muted dark:border-dark-border">
                            <div class="flex items-center justify-between px-1">
                                <div>
                                    <h3 class="text-sm font-black text-text-main dark:text-white uppercase tracking-tight">Besetzung & Crew</h3>
                                    <p class="text-[9px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest">Wähle die Mitwirkenden zum Synchronisieren</p>
                                </div>
                                <button type="button" id="toggleAllCast" class="text-[10px] font-black text-brand-primary hover:text-brand-hover uppercase tracking-widest transition-colors">Alle abwählen</button>
                            </div>
                            
                            <div id="castList" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-80 overflow-y-auto pr-2 custom-scrollbar">
                                <!-- Filled by JS -->
                            </div>

                            <div class="flex items-center justify-between px-1 pt-4">
                                <div>
                                    <h3 class="text-sm font-black text-text-main dark:text-white uppercase tracking-tight">Crew Mitglieder</h3>
                                    <p class="text-[9px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest">Wähle die Crew-Mitglieder zum Synchronisieren</p>
                                </div>
                                <button type="button" id="toggleAllCrew" class="text-[10px] font-black text-brand-primary hover:text-brand-hover uppercase tracking-widest transition-colors">Alle abwählen</button>
                            </div>

                            <div id="crewList" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-80 overflow-y-auto pr-2 custom-scrollbar">
                                <!-- Filled by JS -->
                            </div>
                            
                            <input type="hidden" name="SelectedCastJson" id="inputSelectedCastJson" />
                            <input type="hidden" name="SelectedCrewJson" id="inputSelectedCrewJson" />
                            <input type="hidden" name="SelectedGenresJson" id="inputSelectedGenresJson" />
                            <input type="hidden" name="SelectedKeywordsJson" id="inputSelectedKeywordsJson" />
                            <input type="hidden" name="SelectedCompaniesJson" id="inputSelectedCompaniesJson" />
                            <input type="hidden" name="TmdbCollectionId" id="inputTmdbCollectionId" />
                            <input type="hidden" name="TmdbCollectionName" id="inputTmdbCollectionName" />
                        </div>

                        <div class="form-group-card bg-surface-subtle/50 dark:bg-dark-surface border border-border-muted dark:border-dark-border">
                            <div class="p-6 space-y-6">
                                <p class="text-[10px] font-black text-text-muted uppercase tracking-widest">Technische Daten & Social Media</p>
                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                    <div class="flex flex-col gap-1.5">
                                        <label for="inputImdbId" class="text-[9px] font-bold text-text-muted uppercase">IMDb ID</label>
                                        <input asp-for="ImdbId" id="inputImdbId" class="px-3 py-2 rounded-lg bg-surface-bright dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label for="inputTvdbId" class="text-[9px] font-bold text-text-muted uppercase">TVDB ID</label>
                                        <input asp-for="TvdbId" id="inputTvdbId" class="px-3 py-2 rounded-lg bg-surface-bright dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label for="inputFacebookId" class="text-[9px] font-bold text-text-muted uppercase">Facebook ID</label>
                                        <input asp-for="FacebookId" id="inputFacebookId" class="px-3 py-2 rounded-lg bg-surface-bright dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label for="inputInstagramId" class="text-[9px] font-bold text-text-muted uppercase">Instagram ID</label>
                                        <input asp-for="InstagramId" id="inputInstagramId" class="px-3 py-2 rounded-lg bg-surface-bright dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label for="inputTwitterId" class="text-[9px] font-bold text-text-muted uppercase">Twitter ID</label>
                                        <input asp-for="TwitterId" id="inputTwitterId" class="px-3 py-2 rounded-lg bg-white dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label for="inputWikidataId" class="text-[9px] font-bold text-text-muted uppercase">Wikidata ID</label>
                                        <input asp-for="WikidataId" id="inputWikidataId" class="px-3 py-2 rounded-lg bg-white dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label for="inputPopularity" class="text-[9px] font-bold text-text-muted uppercase">Beliebtheit</label>
                                        <input asp-for="Popularity" id="inputPopularity" type="number" step="0.1" class="px-3 py-2 rounded-lg bg-white dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label for="inputLang" class="text-[9px] font-bold text-text-muted uppercase">Originalsprache (ISO)</label>
                                        <input asp-for="OriginalLanguage" id="inputOriginalLanguage" class="px-3 py-2 rounded-lg bg-white dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-xs font-bold" />
                                    </div>
                                     <div class="flex items-center gap-3 pt-4">
                                         <input asp-for="Adult" id="inputAdult" type="checkbox" class="w-5 h-5 rounded border-border-default dark:border-dark-border text-brand-primary" />
                                         <label for="inputAdult" class="text-xs font-bold">Nur für Erwachsene</label>
                                     </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group-footer">
                         <a asp-action="Index" class="btn-secondary px-8">@Localizer["Cancel"]</a>
                         <button type="submit" class="btn-primary bg-success-primary hover:bg-success-content px-10 shadow-lg shadow-success-primary/20 border-success-border">
                             <i aria-hidden="true" class="fa-solid fa-check mr-2"></i> @Localizer["Update"]
                         </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const tmdbSearch = document.getElementById('tmdbMovieSearch');
            const searchResults = document.getElementById('searchResults');

            tmdbSearch.addEventListener('input', async (e) => {
                const query = e.target.value;
                if (query.length < 2) {
                    searchResults.classList.add('hidden');
                    return;
                }

                try {
                    const response = await fetch(`/api/tmdb/search?query=${encodeURIComponent(query)}`);
                    const movies = await response.json();

                    if (movies.length > 0) {
                        searchResults.innerHTML = movies.map(movie => `
                            <div onclick="selectMovie(${movie.id})" class="p-4 hover:bg-brand-soft/30 cursor-pointer border-b border-border-muted last:border-0 flex gap-4 items-center">
                                <img src="${movie.posterPath ? 'https://image.tmdb.org/t/p/w92'+movie.posterPath : 'https://via.placeholder.com/45x68?text=?'}" class="w-11 h-16 rounded-md object-cover shadow-sm" />
                                <div class="flex-grow min-w-0">
                                    <div class="font-black text-text-main dark:text-white truncate uppercase tracking-tight text-xs">${movie.title}</div>
                                    <div class="text-[10px] font-bold text-text-muted mt-0.5">${movie.releaseYear || 'Unbekannt'}</div>
                                </div>
                            </div>
                        `).join('');
                        searchResults.classList.remove('hidden');
                    } else {
                        searchResults.innerHTML = '<div class="p-6 text-center text-xs font-bold text-text-muted uppercase tracking-widest italic">Keine Filme gefunden</div>';
                        searchResults.classList.remove('hidden');
                    }
                } catch (error) {
                    console.error('Search error:', error);
                }
            });

            window.selectMovie = async function(id) {
                try {
                    const response = await fetch(`/api/tmdb/details/${id}`);
                    const data = await response.json();

                    document.getElementById('inputTmdbId').value = data.id || '';
                    document.getElementById('inputTitle').value = data.title || '';
                    document.getElementById('inputOriginalTitle').value = data.originalTitle || '';
                    document.getElementById('inputTagline').value = data.tagline || '';
                    document.getElementById('inputYear').value = data.releaseYear || '';
                    document.getElementById('inputDate').value = data.releaseDate || '';
                    document.getElementById('inputRating').value = (data.voteAverage || 0).toFixed(1);
                    document.getElementById('inputRuntime').value = data.runtime || '';
                    document.getElementById('inputPosterUrl').value = data.posterUrl || '';
                    document.getElementById('inputBackdropUrl').value = data.backdropUrl || '';
                    document.getElementById('inputPlot').value = data.overview || '';
                    document.getElementById('inputBudget').value = data.budget || 0;
                    document.getElementById('inputRevenue').value = data.revenue || 0;
                    document.getElementById('inputStatus').value = data.status || '';
                    document.getElementById('inputHomepage').value = data.homepage || '';

                    // Social IDs
                    if (document.getElementById('inputImdbId')) document.getElementById('inputImdbId').value = data.imdbId || '';
                    if (document.getElementById('inputFacebookId')) document.getElementById('inputFacebookId').value = data.facebookId || '';
                    if (document.getElementById('inputInstagramId')) document.getElementById('inputInstagramId').value = data.instagramId || '';
                    if (document.getElementById('inputTwitterId')) document.getElementById('inputTwitterId').value = data.twitterId || '';
                    if (document.getElementById('inputWikidataId')) document.getElementById('inputWikidataId').value = data.wikidataId || '';
                    if (document.getElementById('inputPopularity')) document.getElementById('inputPopularity').value = data.popularity || 0;
                    if (document.getElementById('inputOriginalLanguage')) document.getElementById('inputOriginalLanguage').value = data.originalLanguage || '';
                    
                    document.getElementById('inputAdult').checked = data.adult || false;

                    // Metadata Serialization
                    document.getElementById('inputSelectedGenresJson').value = JSON.stringify(data.genres || []);
                    document.getElementById('inputSelectedKeywordsJson').value = JSON.stringify(data.keywords || []);
                    document.getElementById('inputSelectedCompaniesJson').value = JSON.stringify(data.productionCompanies || []);
                    document.getElementById('inputTmdbCollectionId').value = data.collectionId || '';
                    document.getElementById('inputTmdbCollectionName').value = data.collectionName || '';

                    // Cast & Crew UI (Copied from Create logic)
                    const castSection = document.getElementById('castSection');
                    const castList = document.getElementById('castList');
                    const crewList = document.getElementById('crewList');

                    if ((data.cast && data.cast.length > 0) || (data.crew && data.crew.length > 0)) {
                        castSection.classList.remove('hidden');
                        
                        castList.innerHTML = (data.cast || []).map(c => `
                            <label class="flex items-center gap-3 p-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border cursor-pointer hover:border-brand-primary/50 transition-all group">
                                <input type="checkbox" class="cast-checkbox w-4 h-4 rounded border-border-default text-brand-primary checked:bg-brand-primary" checked 
                                       data-id="${c.id}" data-name="${c.name}" data-character="${c.character}" data-profile="${c.profileUrl || ''}" />
                                <div class="w-8 h-8 rounded-lg overflow-hidden shrink-0 border border-border-default dark:border-dark-border bg-surface-soft dark:bg-dark-surface">
                                    ${c.profileUrl ? `<img src="${c.profileUrl}" class="w-full h-full object-cover" />` : `<i class="fa-solid fa-user text-xs text-text-muted m-2"></i>`}
                                </div>
                                <div class="flex-grow min-w-0">
                                    <p class="text-[10px] font-black text-text-main dark:text-white truncate leading-tight">${c.name}</p>
                                    <p class="text-[8px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-tighter truncate mt-0.5">${c.character}</p>
                                </div>
                            </label>
                        `).join('');
                        
                        crewList.innerHTML = (data.crew || []).map(c => `
                            <label class="flex items-center gap-3 p-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border cursor-pointer hover:border-brand-primary/50 transition-all group">
                                <input type="checkbox" class="crew-checkbox w-4 h-4 rounded border-border-default text-brand-primary checked:bg-brand-primary" checked 
                                       data-id="${c.id}" data-name="${c.name}" data-job="${c.job}" data-profile="${c.profileUrl || ''}" />
                                <div class="w-8 h-8 rounded-lg overflow-hidden shrink-0 border border-border-default dark:border-dark-border bg-surface-soft dark:bg-dark-surface">
                                    ${c.profileUrl ? `<img src="${c.profileUrl}" class="w-full h-full object-cover" />` : `<i class="fa-solid fa-user text-xs text-text-muted m-2"></i>`}
                                </div>
                                <div class="flex-grow min-w-0">
                                    <p class="text-[10px] font-black text-text-main dark:text-white truncate leading-tight">${c.name}</p>
                                    <p class="text-[8px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-tighter truncate mt-0.5">${c.job}</p>
                                </div>
                            </label>
                        `).join('');

                        updateSelectedCast();
                        updateSelectedCrew();
                        
                        castList.querySelectorAll('.cast-checkbox').forEach(cb => cb.addEventListener('change', updateSelectedCast));
                        crewList.querySelectorAll('.crew-checkbox').forEach(cb => cb.addEventListener('change', updateSelectedCrew));
                    }

                    searchResults.classList.add('hidden');
                    tmdbSearch.value = data.title;
                    
                    // Visual feedback
                    const formCard = document.querySelector('.form-group-card');
                    formCard.classList.add('ring-4', 'ring-success-primary/20');
                    setTimeout(() => formCard.classList.remove('ring-4', 'ring-success-primary/20'), 1000);

                } catch (error) {
                    console.error('Detail fetch error:', error);
                }
            };

            function updateSelectedCast() {
                const checkboxes = document.querySelectorAll('.cast-checkbox:checked');
                const cast = Array.from(checkboxes).map(cb => ({
                    id: parseInt(cb.dataset.id),
                    name: cb.dataset.name,
                    character: cb.dataset.character,
                    profileUrl: cb.dataset.profile
                }));
                document.getElementById('inputSelectedCastJson').value = JSON.stringify(cast);
            }

            function updateSelectedCrew() {
                const checkboxes = document.querySelectorAll('.crew-checkbox:checked');
                const crew = Array.from(checkboxes).map(cb => ({
                    id: parseInt(cb.dataset.id),
                    name: cb.dataset.name,
                    job: cb.dataset.job,
                    profileUrl: cb.dataset.profile
                }));
                document.getElementById('inputSelectedCrewJson').value = JSON.stringify(crew);
            }

            document.addEventListener('click', (e) => {
                if (!tmdbSearch.contains(e.target) && !searchResults.contains(e.target)) {
                    searchResults.classList.add('hidden');
                }
            });
            
            document.getElementById('toggleAllCast')?.addEventListener('click', function() {
                const checkboxes = document.querySelectorAll('.cast-checkbox');
                const allChecked = Array.from(checkboxes).every(cb => cb.checked);
                this.textContent = allChecked ? 'Alle auswählen' : 'Alle abwählen';
                checkboxes.forEach(cb => cb.checked = !allChecked);
                updateSelectedCast();
            });

            document.getElementById('toggleAllCrew')?.addEventListener('click', function() {
                const checkboxes = document.querySelectorAll('.crew-checkbox');
                const allChecked = Array.from(checkboxes).every(cb => cb.checked);
                this.textContent = allChecked ? 'Alle auswählen' : 'Alle abwählen';
                checkboxes.forEach(cb => cb.checked = !allChecked);
                updateSelectedCrew();
            });
        });
    </script>
}
