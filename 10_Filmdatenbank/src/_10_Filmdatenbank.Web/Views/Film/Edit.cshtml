@model _10_Filmdatenbank.Domain.Entities.Film
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["EditPageTitle"];
}

<div class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-12">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-success-bg dark:bg-success-dark-bg border border-success-border dark:border-success-dark-border flex items-center justify-center text-success-primary dark:text-success-dark-content shadow-sm transition-transform hover:scale-105" aria-hidden="true">
                <i aria-hidden="true" class="fa-solid fa-pen-to-square text-2xl"></i>
            </div>
            <div>
                <h1 class="text-3xl font-black tracking-tight text-text-main dark:text-white leading-none transition-colors">@Model.Titel</h1>
                <p class="mt-2 text-sm font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest">@Localizer["EditSubheader"]</p>
            </div>
        </div>
        <a asp-action="Index" class="text-sm font-bold text-text-muted hover:text-brand-primary transition-all flex items-center gap-2 uppercase tracking-widest" aria-label='@Localizer["BackToCatalog"]'>
            <i aria-hidden="true" class="fa-solid fa-chevron-left"></i> @Localizer["Back"]
        </a>
    </div>

    <div class="form-group-card overflow-hidden !p-0">
        <form asp-action="Edit" class="p-10 space-y-10">
            <input type="hidden" asp-for="FilmID" />
            
            <div class="form-group-header">
                <div>
                    <h2 class="text-xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["CatalogData"]</h2>
                    <p class="text-[10px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest mt-1">@Localizer["CatalogDataSub"]</p>
                </div>
                <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-surface-muted dark:bg-dark-surface border border-border-muted dark:border-dark-border text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase">
                    ID: #@Model.FilmID
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" role="alert" class="p-4 rounded-xl bg-danger-bg dark:bg-danger-dark-bg text-danger-content dark:text-danger-dark-content text-sm font-bold border border-danger-border dark:border-danger-dark-border italic mb-8"></div>

            <div class="space-y-8">
                <div class="form-group-card">
                <div class="form-group-header">
                    <p class="text-xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["MovieInfo"]</p>
                    <p class="text-[10px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-widest mt-1">@Localizer["MovieInfoSub"]</p>
                </div>

                <div class="p-8 space-y-8">
                    <!-- Title row -->
                    <div class="form-group-row">
                        <div class="flex flex-col gap-1.5 flex-grow">
                            <label asp-for="Titel" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelTitle"]</label>
                            <input asp-for="Titel" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder='@Localizer["PlaceholderTitle"]' />
                            <span asp-validation-for="Titel" class="text-[10px] font-bold text-danger-primary mt-1 px-1"></span>
                        </div>
                    </div>

                    <div class="form-group-row">
                        <div class="flex flex-col gap-1.5 flex-grow">
                            <label asp-for="Tagline" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelTagline"]</label>
                            <input asp-for="Tagline" id="inputTagline" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder="Believe the unbelievable" />
                            <span asp-validation-for="Tagline" class="text-[10px] font-bold text-danger-primary mt-1 px-1"></span>
                        </div>
                    </div>



                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                         <div class="flex flex-col gap-1.5">
                             <label asp-for="Erscheinungsjahr" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelYear"]</label>
                            <input asp-for="Erscheinungsjahr" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Erscheinungsdatum" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelDate"]</label>
                            <input asp-for="Erscheinungsdatum" type="date" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                        </div>
                         <div class="flex flex-col gap-1.5">
                             <label asp-for="Nutzerwertung" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelRatingRange"]</label>
                            <input asp-for="Nutzerwertung" type="number" step="0.1" min="0" max="10" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                         <div class="flex flex-col gap-1.5">
                             <label asp-for="Spieldauer" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelRuntime"]</label>
                            <input asp-for="Spieldauer" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Preis" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelPrice"]</label>
                            <input asp-for="Preis" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" />
                        </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label asp-for="PosterUrl" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelPosterUrl"]</label>
                        <input asp-for="PosterUrl" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-text-main dark:text-white" placeholder='@Localizer["PlaceholderPosterUrl"]' />
                    </div>

                    <div class="flex flex-col gap-1.5">
                    <label asp-for="Handlung" class="text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest px-1">@Localizer["LabelPlot"]</label>
                    <textarea asp-for="Handlung" rows="5" class="w-full px-4 py-3 rounded-xl bg-surface-subtle dark:bg-dark-surface-soft border border-border-default dark:border-dark-border focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-medium text-text-description dark:text-dark-text-muted" placeholder='@Localizer["PlaceholderPlot"]'></textarea>
                </div>



                </div>

                <div class="form-group-footer">
                     <a asp-action="Index" class="btn-secondary px-8">@Localizer["Cancel"]</a>
                     <button type="submit" class="btn-primary px-10 shadow-xl shadow-brand-shadow">
                         <i aria-hidden="true" class="fa-solid fa-save mr-2"></i> @Localizer["SaveChanges"]
                     </button>
                </div>
            </div>
            </div>

            <div class="form-group-footer">
                 <p class="text-[10px] font-bold text-text-muted dark:text-dark-text-muted uppercase tracking-[0.2em] max-w-[200px] leading-relaxed">
                    @Localizer["SaveNotice"]
                </p>
                <div class="flex flex-col gap-3">
                    <div class="flex-wrap-gap">
                        <a asp-action="Index" class="btn-secondary">@Localizer["Cancel"]</a>
                        <button type="submit" class="btn-primary bg-success-primary hover:bg-success-content px-8 shadow-lg shadow-success-primary/20 border-success-border">
                            <i aria-hidden="true" class="fa-solid fa-check mr-2 font-light"></i> @Localizer["Update"]
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
