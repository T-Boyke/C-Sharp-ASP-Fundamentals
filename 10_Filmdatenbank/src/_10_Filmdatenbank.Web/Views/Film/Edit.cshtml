@model _10_Filmdatenbank.Domain.Entities.Film

@{
    ViewData["Title"] = "Film bearbeiten";
}

<div class="mx-auto max-w-3xl px-6 lg:px-8 py-12">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold leading-9 tracking-tight text-slate-900">Film bearbeiten</h1>
            <p class="mt-2 text-sm text-slate-600">Aktualisieren Sie die Informationen für: <span class="font-semibold italic text-slate-800">@Model.Titel</span></p>
        </div>
        <a asp-action="Index" class="text-sm font-semibold leading-6 text-indigo-600 hover:text-indigo-500 transition-colors">
            <i class="fa-solid fa-arrow-left mr-2"></i>Zurück zur Liste
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <form asp-action="Edit" class="p-8">
            <input type="hidden" asp-for="FilmID" />
            <div asp-validation-summary="ModelOnly" class="mb-6 rounded-md bg-red-50 p-4 text-sm text-red-600"></div>

            <div class="space-y-6">
                <div>
                    <label asp-for="Titel" class="block text-sm font-medium leading-6 text-slate-900">Titel</label>
                    <div class="mt-2">
                        <input asp-for="Titel" class="block w-full rounded-lg border-0 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 transition-all duration-200" />
                    </div>
                    <span asp-validation-for="Titel" class="mt-2 text-xs text-red-600 italic"></span>
                </div>

                <div class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-3">
                    <div class="sm:col-span-1">
                        <label asp-for="Erscheinungsjahr" class="block text-sm font-medium leading-6 text-slate-900">Jahr</label>
                        <div class="mt-2">
                            <input asp-for="Erscheinungsjahr" class="block w-full rounded-lg border-0 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 transition-all duration-200" />
                        </div>
                        <span asp-validation-for="Erscheinungsjahr" class="mt-2 text-xs text-red-600 italic"></span>
                    </div>

                    <div class="sm:col-span-1">
                        <label asp-for="Spieldauer" class="block text-sm font-medium leading-6 text-slate-900">Dauer (min)</label>
                        <div class="mt-2">
                            <input asp-for="Spieldauer" class="block w-full rounded-lg border-0 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 transition-all duration-200" />
                        </div>
                        <span asp-validation-for="Spieldauer" class="mt-2 text-xs text-red-600 italic"></span>
                    </div>

                    <div class="sm:col-span-1">
                        <label asp-for="Preis" class="block text-sm font-medium leading-6 text-slate-900">Preis (€)</label>
                        <div class="mt-2">
                            <input asp-for="Preis" class="block w-full rounded-lg border-0 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 transition-all duration-200" />
                        </div>
                        <span asp-validation-for="Preis" class="mt-2 text-xs text-red-600 italic"></span>
                    </div>
                </div>
            </div>

            <div class="mt-10 flex items-center justify-end gap-x-6 border-t border-slate-100 pt-8">
                <a asp-action="Index" class="text-sm font-semibold leading-6 text-slate-900 hover:text-slate-600 transition-colors">Abbrechen</a>
                <button type="submit" class="rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all duration-200">
                    <i class="fa-solid fa-save mr-2"></i>Aktualisieren
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
