@model _10_Filmdatenbank.Domain.Entities.Film

@{
    ViewData["Title"] = "Eintrag bearbeiten";
}

<div class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-12">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 shadow-sm transition-transform hover:scale-105">
                <i aria-hidden="true" class="fa-solid fa-pen-to-square text-2xl"></i>
            </div>
            <div>
                <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white leading-none transition-colors">@Model.Titel</h1>
                <p class="mt-2 text-sm font-bold text-slate-400 uppercase tracking-widest">Katalogeintrag modifizieren</p>
            </div>
        </div>
        <a asp-action="Index" class="text-sm font-bold text-slate-400 hover:text-brand-primary transition-all flex items-center gap-2 uppercase tracking-widest">
            <i aria-hidden="true" class="fa-solid fa-chevron-left"></i> Zurück
        </a>
    </div>

    <div class="form-group-card overflow-hidden !p-0">
        <form asp-action="Edit" class="p-10 space-y-10">
            <input type="hidden" asp-for="FilmID" />
            
            <div class="form-group-header">
                <div>
                    <h2 class="text-xl font-black text-slate-900 dark:text-white uppercase tracking-tight">Katalogdaten</h2>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">Metadaten aktualisieren</p>
                </div>
                <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 text-[10px] font-black text-slate-400 uppercase">
                    ID: #@Model.FilmID
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" role="alert" class="p-4 rounded-xl bg-red-50 text-red-600 text-sm font-bold border border-red-100 italic mb-8"></div>

            <div class="space-y-8">
                <div class="form-group-card">
                <div class="form-group-header">
                    <h2 class="text-xl font-black text-slate-900 dark:text-white uppercase tracking-tight">Filminformationen</h2>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">Basisdaten und Metadaten</p>
                </div>

                <div class="p-8 space-y-8">
                    <!-- Title row -->
                    <div class="form-group-row">
                        <div class="flex flex-col gap-1.5 flex-grow">
                            <label asp-for="Titel" class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Titel</label>
                            <input asp-for="Titel" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-slate-900 dark:text-white" placeholder="z.B. Inception" />
                            <span asp-validation-for="Titel" class="text-[10px] font-bold text-red-500 mt-1 px-1"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Genre" class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Kategorie / Genre</label>
                            <input asp-for="Genre" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-slate-900 dark:text-white" placeholder="Action, Sci-Fi" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="FskRating" class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Altersfreigabe (FSK)</label>
                            <select asp-for="FskRating" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-slate-900 dark:text-white">
                                <option value="FSK 0">FSK 0</option>
                                <option value="FSK 6">FSK 6</option>
                                <option value="FSK 12">FSK 12</option>
                                <option value="FSK 16">FSK 16</option>
                                <option value="FSK 18">FSK 18</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                         <div class="flex flex-col gap-1.5">
                            <label asp-for="Erscheinungsjahr" class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Jahr</label>
                            <input asp-for="Erscheinungsjahr" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-slate-900 dark:text-white" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Erscheinungsdatum" class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Datum</label>
                            <input asp-for="Erscheinungsdatum" type="date" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-slate-900 dark:text-white" />
                        </div>
                         <div class="flex flex-col gap-1.5">
                            <label asp-for="Nutzerwertung" class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Bewertung (0.0 - 10.0)</label>
                            <input asp-for="Nutzerwertung" type="number" step="0.1" min="0" max="10" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-slate-900 dark:text-white" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                         <div class="flex flex-col gap-1.5">
                            <label asp-for="Spieldauer" class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Laufzeit (Min.)</label>
                            <input asp-for="Spieldauer" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-slate-900 dark:text-white" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Preis" class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Preis (€)</label>
                            <input asp-for="Preis" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-slate-900 dark:text-white" />
                        </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label asp-for="PosterUrl" class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Poster Bild-URL</label>
                        <input asp-for="PosterUrl" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-slate-900 dark:text-white" placeholder="https://image.tmdb.org/..." />
                    </div>

                    <div class="flex flex-col gap-1.5">
                    <label asp-for="Handlung" class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Handlung / Plot</label>
                    <textarea asp-for="Handlung" rows="5" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-medium text-slate-700 dark:text-slate-300" placeholder="Worüber handelt der Film?"></textarea>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="Tags" class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Tags (kommagetrennt)</label>
                    <input asp-for="Tags" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-hidden transition-all font-bold text-slate-900 dark:text-white" placeholder="z.B. Sci-Fi, Action, Kult" />
                </div>

                </div>

                <div class="form-group-footer">
                     <a asp-action="Index" class="btn-secondary px-8">Abbrechen</a>
                     <button type="submit" class="btn-primary px-10 shadow-xl shadow-brand-primary/20">
                         <i aria-hidden="true" class="fa-solid fa-save mr-2"></i> Änderungen speichern
                     </button>
                </div>
            </div>
            </div>

            <div class="form-group-footer">
                 <p class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] max-w-[200px] leading-relaxed">
                    Änderungen werden sofort in der Datenbank persistiert.
                </p>
                <div class="flex flex-col gap-3">
                    <div class="flex-wrap-gap">
                        <a asp-action="Index" class="btn-secondary">Abbrechen</a>
                        <button type="submit" class="btn-primary bg-emerald-600 hover:bg-emerald-700 px-8 shadow-lg shadow-emerald-600/20 border-emerald-500">
                            <i aria-hidden="true" class="fa-solid fa-check mr-2 font-light"></i> Aktualisieren
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
