@model _10_Filmdatenbank.Domain.Entities.ProductionCompany
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Model.Name;
}

<div class="mx-auto max-w-7xl px-6 lg:px-8 py-16">
    <nav class="flex mb-12 items-center gap-4 text-sm font-bold text-text-muted uppercase tracking-widest">
        <a asp-action="Index" class="nav-link">
            <i class="fa-solid fa-arrow-left"></i> @Localizer["BackToStudios"]
        </a>
        <span class="h-1 w-1 rounded-full bg-border-default"></span>
    </nav>

    <div class="flex flex-col md:flex-row gap-16 mb-20">
        <div class="w-full md:w-80 shrink-0">
            <div class="card-premium p-10 bg-surface-bright dark:bg-dark-surface-bright flex items-center justify-center aspect-square border-2 border-border-default">
                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <img src="@Model.LogoUrl" alt="@Model.Name" class="max-w-full max-h-full object-contain" />
                }
                else
                {
                    <i class="fa-solid fa-industry text-8xl text-dark-surface-muted"></i>
                }
            </div>
        </div>

        <div class="flex-grow space-y-10">
            <div>
                <h1 class="text-5xl font-black text-text-main dark:text-white tracking-tighter">@Model.Name</h1>
                <div class="flex items-center gap-6 mt-6">
                    @if (!string.IsNullOrEmpty(Model.OriginCountry))
                    {
                        <div class="flex items-center gap-2 px-3 py-1 rounded bg-surface-muted dark:bg-dark-surface-muted text-[10px] font-black uppercase text-text-muted dark:text-dark-text-muted">
                            <i class="fa-solid fa-earth-americas"></i> @Model.OriginCountry
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Headquarters))
                    {
                        <div class="flex items-center gap-2 px-3 py-1 rounded bg-surface-muted dark:bg-dark-surface-muted text-[10px] font-black uppercase text-text-muted dark:text-dark-text-muted">
                            <i class="fa-solid fa-building"></i> @Model.Headquarters
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Homepage))
                    {
                        <a href="@Model.Homepage" target="_blank" class="text-xs font-black text-brand-primary hover:underline flex items-center gap-2">
                            <i class="fa-solid fa-globe"></i> @Localizer["OfficialWebsite"]
                        </a>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="prose dark:prose-invert max-w-none">
                    <p class="text-lg text-text-description dark:text-dark-text-muted leading-relaxed font-medium">@Model.Description</p>
                </div>
            }

            <div class="flex flex-wrap gap-4 pt-6">
                @if (Model.TmdbId > 0)
                {
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-surface-subtle dark:bg-dark-surface-soft border border-border-muted dark:border-dark-border text-[10px] font-black text-text-muted dark:text-dark-text-muted uppercase tracking-widest">
                        <i class="fa-solid fa-database"></i> @Localizer["TmdbId"] #@Model.TmdbId
                    </div>
                }
                @if (Model.ParentCompany != null)
                {
                    <a asp-action="Details" asp-route-id="@Model.ParentCompanyID" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-brand-primary/5 hover:bg-brand-primary/10 border border-brand-primary/20 text-[10px] font-black text-brand-primary uppercase tracking-widest transition-colors">
                        <i class="fa-solid fa-sitemap"></i> @Localizer["ParentCompany"]: @Model.ParentCompany.Name
                    </a>
                }
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="pt-6 border-t border-border-muted dark:border-dark-border">
                    <a asp-action="Edit" asp-route-id="@Model.ProductionCompanyID" class="btn-primary">@Localizer["Edit"]</a>
                </div>
            }
        </div>
    </div>

    <!-- Studio DNA Analytics -->
    <section class="mb-20">
        <div class="form-group-header !mb-8">
            <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["StudioDNA"]</h2>
            <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
        </div>

        @{
            var localFilms = Model.Films.ToList();
            var totalStudioFilms = localFilms.Count;
            var studioRevenue = localFilms.Sum(f => f.Revenue ?? 0);
            var studioBudget = localFilms.Sum(f => f.Budget ?? 0);
            var studioGenres = localFilms.SelectMany(f => f.Genres)
                                        .GroupBy(g => g.Name)
                                        .Select(g => new { Name = g.Key, Count = g.Count() })
                                        .OrderByDescending(g => g.Count)
                                        .Take(5)
                                        .ToList();
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            <!-- DNA Strands: Genre Specialization -->
            <div class="lg:col-span-2 space-y-8">
                <p class="text-[10px] font-black text-text-muted uppercase tracking-widest">@Localizer["GenreSpecialization"]</p>
                <div class="space-y-6">
                    @foreach (var sg in studioGenres)
                    {
                        var percentage = totalStudioFilms > 0 ? (double)sg.Count / totalStudioFilms * 100 : 0;
                        <div>
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-xs font-black text-text-main dark:text-white uppercase">@sg.Name</span>
                                <span class="text-[10px] font-bold text-brand-primary">@sg.Count @Localizer["Films"] (@percentage.ToString("0")%)</span>
                            </div>
                            <div class="w-full h-2 bg-surface-muted dark:bg-dark-surface-soft rounded-full overflow-hidden">
                                <div class="h-full bg-linear-to-r from-brand-primary to-brand-primary/60 shadow-[0_0_15px_rgba(var(--brand-primary-rgb),0.4)]" style="width: @percentage%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Studio Impact: Financials -->
            <div class="glass-premium p-8 rounded-3xl border border-glass-border flex flex-col justify-between">
                <p class="text-[10px] font-black text-brand-primary uppercase tracking-widest mb-8">@Localizer["FinancialImpact"]</p>
                
                <div class="space-y-8">
                    <div>
                        <p class="text-[10px] font-bold text-text-muted uppercase mb-1">@Localizer["TotalCumulativeRevenue"]</p>
                        <p class="text-3xl font-black text-text-main dark:text-white">$@studioRevenue.ToString("N0")</p>
                    </div>
                    
                    <div class="h-px bg-glass-border"></div>
                    
                    <div>
                        <p class="text-[10px] font-bold text-text-muted uppercase mb-1">@Localizer["AvgProductionBudget"]</p>
                        @{
                            var avgBudgetPC = totalStudioFilms > 0 ? studioBudget / totalStudioFilms : 0;
                        }
                        <p class="text-2xl font-black text-text-main dark:text-white">$@avgBudgetPC.ToString("N0")</p>
                    </div>

                    <div class="h-px bg-glass-border"></div>

                    <div>
                        <p class="text-[10px] font-bold text-text-muted uppercase mb-1">@Localizer["PortfolioSize"]</p>
                        <p class="text-2xl font-black text-text-main dark:text-white">@totalStudioFilms @Localizer["TrackedFilms"]</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Accolades & Recognition -->
    @if (Model.ProductionCompanyAwards?.Any() == true)
    {
        <section class="mb-20">
            <div class="form-group-header !mb-8">
                <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["AccoladesAndRecognition"]</h2>
                <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var award in Model.ProductionCompanyAwards.OrderByDescending(a => a.Year))
                {
                    <div class="glass-premium p-6 rounded-2xl border border-glass-border flex flex-col group">
                        <div class="flex items-center justify-between mb-4">
                            <span class="text-[10px] font-black text-brand-primary uppercase">@award.Year</span>
                            @if (award.IsWin)
                            {
                                <i class="fa-solid fa-trophy text-amber-500 shadow-[0_0_10px_rgba(245,158,11,0.3)]"></i>
                            }
                        </div>
                        <p class="text-md font-black text-text-main dark:text-white mb-1">@award.Name</p>
                        <p class="text-[10px] font-bold text-text-muted uppercase">@award.Category</p>
                    </div>
                }
            </div>
        </section>
    }

    <div class="form-group-header !mb-12">
        <h2 class="text-2xl font-black text-text-main dark:text-white uppercase tracking-tight">@Localizer["ProducedFilmsHeader"]</h2>
        <div class="h-1 w-12 bg-brand-primary rounded-full mt-2"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        @foreach (var film in Model.Films.OrderByDescending(f => f.Erscheinungsjahr))
        {
            <a asp-controller="Film" asp-action="Details" asp-route-id="@film.FilmID" class="card-premium group flex flex-col">
                <div class="aspect-[2/3] relative overflow-hidden bg-surface-subtle dark:bg-dark-surface-soft">
                    @if (!string.IsNullOrEmpty(film.PosterUrl))
                    {
                        <img src="@film.PosterUrl" alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                    }
                </div>
                <div class="p-6">
                    <p class="text-[10px] font-black text-brand-primary uppercase tracking-widest">@film.Erscheinungsjahr</p>
                    <h3 class="text-md font-black text-text-main dark:text-white mt-1 group-hover:text-brand-primary transition-colors">@film.Titel</h3>
                </div>
            </a>
        }
    </div>
</div>
