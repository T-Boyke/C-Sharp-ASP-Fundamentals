@model _10_Filmdatenbank.Web.Controllers.LoginViewModel

@{
    ViewData["Title"] = "Anmelden";
}

<div class="flex min-h-[60vh] items-center justify-center px-4 py-20">
    <div class="w-full max-w-md">
        <div class="text-center mb-10">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brand-soft shadow-sm border border-brand-border mb-6">
                <i aria-hidden="true" class="fa-solid fa-lock text-brand-primary text-3xl"></i>
            </div>
            <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white transition-colors">Willkommen zurück</h2>
            <p class="mt-2 text-slate-500 dark:text-slate-400 font-medium transition-colors">Melden Sie sich an, um Ihre Datenbank zu verwalten.</p>
        </div>

        <div class="bg-white dark:bg-slate-900 p-8 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xl transition-colors">
            <form class="space-y-6" asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" role="alert" class="p-4 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 text-sm font-bold border border-red-100 dark:border-red-900/30 italic flex flex-col items-center gap-4">
                    @if (ViewBag.LoginFailed == true)
                    {
                        <img src="~/wrongPW.gif" alt="Falsches Passwort" class="w-32 h-32 rounded-lg shadow-md border-2 border-red-200 dark:border-red-800" />
                    }
                </div>
                
                <div>
                    <label asp-for="Email" class="form-label">
                        <i aria-hidden="true" class="fa-solid fa-envelope mr-1 text-slate-400 dark:text-slate-500"></i> Email Adresse
                    </label>
                    <input asp-for="Email" type="email" autocomplete="email" required class="form-input" placeholder="ihre@email.de">
                    <span asp-validation-for="Email" class="form-error"></span>
                </div>

                <div>
                    <label asp-for="Password" class="form-label">
                        <i aria-hidden="true" class="fa-solid fa-key mr-1 text-slate-400 dark:text-slate-500"></i> Passwort
                    </label>
                    <input asp-for="Password" type="password" autocomplete="current-password" required class="form-input" placeholder="••••••••">
                    <span asp-validation-for="Password" class="form-error"></span>
                </div>

                <div class="flex items-center gap-3">
                    <button type="submit" class="btn-primary flex-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary">
                        <i aria-hidden="true" class="fa-solid fa-right-to-bracket mr-2"></i> Anmelden
                    </button>
                </div>
                
                <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 text-center">
                    Durch die Anmeldung akzeptieren Sie unsere <a asp-controller="Home" asp-action="Privacy" class="underline hover:text-brand-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary rounded">Datenschutzbestimmungen</a>. Login-Aktivitäten werden sicher protokolliert.
                </p>
            </form>

            <div class="mt-10 pt-8 border-t border-slate-100 dark:border-slate-800 transition-colors">
                <div class="flex items-center gap-3 p-4 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-colors">
                    <i aria-hidden="true" class="fa-solid fa-circle-info text-brand-primary text-xl"></i>
                    <div class="text-xs text-slate-600 dark:text-slate-400 font-medium">
                        <p>Test-Zugang (Admin):</p>
                        <p class="font-bold text-slate-900 dark:text-white mt-0.5">admin@film.de | Admin123!</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
