<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\_10_Filmdatenbank.Domain\_10_Filmdatenbank.Domain.csproj" />
    <ProjectReference Include="..\_10_Filmdatenbank.Application\_10_Filmdatenbank.Application.csproj" />
    <ProjectReference Include="..\_10_Filmdatenbank.Infrastructure\_10_Filmdatenbank.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="tailwindcss" Version="4.0.0-beta.5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TailwindCSSInputFile>wwwroot/css/input.css</TailwindCSSInputFile>
    <TailwindCSSOutputFile>wwwroot/css/site.css</TailwindCSSOutputFile>
    <DisableStaticWebAssetsCompression>true</DisableStaticWebAssetsCompression>
  </PropertyGroup>

</Project>
