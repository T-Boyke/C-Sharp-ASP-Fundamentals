@model LoginDto

@{
    ViewData["Title"] = "Anmeldung";
}

<div class="grow flex items-center justify-center p-6">
    <div class="w-full max-w-md">
        <div class="glass p-10 rounded-3xl shadow-2xl border border-white">
            <div class="text-center mb-10">
                <div class="inline-flex items-center justify-center w-20 h-20 bg-indigo-100 text-indigo-600 rounded-2xl mb-4 shadow-inner">
                    <i class="fa fa-shield-alt text-4xl"></i>
                </div>
                <h1 class="text-3xl font-black text-slate-800 tracking-tight">Login Excellence</h1>
                <p class="text-slate-500 font-medium">Melden Sie sich an, um fortzufahren.</p>
            </div>

            <form asp-action="Login" method="post" class="space-y-6">
                <input type="hidden" asp-for="ReturnUrl" />
                
                <div asp-validation-summary="ModelOnly" class="bg-rose-50 border-l-4 border-rose-500 p-4 text-rose-700 text-sm font-medium rounded-r-lg"></div>

                <div class="space-y-2">
                    <label asp-for="Username" class="text-sm font-bold text-slate-700 ml-1">Benutzername</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400">
                            <i class="fa fa-user"></i>
                        </span>
                        <input asp-for="Username" class="w-full pl-11 pr-4 py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-hidden font-medium" placeholder="z.B. Admin" />
                    </div>
                </div>

                <div class="space-y-2">
                    <label asp-for="Password" class="text-sm font-bold text-slate-700 ml-1">Passwort</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400">
                            <i class="fa fa-lock"></i>
                        </span>
                        <input asp-for="Password" type="password" class="w-full pl-11 pr-4 py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-hidden font-medium" placeholder="••••••••" />
                    </div>
                </div>

                <button type="submit" class="w-full py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-black rounded-xl transition-all shadow-lg shadow-indigo-200 transform hover:-translate-y-1 active:scale-95">
                    ANMELDEN
                </button>
            </form>

            <div class="mt-8 pt-8 border-t border-slate-100">
                <div class="bg-amber-50 rounded-xl p-4 flex gap-4">
                    <i class="fa fa-info-circle text-amber-500 mt-1"></i>
                    <div>
                        <p class="text-xs font-bold text-amber-800 uppercase tracking-wider">Demozugang</p>
                        <p class="text-xs text-amber-700 font-medium">User: <span class="font-bold">Admin</span> | Pass: <span class="font-bold">Pass123!</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
