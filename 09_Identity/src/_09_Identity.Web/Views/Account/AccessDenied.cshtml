@{
    ViewData["Title"] = "Zugriff verweigert";
}

<div class="grow flex items-center justify-center p-6 text-center">
    <div class="max-w-md space-y-8">
        <div class="inline-flex items-center justify-center w-24 h-24 bg-rose-100 text-rose-600 rounded-full animate-bounce">
            <i class="fa fa-ban text-5xl"></i>
        </div>
        
        <div class="space-y-4">
            <h1 class="text-4xl font-black text-slate-800 tracking-tight">Zugriff verweigert</h1>
            <p class="text-slate-500 text-lg font-medium">
                Entschuldigung, aber Sie haben nicht die erforderlichen Berechtigungen, um auf diese Seite zuzugreifen.
            </p>
        </div>

        <div class="pt-8">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-3 font-bold text-indigo-600 hover:text-indigo-700 transition-colors">
                <i class="fa fa-arrow-left"></i> Zurück zum Dashboard
            </a>
        </div>
    </div>
</div>
