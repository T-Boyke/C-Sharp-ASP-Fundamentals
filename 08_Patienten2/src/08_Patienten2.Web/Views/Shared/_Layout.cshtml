<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Praxis Excellence</title>
    
    <!-- Tailwind CSS Output (Built via CLI) -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    
    <!-- Font-Awesome 7.2 (Local) -->
    <link rel="stylesheet" href="~/css/font-awesome.css" asp-append-version="true" />
    
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col">
    <header class="glass sticky top-0 z-50 border-b border-slate-200">
        <nav class="container mx-auto px-4 h-16 flex items-center justify-between">
            <a class="text-xl font-black bg-clip-text text-transparent bg-linear-to-r from-blue-600 to-cyan-500" asp-controller="Patient" asp-action="Index">
                PRAXIS <span class="font-light">EXCELLENCE</span>
            </a>
            
            <div class="flex items-center gap-6">
                <ul class="flex items-center gap-4 text-sm font-medium text-slate-600">
                    <li>
                        <a class="hover:text-blue-600 transition-colors" asp-controller="Patient" asp-action="Index">Patienten</a>
                    </li>
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <main role="main" class="grow">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-slate-200 py-8 text-center text-slate-400 text-sm">
        <div class="container mx-auto px-4">
            &copy; 2026 - Praxis Excellence Infrastructure - <span class="text-blue-500 font-semibold italic">Excellence by Design</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
